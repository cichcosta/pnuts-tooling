        wtoticms += round(wddol.mvalim, 2)
        wtotvbc += wvbc
        if (wuser == "alopes") { showMessage("10 wtotvbc " + wtotvbc) }

        //*****************************************************************************************************************************************************************************
      } else if (wddol.cfpsr.trim() == "020") {
        println("4 >>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>"); flush();
        if (wrow.ient.trim() == "F00" && wrow.iuorg.trim() == "F03") {
