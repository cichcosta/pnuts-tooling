        wlinha += "</ICMS60>"

        //************************************************************************************************************************************************************
      } else if ((wddol.cfpsrl.trim() == "060" || wddol.cfpsrl.trim() == "020") && inList(wrow.idoct.trim(), ["NNF"]) && inList(wrow.cit.trim(), ["6102", "6108"])) {

        wlinha += "<ICMS00>"
        //if (wuser == "tom"){showMessage("ICMS00 >>>> 1")}
