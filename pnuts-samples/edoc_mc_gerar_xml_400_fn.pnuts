// Dados do ICMS destacado (interestadual)
wvICMSUFDest = 0.00
wvICMSUFRemet = 0.00

// Variaveis para dados transportadora
wflagwtra = false
wendtra = ""
wuftra = ""
wcnpjtra = ""
wietra = ""
wmuntra = ""

// temporario
zglobals.WESPELHO = ""

zglobals.WCSTPROD = "|"

// REGION
// Objetivo: Obter o identificador de local de destino da Operação.
// Pega o primeiro digito para saber o destino da Operação
wcit = wrow.cit.trim().substring(0, 1)

// Identificador de local de destino da Operação
// 1=Operação interna;
// 2=Operação interestadual;
// 3=Operação com exterior.
widDest = "1"

// Se wcit for 2 ou 6, Ã© porque nas linhas contem CFOP de Operação interestadual
if (inList(wcit, ["2", "6"])) {
  widDest = "2"
  // Se wcit for 3 ou 7, Ã© porque nas linhas contem CFOP de Operação com exterior
} else if (inList(wcit, ["3", "7"])) {
  wexterior = true
}
// ENDREGION

// Obtem os dados do emitente da nota
wbent = edoc_mc_get_bent_fn("*", wrow.iorg.trim(), wrow.iuorgt.trim(), wrow.iuorg.trim())


// Obtem os dados do municipio do emitente
wbgeo = edoc_mc_get_bgeo_fn(wbent)

// Dados do emitente da nota
// Para atender o novo CNPJ Alfanumerico, trocamos a regex antiga "[^0-9]" pela nova "[^A-Z0-9]".
wCNPJ_C02 = wbent.tidfisc.trim().replaceAll("[^A-Z0-9]", "")
wxNome_C03 = wbent.nnomel.trim().replaceAll("&", "E")
xFant_C04 = wbent.nent.trim().replaceAll("&", "E")
wxLgr_C06 = wbent.tmorad.trim()
wnro_C07 = wbent.tmail.trim()
wxCpl_C08 = ""
wxBairro_C09 = wbent.tlocal.trim()
wcMun_C10 = wbgeo.wcidade.trim()
wxMun_C11 = wbent.tmunicip.trim()
wUF_C12 = wbent.testado.trim()
wCEP_C13 = formatNumber(wbent.icpt.replaceAll("[^0-9]", ""), "N00000000")
wcPais_C14 = wbgeo.wpais.trim()
wxPais_C15 = wbent.tpais.trim()
wfone_C16 = ""
wIE_C17 = wbent.tidfisc2.trim().replaceAll("[^0-9]", "")

if (inList(wUF_C12, ["CE"])) {
  wtemICMSEfetivo = false
}

// REGION
// Armazena os dados do destinatario da nota na variavel wbent2
wbent2 = edoc_mc_get_destinatario_fn(wrow)

// Obtem os dados do municipio do destinatario
wbgeo2 = edoc_mc_get_bgeo_fn(wbent2)

// Indicador da IE do Destinatário
// 1=Contribuinte ICMS (informar a IE do destinatário);
// 2=Contribuinte isento de Inscrição no cadastro de Contribuintes do ICMS;
// 9=Não Contribuinte, que pode ou Não possuir Inscrição Estadual no Cadastro de Contribuintes do ICMS.
windIEDest_E16a = "1"

// Verifica se no cadastro do destinatario o campo de IE está preenchido
// como ISENTO, se estiver então atribui 0
if (inList(wbent2.tidfisc2.trim().toUpperCase(), ["ISENTO", ""]))
  windIEDest_E16a = "9";

// Variaveis do destiantario da nota
// Para atender o novo CNPJ Alfanumerico, trocamos a regex antiga "[^0-9]" pela nova "[^A-Z0-9]".
wCNPJ_E02 = wbent2.tidfisc.replaceAll("[^A-Z0-9]", "")
wCPF_E03 = wbent2.tidfisc.replaceAll("[^A-Z0-9]", "")
widEstrangeiro_E03a = ""
wxNome_E40 = wbent2.nnomel.trim().replaceAll("&", "E")
wxLgr_E06 = wbent2.tmorad.trim()
wnro_E07 = wbent2.tmail.trim()
wxCpl_E08 = wbent2.tcend.trim()
wxBairro_E09 = wbent2.tlocal.trim()
wcMun_E10 = wbgeo2.wcidade.trim()
wxMun_E11 = wbent2.tmunicip.trim()
wUF_E12 = wbent2.testado.trim().toUpperCase()
wCEP_E13 = formatNumber(wbent2.icpt.replaceAll("[^0-9]", ""), "N00000000")
wcPais_E14 = wbgeo2.wpais.trim()
wxPais_E15 = wbent2.tpais.trim()
wfone_E16 = wbent2.ttel.replaceAll("[^0-9]", "")
if (wfone_E16 == "") { wfone_E16 = wbent2.ttelex.replaceAll("[^0-9]", "") } // Pegar campo do celular caso o telefone esteja vazio solicitado pelo Pena - Anderson Lopes  - 2020-05-09
wIE_E17 = wbent2.tidfisc2.replaceAll("[^0-9]", "")
wemail_E19 = wbent2.temail.trim()

//NPP.002582 - DIFAL NO SPED E VISUALIZAÇÃO DO VALOR
//Gravar UF de destinatário
x_mc_update_extension_fn("c", "ddoctx", wrow.zk, "ufdest", wUF_E12)

// TODO: resolver essa gabis
if (wIE_E17 == "" || wCNPJ_E02.length() < 14) {
  windIEDest_E16a = "9"
}

// TODO: resolver essa gabis
if (wbent2.tidfisc2.trim() == "" && wCNPJ_E02.length() >= 14) {
  windIEDest_E16a = "2"
}

//**********************************
//Inserir Inscrção Estadual de Substituto de acordo com o estado.
if ((inList(wrow.cit.trim(), ["6102", "6108"]) && windIEDest_E16a == "9") || (inList(wrow.cit.trim(), ["6152"]) && wUF_E12.toUpperCase() == "PA")) {
  wsel = " select nctx "
  wsel += " from bctxt0 with(nolock) "
  wsel += " where ictx = 'IEST*UF' "
  wsel += " and  ivalk = '" + wrow.iuorg.trim() + "' "
  wsel += " and   xord = '" + wUF_E12 + "' "
  wsel += " and   cst  = 'E0' "
  println(wsel); flush()
  wIEST = getSQLValue(wsel).replaceAll("[^0-9]", "")
}
//**********************************

if (!wemail_E19.matches("^[_A-Za-z0-9-+]+(.[_A-Za-z0-9-]+)@[A-Za-z0-9-]+(.[A-Za-z0-9]+)(.[A-Za-z]{2,})$")) {
  wemail_E19 = ""
}

//Condição especial para clientes pessoa fisica com Inscrição Estadual - Produtor Rural
if (wbent2.cnatt.trim() == "PR" && inList(wrow.idoct2.trim(), ["NPV", "NPA"])) {
  windIEDest_E16a = "1"
}

// Verifica se o número da residencia do destinatario esta preenchida,
// se nao estiver aborta a Operação e avisa ao usuario
if (wnro_E07 == "") {
  throwError("Operação Cancelada. Cadastre o número do logradouro do destinatário.")
}

// Se o destinatario da nota for do exterior, atribui a aplica algumas regras as variaveis do destinatario
if (wexterior) {

  // O valor do cep passa a ser vazio
  wCEP_E13 = ""

  // Limpa a variavel do CNPJ do destinatario
  wCNPJ_E02 = ""

  // Limpa a variavel do CPF do destinatario
  wCPF_E03 = ""

} else {

  // Veririca se o CEP do destinatario está vazio
  if (wCEP_E13 == "") {
    wmsg = "Operação Cancelada. Terceiro " + wrow.ientt.trim() + " - " + wrow.ient.trim() + ", com CEP inválido."
    throwError(wmsg)
  }

  // Se a Inscrição Estadual estiver vazia e o CNPJ/CPF > 11, 
  // exige o preenchimento da Inscrição Estadual do destinatario
  if (wIE_E17 == "" && wCNPJ_E02.length() > 11) {
    wmsg = "Operação Cancelada. Inscrição Estadual inválida para terceiro: "
    wmsg += wrow.ientt.trim() + " - " + wrow.ient.trim() + "."
    //throwError(wmsg)
  }

}

// Atribui flag para destacar o ICMS
if ((wrow.cit.trim().substring(0, 1) == "6") && (wCNPJ_E02.length() == 14) && (wbent2.tidfisc2.trim() != "ISENTO")) {
  wflagicms = true
}

// REGION
// Objetivo: Obter o tipo de emissão da nota fiscal e validar se o tipo informado Ã© valido
// Tipo de Emissão da NF-e
// 1=Normal
// 6=ContingÃªncia SVC-AN (SEFAZ Virtual de ContingÃªncia do AN);
// 7=ContingÃªncia SVC-RS (SEFAZ Virtual de ContingÃªncia do RS);
wtpEmis = getTparms("BCTX*PARAM*NFE", "TPEMIS*" + wrow.iorg.trim() + "*" + wrow.iuorg.trim())
if (!inList(wtpEmis.trim(), ["1", "6", "7"])) {
  throwError("Tipo de Emissão inválido. Tipo válidos: 1 (produção), 2 (Homologação)")
}
// ENDREGION


// REGION
// Objetivo: Obter a identificação do ambiente de emissao das notas fiscais
//           e validar se a identificação informada Ã© valida
// Identificação do Ambiente
// 1=Produção; 
// 2=Homologação
wtpAmb = getTparms("BCTX*PARAM*NFE", "AMBIENTE*" + wrow.iorg.trim() + "*" + wrow.iuorg.trim())
if (!inList(wtpAmb, ["1", "2"])) {
  throwError("Tipo de Emissão inválido. Tipo válidos: 1 (produção), 2 (Homologação)")
}

if (wuser == "scavalca") {
  //wtpAmb = "2"
}

// ENDREGION

// REGION
// Objetivo: Obter a forma de pagamento.

// Indicador da forma de pagamento
// 0=Pagamento Ã  vista
// 1=Pagamento a prazo
// 2=Outros
windPag = "0"
if (wrow.cdocp.trim() != "00") { windPag = "1" }
// ENDREGION

// REGION
// Objetivo: Obter o tipo Tipo de Operação.
// 0=Entrada;
// 1=SaÃ­da
wtpNF = "1"

if (wrow.cit.substring(0, 1) == "1" || wrow.cit.substring(0, 1) == "2" || inList(wrow.cit.trim().substring(0, 1), ["3"])) {
  wtpNF = "0"
}
//ENDREGION

// Obter a descrição da Natureza da Operação
wnatOp = edoc_mc_get_natop_fn(wrow)
if (inList(wrow.idoc.trim(), ["F07/00109017"])) { wnatOp = "VENDA DE MERCADORIAS PARA USO E CONSUMO" }
//if (inList(wrow.idoc.trim(), ["B00/00030940"])) { wnatOp = "Estorno de NF-e de Importacao" }

// CÃ³digo da UF do emitente do Documento Fiscal
wcUF = wbgeo.westado.trim()

// CÃ³digo NumÃ©rico que compÃµe a Chave de Acesso
wcodigoNumerico = INT(wrow.idoc.trim().substring(4, wrow.idoc.trim().length())) + 1

/*
    wrandom = Random()
    wcodigoNumerico = INT(wrandom.nextInt(10) + "" + wrandom.nextInt(10) + "" + wrandom.nextInt(10) + "" + wrandom.nextInt(10) + "" + wrandom.nextInt(10) + "" + wrandom.nextInt(10) + "" + wrandom.nextInt(10) + "" + wrandom.nextInt(10))
    println("cNF >>> " + wcodigoNumerico);flush()
*/

wcNF = formatNumber(wcodigoNumerico, "N00000000")

// CÃ³digo do Modelo do Documento Fiscal
wmod = "55"

// número do Documento Fiscal
wnNF = INT(wrow.idoc.trim().substring(4, wrow.idoc.trim().length())).toString()

// CÃ³digo do municÃ­pio de ocorrÃªncia do fato gerador do ISSQN
wcMunFG = wbgeo.wcidade.trim()

// Formato do DANFE
// 1=DANFE normal, Retrato;
wtpImp = "1"

// Processo de emissão da NF-e
// 0=Emissão de NF-e com aplicativo do contribuinte;
// 1=Emissão de NF-e avulsa pelo Fisco;
// 2=Emissão de NF-e avulsa, pelo contribuinte com seu certificado digital, atravÃ©s do site do Fisco;
// 3=Emissão NF-e pelo contribuinte com aplicativo fornecido pelo Fisco.
wprocEmi = "0"

// Versão do Processo de emissão da NF-e
wverProc = "4.00"

// Data e hora de emissão do Documento Fiscal
wdhEmi = wrow.ddoc.trim() + "T" + wtime + "-03:00"

// Data e hora de SaÃ­da ou da Entrada da Mercadoria/Produto
wdhSaiEnt = wrow.ddoces.trim() + "T" + wtime + "-03:00"

// Indica Operação com Consumidor final
// 0=Normal;
// 1=Consumidor final;
if ((wCNPJ_E02.length() == 14) && !inList(wbent2.tidfisc2.trim().toUpperCase(), ["ISENTO", ""])) {
  windFinal = "0"
} else {
  windFinal = "1"
}

// flag para determinar se destaca os dados do ICMS de Operação 
// interestadual para pessoa fisica
wInterNaoContribuinte = false;
if (windFinal == "1" && wbent.testado.trim() != wbent2.testado.trim() && !wexterior) {
  widDest = "2" // Operação interestadual   
  if (wCNPJ_E02.length() < 14) {
    wInterNaoContribuinte = true;
  }
}

// Se o destinatario for do exterior informa 9 no
// indicador do IE do destinatário
if (wexterior) {
  windIEDest_E16a = "9";
  widDest = "3"
}

// Indicador de presença do comprador no estabelecimento comercial no momento da Operação
// 0=Não se aplica (por exemplo, Nota Fiscal complementar ou de ajuste);
// 1=Operação presencial;
// 2=Operação Não presencial, pela Internet;
// 3=Operação Não presencial, Teleatendimento;
// 4=NFC-e em Operação com entrega a domicÃ­lio;
// 9=Operação Não presencial, outros.
windPres = "9"

if (wrow.idoct2.trim() == "NPV") {

  wsel = "Select a.ctcf "
  wsel += "  From ddoct0 a "
  wsel += " Where a.iorg  = '" + wrow.iorg.trim() + "' "
  wsel += "   and a.idoct = '" + wrow.idoct2.trim() + "' "
  wsel += "   and a.idoc2  = '" + wrow.idoc2.trim() + "' "
  wctcf = getSQLValue(wsel).trim()

  if (inList(wctcf.trim(), ["VX-WEB", "VX-CHA"])) {
    windPres = "2"
  } else if (inList(wctcf.trim(), ["DEMO", "DOACAO", "PERDA"])) {
    windPres = "0"
  } else if (wctcf.trim() == "VX-CON") {
    windPres = "1"
  }
}

// REGION
// Objetivo: Obter a finalidade da NF-e.
// Finalidade de emissão da NF-e
// 1=NF-e normal;
// 2=NF-e complementar;
// 3=NF-e de ajuste;
// 4=Devolução de mercadoria.
wfinNFe = edoc_mc_get_finnfe_fn(wrow)
if (inList(wrow.idoc.trim(), ["F60/00005718"])) { wfinNFe = "3" }
println("0 wfinNFe>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>" + wfinNFe); flush();
// ENDREGION

// REGION
// Objetivo: Calcular a chave da NF-e, obter o digito verificador
//           e salvar a chave nas extensoes
wAnoMes = wrow.ddoc.trim().substring(2, 4) + wrow.ddoc.trim().substring(5, 7)

// Faz o calculo da chave de acesso da nota fiscal
wId = wNFe.calculaChaveNFe200(wcUF, wAnoMes, wCNPJ_C02, wmod, wserie, wnNF, wtpEmis, wcodigoNumerico.toString())

// obtem o digito verificador da chave de acesso da nota fiscal
wcDV = wId.substring(wId.length() - 1, wId.length())

wintegrador = getTparms("BCTX*PARAM*NFE", "INTEGRADOR*" + wrow.iorg.trim() + "*" + wrow.iuorg.trim()).trim()
if (wintegrador.toUpperCase() != "DFEAPI") {

  oManager = edoc_mc_get_http_service_fn(wrow, "nfe")
  wnum = INT(wrow.idoc.split("/")[1].trim())

  //salva a chave da nota nas extensoes
  wIdExt = x_mc_select_extension_fn("c", "DDOCTX", wzk, "widnfe").trim()

  if (wIdExt.trim() == "") {

    x_mc_update_extension_fn("c", "DDOCTX", wzk, "widnfe", wId)

  } else {

    wQueryString = "?Campos=chave,dtcadastro&"
    wQueryString += "Filtro=numero='" + wnum + "'+and+chave='" + wIdExt + "'"
    //wQueryString += "+and+dtcadastro='" + MDate(wrow.ddoc.trim()).setFormat("dd/MM/yyyy").toString() + "'"
    wQueryString += "&Ordem=Handle%20asc"
    wPost = oManager.doRequestGet("consulta" + wQueryString).trim()

    println("0 wQueryString>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>" + wQueryString); flush();
    println("0 wQueryString>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>" + wPost); flush();

    if (!wPost.contains("Nenhum")) {

      dtcadastro = wPost.split(",")[1]
      dtcadastro = padRight(dtcadastro, 10).substring(0, 10).trim()
      println("0 wQueryString>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>" + dtcadastro); flush();

      dtnota = MDate(wrow.ddoc.trim()).setFormat("dd/MM/yyyy").toString()

      if (dtcadastro == dtnota) {
        wId = wIdExt
      }
    }

  }

  //Ajuste temporario.
  //monta a querystring da consulta
  wQueryString = "?Campos=chave&"
  wQueryString += "Filtro=numero='" + wnum + "'"
  wQueryString += "+and+dtcadastro='" + MDate(wrow.ddoc.trim()).setFormat("dd/MM/yyyy").toString() + "'"
  wQueryString += "&Ordem=Handle%20asc"

  println("0 wQueryString>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>" + wQueryString); flush();

  //aqui comunicar com manager edoc
  wPost = oManager.doRequestGet("consulta" + wQueryString).trim()

  if (!wPost.contains("Nenhum") && wPost.length() == 44 && wPost != wId) {
    wId = wPost
  }

}

// REGION
// Indicador de intermediario na venda
windIntermed = ""

// Dados do intermediador(marketplace) da venda
wCNPJ_YB02 = ""
widCadIntTran_YB03 = ""

if (wtpNF == "1" && wfinNFe == "1" && inList(windPres, ["2", "3", "4", "9"])) {
  windIntermed = "0"

  wsel = "select bent.tidfisc as cnpj_yb02, "
  wsel += "       bctx.ttext2 as idcadinttran_yb03 "
  wsel += "  from bctxt0 bctx "
  wsel += " inner join bentt0 bent on bent.ientt = 'EM' and bent.ient = bctx.ivalk "
  wsel += " where bctx.ictx = 'BCTX*MKT*CANAL' "
  wsel += "   and bctx.ivalk = '" + wrow.ient2 + "'"
  winfintermedRow = getRow("BENT", wsel)
  if (winfintermedRow.wdcode != 100) {
    windIntermed = "1"

    wCNPJ_YB02 = winfintermedRow.cnpj_yb02.replaceAll("[^0-9]", "")
    widCadIntTran_YB03 = winfintermedRow.idcadinttran_yb03
  }
}
// ENDREGION


// ENDREGION
// verifica se a nota contem item de serviço
wsel = "Select top 1 a.zk "
wsel += "  From ddolt0 a, bpsrt0 b  "
wsel += " Where a.iorg  = '" + wrow.iorg.trim() + "' "
wsel += "   and a.idoct = '" + wrow.idoct.trim() + "' "
wsel += "   and a.idoc  = '" + wrow.idoc.trim() + "' "
wsel += "   and a.ientt = '" + wrow.ientt.trim() + "' "
wsel += "   and a.ient  = '" + wrow.ient.trim() + "' "
wsel += "   and b.ipst  = 'SRV' "
wsel += "   and a.iorg  = b.iorg "
wsel += "   and a.ipsr  = b.ipsr "
temServico = getRow("DDOL", wsel).wdcode != 100

cursor.commitWork()
cursor.beginWork()

// Numero fiscal gerado pelo VB e gravado nas extensão da nota
wlinha += "formato=xml " + EOL
wlinha += "<infNFe Id=" + char(34) + "NFe" + wId + char(34) + " versao=" + char(34) + wversao + char(34) + ">"
wlinha += "<ide>"
wlinha += "<cUF>" + wcUF + "</cUF>"
wlinha += "<cNF>" + wcNF + "</cNF>"
wlinha += "<natOp>" + wnatOp + "</natOp>"
wlinha += "<mod>" + wmod + "</mod>"
wlinha += "<serie>" + wserie + "</serie>"
wlinha += "<nNF>" + wnNF + "</nNF>"
wlinha += "<dhEmi>" + wdhEmi + "</dhEmi>"
wlinha += "<dhSaiEnt>" + wdhSaiEnt + "</dhSaiEnt>"
wlinha += "<tpNF>" + wtpNF + "</tpNF>"
wlinha += "<idDest>" + widDest + "</idDest>"
wlinha += "<cMunFG>" + wcMunFG + "</cMunFG>"
wlinha += "<tpImp>" + wtpImp + "</tpImp>"
wlinha += "<tpEmis>" + wtpEmis + "</tpEmis>"
wlinha += "<cDV>" + wcDV + "</cDV>"
wlinha += "<tpAmb>" + wtpAmb + "</tpAmb>"
wlinha += "<finNFe>" + wfinNFe + "</finNFe>"
wlinha += "<indFinal>" + windFinal + "</indFinal>"
wlinha += "<indPres>" + windPres + "</indPres>"
if (windIntermed != "") {
  wlinha += "<indIntermed>" + windIntermed + "</indIntermed>"
}
wlinha += "<procEmi>" + wprocEmi + "</procEmi>"
wlinha += "<verProc>" + wverProc + "</verProc>"

// Se o tipo de emissão for diferente de 1 (Normal),
// então informa os dados referente a contingencia
if (wtpEmis != "1") {
  wxjust = getTparms("BCTX*PARAM*NFE", "NFE*CONT*SCAN*JUST").trim()
  wdhCont = getTparms("BCTX*PARAM*NFE", "NFE*CONT*SCAN*DATA*HORA").trim()
  wlinha += "<dhCont>" + wdhCont + "</dhCont>"
  wlinha += "<xJust>" + wxjust + "</xJust>"
}

// Se a finalidade da nota for diferente de 1 (Normal)
// entao informa os dados de referencia que pode ser a chave
// de uma nota de devolução ou dados de uma cupom fiscal.
if (wfinNFe != "1" || inList(wrow.cit.trim(), ["5929", "6929"])) {

  wrefNFe = x_mc_select_extension_fn("c", "DDOCTX", wzk, "wrefnfe").trim()
  wnECF = x_mc_select_extension_fn("c", "DDOCTX", wzk, "wnecf").trim()
  wnCOO = x_mc_select_extension_fn("c", "DDOCTX", wzk, "wncoo").trim()

  wlinha += "<NFref>"

  // Se existe chave de nota de referencia, entao informa a chave da nota,
  // seNão, informa os dados do cupom fiscal
  if (wrefNFe != "") {
    wlinha += "<refNFe>" + wrefNFe + "</refNFe>"
  } else {
    if (wnECF == "" || wnCOO == "") {
      wmsg = "A finalidade do documento requer a chave da NF-e ou "
      wmsg += "dados de referência do cupom fiscal (número do ECF e COO) "
      wmsg += "informados nas extensÃµes."
      throwError(wmsg)
    }
    wlinha += "<refECF>"
    wlinha += "<mod>2D</mod>"
    wlinha += "<nECF>" + wnECF + "</nECF>"
    wlinha += "<nCOO>" + wnCOO + "</nCOO>"
    wlinha += "</refECF>"
  }
  wlinha += "</NFref>"
}

wlinha += "</ide>"


//202607 - NPP.002862 - REGRAS DE IMPOSTOS PARA VENDAS PARA SUFRAMA - NOTA FISCAL
worigemnota = ""
wtnnum = ""
wisuf = ""
wmsufra = 0
wmsufra = x_mc_select_extension_fn("n", "DDOCTX", formatNumber(wrow.zk, "N00000000000000"), "NFSUFRAMA");
if (wmsufra > 0) {
  wiorg = "TEC"
  wientt = wrow.ientt.trim()
  wient = wrow.ient.trim()
  wisencaosuframa = ddoc0_mc_get_suframa_fn(wiorg, wientt, wient)

  wsel = " select tnnum from bentt0 with (nolock) where ientt = '" + wrow.ientt.trim() + "' and ient = '" + wrow.ient.trim() + "' "
  wtnnum = getSQLValue(wsel).trim()
}

// Monta os dados do emitente da nota fiscal
wlinha += "<emit>"
wlinha += "<CNPJ>" + wCNPJ_C02 + "</CNPJ>"
wlinha += "<xNome>" + wxNome_C03 + "</xNome>"
wlinha += "<xFant>" + xFant_C04 + "</xFant>"
wlinha += "<enderEmit>"
wlinha += "<xLgr>" + wxLgr_C06 + "</xLgr>"
wlinha += "<nro>" + wnro_C07 + "</nro>"
wlinha += "<xBairro>" + wxBairro_C09 + "</xBairro>"
wlinha += "<cMun>" + wcMun_C10 + "</cMun>"
wlinha += "<xMun>" + wxMun_C11 + "</xMun>"
wlinha += "<UF>" + wUF_C12 + "</UF>"
wlinha += "<CEP>" + wCEP_C13 + "</CEP>"
wlinha += "<cPais>" + wcPais_C14 + "</cPais>"
wlinha += "<xPais>" + wxPais_C15 + "</xPais>"
wlinha += "</enderEmit>"
wlinha += "<IE>" + wIE_C17 + "</IE>"
if (temServico) {
  wlinha += "<IM>" + wIE_C17 + "</IM>"
  wlinha += "<CNAE>9511800</CNAE>"
}
if (wIEST.trim() != "") {
  wlinha += "<IEST>" + wIEST + "</IEST>"
}

wlinha += "<CRT>" + wcrt + "</CRT>"
wlinha += "</emit>"

// Dados do destinatario da nota
wlinha += "<dest>"

wwcnpj = ""//"<CNPJ></CNPJ>"
wwcep = ""
wwcpl = ""
wwie = ""
wwemail = ""

// Se o cliente Não for do exterior, preenche os campos do CNPJ
// ou CPF com os dados do cliente
if (!wexterior) {
  wwcnpj = "<CNPJ>" + wCNPJ_E02 + "</CNPJ>"
  if (wCPF_E03.length() != 14) {
    wwcnpj = "<CPF>" + wCPF_E03 + "</CPF>"
  }
}

// Se o cliente Não for do exterior, informa o CEP
if (!wexterior) {
  wwcep = "<CEP>" + wCEP_E13 + "</CEP>"
}

// Se existir complemento do endereço do cliente,
// informa-o no xml
if (wxCpl_E08 != "") {
  wwcpl = "<xCpl>" + wxCpl_E08 + "</xCpl>"
}

// Se o Indicador da IE do Destinatário for 1, informa a IE do destinatario
if (windIEDest_E16a == "1")
  wwie = "<IE>" + wIE_E17 + "</IE>";

//NPP.002862 - REGRAS DE IMPOSTOS PARA VENDAS PARA SUFRAMA - NOTA FISCAL
if (wmsufra > 0 && wisencaosuframa != "") {
  wisuf = "<ISUF>" + wtnnum + "</ISUF>"
}

// Se o email do destinatario for informado, entao informa no XML
if (wemail_E19 != "")
  wwemail = "<email>" + wemail_E19 + "</email>"

wwidEstrangeiro = ""
if (wexterior)
  wwidEstrangeiro = "<idEstrangeiro>" + widEstrangeiro_E03a + "</idEstrangeiro>"

// Se o ambiente for 1 (Produção), atribui aos campos os valores
// reais do destinatario da nota fiscal


if (wtpAmb == "1") {

  // Monta o XML com os dados do destinatario
  wlinha += wwcnpj
  wlinha += wwidEstrangeiro
  wlinha += "<xNome>" + wxNome_E40 + "</xNome>"
  wlinha += "<enderDest>"
  wlinha += "<xLgr>" + wxLgr_E06 + "</xLgr>"
  wlinha += "<nro>" + wnro_E07 + "</nro>"
  wlinha += wwcpl
  wlinha += "<xBairro>" + wxBairro_E09 + "</xBairro>"
  wlinha += "<cMun>" + wcMun_E10 + "</cMun>"
  wlinha += "<xMun>" + wxMun_E11 + "</xMun>"
  wlinha += "<UF>" + wUF_E12 + "</UF>"
  wlinha += wwcep
  wlinha += "<cPais>" + wcPais_E14 + "</cPais>"
  wlinha += "<xPais>" + wxPais_E15 + "</xPais>"
  if (wfone_E16 != "" && wfone_E16.length() >= 10) {
    wlinha += "<fone>" + wfone_E16 + "</fone>"
  }
  wlinha += "</enderDest>"
  wlinha += "<indIEDest>" + windIEDest_E16a + "</indIEDest>"
  wlinha += wwie
  if (wmsufra > 0 && wisencaosuframa != "") {
    wlinha += wisuf //NPP.002862 - REGRAS DE IMPOSTOS PARA VENDAS PARA SUFRAMA - NOTA FISCAL
  }
  wlinha += wwemail

} else {

  wlinha += wwcnpj
  wlinha += wwidEstrangeiro
  wlinha += "<xNome>NF-E EMITIDA EM AMBIENTE DE HOMOLOGACAO - SEM VALOR FISCAL</xNome>"
  wlinha += "<enderDest>"
  wlinha += "<xLgr>" + wxLgr_E06 + "</xLgr>"
  wlinha += "<nro>" + wnro_E07 + "</nro>"
  wlinha += wwcpl
  wlinha += "<xBairro>" + wxBairro_E09 + "</xBairro>"
  wlinha += "<cMun>" + wcMun_E10 + "</cMun>"
  wlinha += "<xMun>" + wxMun_E11 + "</xMun>"
  wlinha += "<UF>" + wUF_E12 + "</UF>"
  wlinha += wwcep
  wlinha += "<cPais>" + wcPais_E14 + "</cPais>"
  wlinha += "<xPais>" + wxPais_E15 + "</xPais>"
  wlinha += "</enderDest>"
  wlinha += "<indIEDest>" + windIEDest_E16a + "</indIEDest>"
  wlinha += wwie
  if (wmsufra > 0 && wisencaosuframa != "") {
    wlinha += wisuf //NPP.002862 - REGRAS DE IMPOSTOS PARA VENDAS PARA SUFRAMA - NOTA FISCAL
  }
  wlinha += wwemail

}

wlinha += "</dest>"


// Local de entrega 
if (wtpAmb == "1" && inList(wrow.idoct2.trim(), ["NPV", "NPA"])) {

  wsel = "select ctcf  from ddoct0  where iorg  = '" + wrow.iorg.trim() + "'"
  wsel += "     and idoct = '" + wrow.idoct2.trim() + "'"
  wsel += "     and idoc2  = '" + wrow.idoc2.trim() + "'"
  wctcf = getSQLValue(wsel).trim()

  if (inList(wctcf.trim(), ["VX-WEB", "VX-WIO"])) {
    wsite = true
  }

  //localizar pedido.
  wcons = "select zk, iixp2, iorg, idoct, idoc, ientt, ient from ddoct0 where iorg  = '" + wrow.iorg.trim() + "'"
  if (wsite) {
    wcons += " and idoct  = '" + wrow.idoct2.trim() + "'"
    wcons += " and idoc2 = '" + wrow.idoc2.trim() + "'"
  } else {
    wcons += " and idoct = '" + wrow.idoct2.trim() + "'"
    wcons += " and idoc  = '" + wrow.idoc2.trim() + "'"
  }
  wcons += "and ientt = '" + wrow.ientt.trim() + "' and cstc <> 'XA' and csto <> 'XA'"
  wddoc = getRow("DDOC", wcons)

  if (wddoc.wdcode == 100) {
    throwError("Pedido não encontrado.")
  }

  wzk = wddoc.zk
  wlocalEntrega = wddoc.iixp2

  wsel = " SELECT count(*) "
  wsel += " FROM ddtxt0 with(nolock) "
  wsel += "  where iorg = '" + wddoc.iorg.trim() + "' "
  wsel += "   and idoct = '" + wddoc.idoct.trim() + "' "
  wsel += "   and idoc  = '" + wddoc.idoc.trim() + "' "
  wsel += "   and ientt = 'CL' "
  wsel += "   and ccx   = '04' "
  wdtxt = getSQLNumber(wsel)

  if (wrow.idoct.trim() == "NNF" && wlocalEntrega != "05" && wdtxt == 0) {

    wxNome_G02b = x_mc_select_extension_fn("c", "ddoctx", wzk, "wnome").trim().replaceAll("&", "E")
    // Testa se existe cadastro na extensão 
    if (wxNome_G02b != "") {

      // Seleciona CPF ou CNPJ da tabela de extensão
      wCNPJ_G02 = ""
      wCPF_G02 = x_mc_select_extension_fn("c", "ddoctx", wzk, "wdocumento").replaceAll("[^0-9]", "")


      // Decide se é CPF ou CNPJ
      if (wCPF_G02.length() == 14) {
        wCNPJ_G02 = wCPF_G02
      }

      // Validação
      if (wCNPJ_G02.trim().isEmpty() && wCPF_G02.length() != 11) {
        throwError("CPF inválido, verifique cadastro na tela de informações logísticas")
      }

      // Resgata logradouro
      // e testa se está dentro do intervalo permitido.
      wxLgr_G03 = x_mc_select_extension_fn("c", "ddoctx", wzk, "wlogradouro")


      if (wxLgr_G03.length() < 2 || wxLgr_G03.length() > 60) {
        throwError("Campo logradouro inválido, deve conter no mínimo 2 e no máximo 60 caracteres.")
      }

      // Resgata o número da moradia
      wnro_G04 = x_mc_select_extension_fn("c", "ddoctx", wzk, "wnumero").trim()

      if (wnro_G04.length() < 1 || wnro_G04.length() > 60) {
        throwError("Campo número inválido, deve contenter no mínimo 1 e no máximo 60 digitos.")
      }

      // Regasta complemento
      wxCpl_G05 = x_mc_select_extension_fn("c", "ddoctx", wzk, "wcomplemento")
      if (wxCpl_G05.length() < 1 && wxCpl_G05.length() > 60 && wxCpl_G05 != "") {
        throwError("Campo complemento inválido, deve contenter no mínimo 1 e no máximo 60 caracteres.")
      }

      // Regasta bairro 
      wxBairro_G06 = x_mc_select_extension_fn("c", "ddoctx", wzk, "wbairro")
      if (wxBairro_G06.length() < 2 || wxBairro_G06.length() > 60) {
        throwError("Campo bairro  inválido, deve contenter no mínimo 2 e no máximo 60 caracteres.")
      }

      // Resgasta nome do município     
      // remove acentos
      wxMun_G08 = x_mc_select_extension_fn("c", "ddoctx", wzk, "wcidade").trim()
      wmunicipio = x_mc_retira_acento_fn(x_mc_select_extension_fn("c", "ddoctx", wzk, "wcidade").trim())

      if (wxMun_G08.length() < 1 || wxMun_G08.length() > 60) {
        throwError("Campo nome do município_g0 inválido, deve conter no mínimo 2 e no máximo 60 caracteres")
      }

      wUF_G09 = x_mc_select_extension_fn("c", "ddoctx", wzk, "westado").trim().toUpperCase()

      // Resgata código do município 
      wcMun_G07 = ""

      wcons = "select ngeos from bgeot0 where ngeo = '" + wmunicipio + "' and igeob = '" + wUF_G09 + "'"
      wcmun = getSQLValue(wcons).trim()
      wcMun_G07 = wcmun
      //wcMun_G07 = formatNumber(wcmun,"N0000000")



      // Resgasta CEP
      wCEP_G10 = x_mc_select_extension_fn("c", "ddoctx", wzk, "wcep").replaceAll("[^0-9]", "")

      if (wCEP_G10 != "" && wCEP_G10.length() != 8) {
        throwError("Campo nome do CEP inválido, deve conter 8 digitos")
      }

      wcPais_G11 = 1058
      wxPais_G12 = "BRASIL"

      // Resgata telefones
      wfone_G13 = x_mc_select_extension_fn("c", "ddoctx", wzk, "wfone").replaceAll("[^0-9]", "")

      if (wfone_G13 != "" && wfone_G13.length() < 6 || wfone_G13.length() > 14) {
        throwError("Campo telefone inválido, deve conter no mínimo 6 e no máximo 14 digitos, incluindo DDD.")
      }

      // Resgata a Inscrição Estadual
      wIE_G15 = x_mc_select_extension_fn("c", "ddoctx", wzk, "winscricaoestadual").replaceAll("[^0-9]", "")

      if (wIE_G15 != "" && wIE_G15.length() < 2 || wIE_G15.length() > 14) {
        throwError("Campo IE inválido, deve conter no mínimo 2 e no máximo 14 dígitos, sem os caracteres ponto, barra e hinfen.")
      }

      // Fim dos resgate de dados e validações


      // Montagem do xml que será submetido 
      // <entrega> é a tag de abertura do bloco G
      wlinha += "<entrega>"

      if (wCPF_G02.length() == 11) {
        wlinha += "<CPF>" + wCPF_G02 + "</CPF>"
      } else {
        wlinha += "<CNPJ>" + wCNPJ_G02 + "</CNPJ>"
      }

      if (wxNome_G02b.length() > 60) {
        wxNome_G02b = wxNome_G02b.substring(0, 60)
      }

      wlinha += "<xNome>" + wxNome_G02b + "</xNome>"

      wlinha += "<xLgr>" + wxLgr_G03 + "</xLgr>"
      wlinha += "<nro>" + wnro_G04 + "</nro>"

      if (wxCpl_G05 != "") {
        wlinha += "<xCpl>" + wxCpl_G05 + "</xCpl>"
      }
      wlinha += "<xBairro>" + wxBairro_G06 + "</xBairro>"
      wlinha += "<cMun>" + wcMun_G07 + "</cMun>"
      wlinha += "<xMun>" + wxMun_G08 + "</xMun>"
      wlinha += "<UF>" + wUF_G09 + "</UF>"
      if (wCEP_G10 != "")
        wlinha += "<CEP>" + wCEP_G10 + "</CEP>"
      wlinha += "<cPais>" + wcPais_G11 + "</cPais>"
      wlinha += "<xPais>" + wxPais_G12 + "</xPais>"
      if (wfone_G13 != "")
        wlinha += "<fone>" + wfone_G13 + "</fone>"
      if (wCPF_G02.length() == 14 && wIE_G15 != "" && wIE_G15 != "ISENTO")
        wlinha += "<IE>" + wIE_G15 + "</IE>"
      wlinha += "</entrega>"
    } else {

      // Utilizaremos as variáveis do bloco E
      // Não tem cadastro na extensão, então vai o endereço do destinatário ou cliente   
      wlinha += "<entrega>"
      wlinha += wwcnpj
      wlinha += "<xNome>" + wxNome_E40 + "</xNome>"
      wlinha += "<xLgr>" + wxLgr_E06 + "</xLgr>"
      wlinha += "<nro>" + wnro_E07 + "</nro>"
      wlinha += wwcpl
      wlinha += "<xBairro>" + wxBairro_E09 + "</xBairro>"
      wlinha += "<cMun>" + wcMun_E10 + "</cMun>"
      wlinha += "<xMun>" + wxMun_E11 + "</xMun>"
      wlinha += "<UF>" + wUF_E12 + "</UF>"
      wlinha += wwcep
      wlinha += "<cPais>" + wcPais_E14 + "</cPais>"
      wlinha += "<xPais>" + wxPais_E15 + "</xPais>"
      if (wfone_E16 != "" && wfone_E16.length() >= 10) {
        wlinha += "<fone>" + wfone_E16 + "</fone>"
      }
      if (wIE_E17 != "" && wIE_E17 != "ISENTO" && wCPF_E03.length() == 14)
        wlinha += "<IE>" + wIE_E17 + "</IE>"
      wlinha += "</entrega>"

    }
  }
}

// Totalizadores das linhas
wcont = 1
wtotvbc = 0.00
wtoticms = 0.00
wtotprod = 0.00
wtotpis = 0.00
wtotcofins = 0.00
wtotipi = 0.00
wtotmvaldc = 0.00
wtotii = 0.00
wtotdespadu = 0.00
wtotfrete = 0.00
wtotfreteicms = 0.00
wvServ_W18 = 0.00
wvISS_W20 = 0.00

//NPP.002005 - INCLUSÃO DE TAG NO XML DA NF-e E NCF-e
wtoticmsdeson = 0
wicmsdeson = 0
// Tratamento frete em NDC - Anderson Lopes
wlfretendc = 0.00
wlfretendcicms = 0.00
wtfretendc = 0.00
wfrtndc = false

wsel = "Select isnull(sum(a.mvalor),0) as mvalor, isnull(sum(a.mvalim),0) as mvalim "
wsel += "  From ddolt0 a, bpsrt0 b  "
wsel += " Where a.iorg    = '" + wrow.iorg.trim() + "' "
wsel += "   and a.idoct   = '" + wrow.idoct.trim() + "' "
wsel += "   and a.idoc    = '" + wrow.idoc.trim() + "' "
wsel += "   and a.ientt   = '" + wrow.ientt.trim() + "' "
wsel += "   and a.ient    = '" + wrow.ient.trim() + "' "
wsel += "   and b.ipst    = 'SRV' "
if (wrow.idoc.trim() != "F42/00033477") {
  wsel += "   and b.ccl     = '' "
}
wsel += "   and a.iorg    = b.iorg "
wsel += "   and a.ipsr    = b.ipsr "
wddolf = getMRow("DDOL", wsel)
wtotfrete = wddolf.mvalor
wtotfreteicms = round(wddolf.mvalim, 2)
wtotfretet = wddolf.mvalor
wtotfreteicmst = round(wddolf.mvalim, 2)
wprimeiro = 0

wdinr = ""
wdidt = ""
wdilocal = ""
wdidtdes = ""
wdiexport = ""
wutomatismo = false

//Verifica se a filial esta confirma e assim usa o automatismo
wsel = "Select count(*) "
wsel += "  From bctxt0 a "
wsel += " Where a.ictx  = 'BCTX*AUT*FISCAL' "
wsel += "   and a.ivalk = '" + wrow.iuorg.trim() + "' "
wsel += "   and a.cst   = 'E0'"
wautuo = getSQLNumber(wsel)

//testa se retornou algo
if (wautuo > 0) {
  wutomatismo = true
}

if (inList(wrow.idoct2, ["NPV", "NPA"])) {
  wflagavaria = true

  wsel = "Select a.ctcf "
  wsel += "  From ddoct0 a "
  wsel += " Where a.iorg  = '" + wrow.iorg.trim() + "' "
  wsel += "   and a.idoct = '" + wrow.idoct2.trim() + "' "
  wsel += "   and a.idoc2  = '" + wrow.idoc2.trim() + "' "
  wctcf = getSQLValue(wsel).trim()

  if (wctcf.trim() == "VX-WEB") {
    wsite = true
  }
}


//if ((wrow.cit.trim().substring(0,1) == "3") || (wrow.iuorg.trim() == "F03") || (wrow.iuorg.trim() == "F00") || (wrow.iuorg.trim() == "F09") || ((wrow.iuorg.trim() == "F08") && wnodo != "610")) {

//if ((inList(wrow.cit.trim().substring(0,1),["3","7"])) || inList(wrow.iuorg.trim(),["F03","F07","F00","F09","F08","F13"]) && wnodo != "610")) {
// -- samuel
if ((inList(wrow.cit.trim().substring(0, 1), ["3", "7"])) || (!x_mc_get_access3_fn("DDOC0-0373", ""))) {


  // Formulário de Input
  wdfform = MForm:: getDialogForm(m, "DDOCNFEIMP", "ME", "Importação", 3)
  wdfform.setEnt(m.getEnt())
  wdfform.setRow(getMRow("DDOC"))
  wdfform.setAction("VALIDATE_FORM")

  wqvol = 1.00
  wsel2 = "SELECT d2.zk FROM ddoct0 d INNER JOIN ddoct0 d2 ON d.idoct2 = d2.idoct and d.idoc2 = d2.idoc  and d.zk=" + wrow.zk
  wzk = getSQLNumber(wsel2)

  if (wzk < 1) {
    wsel = " SELECT d2.zk  "
    wsel += " FROM ddoct0 d  "
    wsel += " INNER JOIN ddoct0 d2 "
    wsel += " on  d2.idoct = 'NPV' "
    wsel += " and d2.idoct2 = d.idoct2 "
    wsel += " and d2.idoc2  = d.idoc2  "
    wsel += " where d.zk=" + wrow.zk
    println(wsel); flush()
    wzk = getSQLNumber(wsel)
  }

  wqvol = x_mc_select_extension_fn("n", "DDOCTX", wzk, "wqvol")

  if (wqvol <= 1) {
    wsel = "SELECT b.mvalor "
    wsel += "  FROM ddoct0 a "
    wsel += "         JOIN ddoet0 b "
    wsel += "           ON a.idoct = b.idoct "
    wsel += "          AND a.idoc  = b.idoc "
    wsel += " WHERE b.cdoe  = 'EM'"
    wsel += " AND a.idoct = '" + wrow.idoct2.trim() + "' "
    wsel += " AND a.idoc  = '" + wrow.idoc2.trim() + "' "
    wsel += " ORDER BY b.zhst DESC "
    x = getRows("DDOC", wsel)
    if (x.size() > 0) {
      wqvol = x.elementAt(0).mvalor
    }
  }

  wdfform.wqvol = wqvol
  wdfform.wespecie = "VOL"
  wdfform.wpesol = 0.00
  wdfform.wpesob = 0.00
  wdfform.ientt = "FN"

  wient = ""
  wccl = ""

  westado = ""

  if (inList(wrow.idoct2.trim(), ["NPV", "NPA"])) {

    wsel = " Select a.* "
    wsel += "  From ddoct0 a with(nolock) "
    wsel += " Where a.iorg   = '" + wrow.iorg.trim() + "' "
    wsel += "   and a.idoct  = '" + wrow.idoct2.trim() + "' "
    wsel += "   and a.idoc   = '" + wrow.idoc2.trim() + "' "
    println(wsel); flush()
    wnpv = getRow("DDOC", wsel)

    if (wnpv.wdcode == 100) {
      wsel = "Select a.* "
      wsel += "  From ddoct0 a with(nolock) "
      wsel += " Where a.iorg   = '" + wrow.iorg.trim() + "' "
      wsel += "   and a.idoct2 = '" + wrow.idoct2.trim() + "' "
      wsel += "   and a.idoc2  = '" + wrow.idoc2.trim() + "' "
      wsel += "   and a.idoct  IN ('NPV', 'NPA') "
      wsel += "   and a.iuorg  = '" + wrow.iuorg.trim() + "' "
      println(wsel); flush()
      wnpv = getRow("DDOC", wsel)
    }

    if (wnpv.wdcode != 100) {

      wsel = " SELECT  a.ttext10 "
      wsel += " FROM    sinct0 a WITH ( NOLOCK ) "
      wsel += "         INNER JOIN ddoct0 b WITH ( NOLOCK ) ON a.iorg = b.iorg "
      wsel += "                                                AND a.ttext1 = b.idoct "
      wsel += "                                                AND a.ttext2 = b.idoc "
      wsel += "                                                AND a.c2 = '*' "
      wsel += " WHERE   b.zk = " + wnpv.zk + " "
      wsel += " and a.tipo = 'COTF' "
      println(wsel); flush()
      wient = getSQLValue(wsel).trim()

      if (wient == "") {

        wsel = " select d.zchar "
        wsel += " from ddoctx d WITH ( NOLOCK ) "
        wsel += " where d.zkent = " + wnpv.zk
        wsel += " AND d.zcomp = 'FN_trans' "
        println(wsel); flush()
        wient = getSQLValue(wsel).trim()

        if (wient == "") {
          wsel = " select b.ient "
          wsel += " from bentt0 b with(nolock) "
          wsel += "   inner join ddozt0 d with(nolock) "
          wsel += "   on d.zk = " + wnpv.zk + " "
          wsel += "   inner join bfrtt0 c with(nolock) "
          wsel += "   on c.zk = d.zkaux "
          wsel += "   where  b.ientt = 'FN' "
          wsel += "    and   b.ient  = c.ient "
          println(wsel); flush()
          wient = getSQLValue(wsel).trim()
        }
      }

      wsel = " SELECT  count(*) "
      wsel += " FROM    sinct0 a WITH ( NOLOCK ) "
      wsel += "         INNER JOIN ddoct0 b WITH ( NOLOCK ) ON a.iorg = b.iorg "
      wsel += "                                                AND a.ttext1 = b.idoct "
      wsel += "                                                AND a.ttext2 = b.idoc "
      wsel += "                                                AND a.c2 = '*' "
      wsel += " WHERE   b.zk = " + wnpv.zk + " "
      wsel += " and a.tipo = 'COTF' "
      println(wsel); flush()
      wfrt = getSQLNumber(wsel)

      //Tipo de Frete
      if (wfrt != 0 || wnpv.ctcf.trim() == "VX-WEB") {
        wccl = "CIF"
      } else if (wfrt == 0 || inList(wnpv.iixp2.trim(), ["01", "05"])) {
        wccl = "FOB"
      }
    }

    //Mostrar UF de destino
    //Caso tenha Simples Remessa, usa o CL de Simples Remessa
    wsel = " select * "
    wsel += "   from ddtxt0 with(nolock) "
    wsel += "  where iorg  = '" + wnpv.iorg + "'"
    wsel += "    and idoct = '" + wnpv.idoct + "'"
    wsel += "    and idoc  = '" + wnpv.idoc + "'"
    wsel += "    and ccx   = '04'"
    wddtx2 = getRow("DDTX", wsel)

    if (wddtx2.wdcode != 100) {

      wsel = " select top 1 testado "
      wsel += " from bendt0 with(nolock) "
      wsel += " where ientt  = '" + wddtx2.ientt2 + "' "
      wsel += " and ient   = '" + wddtx2.ient2 + "' "
      westado = getSQLValue(wsel)

    } else {

      //Caso tenha endereço de entrega, usa o endereço cadastrado para entrega
      wzk = formatNumber(wnpv.zk, "N00000000000000")

      westado = x_mc_select_extension_fn("c", "ddoctx", wzk, "westado").trim()

      if (westado == "") {

        //Caso tenha terceiro a faturar, Usa endereço do terceiro a faturar
        wsel = " select * "
        wsel += "   from ddtxt0 with(nolock) "
        wsel += "  where iorg  = '" + wnpv.iorg + "'"
        wsel += "    and idoct = '" + wnpv.idoct + "'"
        wsel += "    and idoc  = '" + wnpv.idoc + "'"
        wsel += "    and ccx   = '02'"
        wddtx2 = getRow("DDTX", wsel)

        if (wddtx2.wdcode != 100) {

          wsel = " select top 1 testado "
          wsel += " from bendt0 with(nolock) "
          wsel += " where ientt  = '" + wddtx2.ientt2 + "' "
          wsel += " and ient   = '" + wddtx2.ient2 + "' "
          westado = getSQLValue(wsel)

        } else {

          //passando pelas anteriores, usa o endereço do CL do pedido
          wsel = " select top 1 testado "
          wsel += " from bendt0 with(nolock) "
          wsel += " where ientt  = '" + wnpv.ientt + "' "
          wsel += " and ient   = '" + wnpv.ient + "' "
          westado = getSQLValue(wsel)

        }

      }

    }
  }

  wnent = ""

  if (wient != "") {
    wnent = getSQLValue("select nent from bentt0 with(nolock) where ientt = 'FN' and ient = '" + wient + "' ")
  }

  wdfform.ient = wient
  wdfform.nent = wnent
  wdfform.wplaca = ""
  wdfform.wuf = westado
  wdfform.wccl = if (wccl == "") wrow.ccl.trim() else wccl;

  if (inList(wrow.cit.trim(), ["6933", "5933"])) {
    wdfform.wccl = "CIF"
  }


  if (inList(wrow.idoct2.trim(), ["NPV"])) {

    // Caso seja B2B, define o tipo do frete conforme a cotação enviada pela VTEX
    if ((wrow.iuorgt3.trim() == "AC") &&
      (wrow.iuorg3.trim() == "1068")) {

      wSelect = " SELECT ttext3 ";
      wSelect += "   FROM sinct0 WITH (NOLOCK) ";
      wSelect += "  WHERE iorg   = 'TEC' ";
      wSelect += "    AND ttext1 = '" + wrow.idoct2 + "' ";
      wSelect += "    AND ttext2 = '" + wrow.idoc2 + "' ";

      wdfform.wccl = getSQLValue(wSelect);

      // Caso seja GTSOLAR, define o tipo do frete conforme o NPV
    } else if ((wrow.iuorgt3.trim() == "AC") &&
      (wrow.iuorg3.trim() == "1029")) {

      wSelect = " SELECT ccl ";
      wSelect += "   FROM ddoct0 WITH (NOLOCK) ";
      wSelect += "  WHERE iorg  = 'TEC' ";
      wSelect += "    AND idoct = '" + wrow.idoct2 + "' ";
      wSelect += "    AND idoc  = '" + wrow.idoc2 + "' ";

      wdfform.wccl = getSQLValue(wSelect);

    } else {

      wselr = "Select COUNT(zk) "
      wselr += "  From ddoct0 "
      wselr += " Where iorg  = '" + wrow.iorg + "' "
      wselr += "   and ientt = '" + wrow.ientt + "' "
      wselr += "   and ient  = '" + wrow.ient + "' "
      wselr += "   and idoct = '" + wrow.idoct2 + "' "
      wselr += "   and idoc  = '" + wrow.idoc2 + "' "
      wselr += "   and ndoc  =    'VENDA RAPPI'       "

      if (getSQLNumber(wselr) > 0) {
        wdfform.wccl = "FOB"
      }
    }
  }


  wdfform.wdinr = ""
  wdfform.wdidt = ""
  wdfform.wdilocal = ""
  wdfform.wdidtdes = ""
  wdfform.wdiexport = ""

  wsel = " SELECT  sum(b.qpeso * a.qpsr) qpeso "
  wsel += " FROM   ddolt0 a "
  wsel += "        INNER JOIN bpsrt0 b ON  a.iorg = b.iorg AND a.ipsr = b.ipsr AND a.ipsrlp = b.ipsrlp "
  wsel += " Where a.iorg    = '" + wrow.iorg.trim() + "' "
  wsel += "   and a.idoct   = '" + wrow.idoct.trim() + "' "
  wsel += "   and a.idoc    = '" + wrow.idoc.trim() + "' "
  wsel += "   and a.ientt   = '" + wrow.ientt.trim() + "' "
  wsel += "   and a.ient    = '" + wrow.ient.trim() + "' "
  wqpeso = getSQLNumber(wsel)

  //nota de pedido solar
  //Consulta se o canal de venda e a filial estão configurados no setup GTSOLAR
  wSelect = " SELECT COUNT(*) "
  wSelect += "  FROM bctxt0 canal WITH (NOLOCK) "
  wSelect += " INNER JOIN bctxt0 filial WITH (NOLOCK) ON filial.ictx = canal.ictx "
  wSelect += " WHERE canal.ictx    = 'SETUP*GTSOLAR' "
  wSelect += "   AND canal.ivalk   = 'CANAL_NF' "
  wSelect += "   AND ';' + TRIM(canal.tparms) + ';' LIKE '%;" + wrow.iuorg2.trim() + ";%' "
  wSelect += "   AND filial.ictx   = 'SETUP*GTSOLAR' "
  wSelect += "   AND filial.ivalk  = 'FILIAL_NF' "
  wSelect += "   AND filial.tparms = '" + wrow.iuorg.trim() + "' "
  wNpvSolar = getSQLNumber(wSelect)

  if (wNpvSolar > 0) {
    wreturn = ddocr_mc_calc_peso_fn(wrow)
    if (wreturn > 0) wqpeso = wreturn;
  }

  wdfform.wpesol = wqpeso
  wdfform.wpesob = wqpeso

  // sugere nome da transportadora axado
  if (wsite) {

    wsel = " select b.zk from ddoct0 a with (nolock)"
    wsel += " inner join ddoct0 b on a.idoc2 = b.idoc2 and a.idoct2 = b.idoct2 and a.ient = b.ient"
    wsel += " where b.idoct = 'NPV'"
    wsel += " and   b.cstc not in ('PD','XA')"
    wsel += " and   a.idoct = '" + wrow.idoct.trim() + "'"
    wsel += " and   a.idoc  = '" + wrow.idoc.trim() + "'"
    wsel += " and   b.iuorg = '" + wrow.iuorg.trim() + "'"
    wzktrans = getSQLValue(wsel)
    if (wzktrans != "") {
      wzkt = formatNumber(wzktrans, "N00000000000000")
      wsel = " select b.zchar"
      wsel += " from ddoct0 a"
      wsel += " inner join ddoctx b on a.zk = b.zkent and b.zcomp = 'trans'"
      wsel += " where a.zk = " + wzkt
      wnomet = getSQLValue(wsel)
      wdfform.nent = wnomet
    }
  }

  if (wrow.idoct2.trim() == "NPV") {

    wsel = " SELECT zk "
    wsel += "   FROM ddoct0 "
    wsel += "  WHERE iorg = 'TEC' "
    if (wsite) {
      wsel += "    AND idoct  = '" + wrow.idoct2.trim() + "' "
      wsel += "    AND idoc2  = '" + wrow.idoc2.trim() + "' "

    } else {
      wsel += "    AND idoct = '" + wrow.idoct2.trim() + "' "
      wsel += "    AND idoc  = '" + wrow.idoc2.trim() + "' "
    }
    wzknpv = getSQLNumber(wsel)

    wsel = "SELECT zkaux FROM ddozt0 where nobj = 'bfrtt0' AND zk = " + wzknpv + "  "
    zkaux = getSQLValue(wsel)

    if (zkaux.trim() != "") {

      wsel = "SELECT ttext2 FROM ddozt0 where nobj = 'bfrtt0' AND zk = " + wzknpv + " and ttext = 'C'  "
      wdesctra = getSQLValue(wsel)

      if (wdesctra == "") {
        wsel = "SELECT ttext2 FROM ddozt0 where nobj = 'bfrtt0' AND zk = " + wzknpv + " and ttext = 'C'  "
        wdesctra = getSQLValue(wsel)

      }
      if (wdesctra != "") {
        wdfform.nent = wdesctra
      } else {
        wsel = "SELECT ientt, ient FROM bfrtt0 WHERE zk = " + zkaux
        wfrete = getMRow("BFRT", wsel)


        if (wfrete != null) {
          wsel = " SELECT ientt,ient,nent,tidfisc,tidfisc2,tmorad,tmail,testado,tmunicip "
          wsel += "   FROM bentt0 "
          wsel += "  WHERE ientt  = '" + wfrete.ientt.trim() + "' "
          wsel += "    AND ient   = '" + wfrete.ient.trim() + "' "
          wtra = getMRow("BENT", wsel)

          wdfform.nent = wtra.nent.trim()

          // dados do form viraram apenas var, campos foram removidos do form
          wendtra = wtra.tmorad.trim() + " " + wtra.tmail.trim()
          wuftra = wtra.testado.trim()
          // Para atender o novo CNPJ Alfanumerico, trocamos a regex antiga "[^0-9]" pela nova "[^A-Z0-9]".
          wcnpjtra = wtra.tidfisc.trim().replaceAll("[^A-Z0-9]", "")
          wietra = wtra.tidfisc2.trim().replaceAll("[^0-9]", "")
          wmuntra = wtra.tmunicip.trim()

          wflagwtra = true
        }
      }
    } else {

      wsel = "SELECT ttext7, ttext10 FROM sinct0 WHERE ttext2 = '" + wrow.idoc2.trim() + "' AND c2 = '*'"
      wfrete = getMRow("SINC", wsel)
      if (wfrete != null) {
        wdfform.ient = wfrete.ttext10.trim()
        wdfform.nent = wfrete.ttext7.trim()
      }
    }
  }

  expandForm(wdfform, false)

  //não abrir quando for nota simples
  if (!zglobals.containsKey("DANFESIMPLES") || (zglobals.containsKey("DANFESIMPLES") && !zglobals.DANFESIMPLES)) {
    cursor.commitWork()
    wdfform.showForm()
    cursor.beginWork()
    if (wdfform.getLastCmd().equals("CLOSEWINDOW")) { throwError("Operação Cancelada.") }
  }

  wqvol = wdfform.wqvol
  wespecie = wdfform.wespecie.trim()
  wpesol = wdfform.wpesol
  wpesob = wdfform.wpesob
  wientttra = wdfform.ientt.trim()
  wienttra = wdfform.ient.trim()
  wnome = wdfform.nent.trim()
  wplaca = wdfform.wplaca.trim()
  wuf = wdfform.wuf.trim()
  wccl = wdfform.wccl.trim()
  wdinr = wdfform.wdinr.trim()
  wdidt = wdfform.wdidt.trim()
  wdilocal = wdfform.wdilocal.trim()
  wdidtdes = wdfform.wdidtdes.trim()
  wdiexport = wdfform.wdiexport.trim()

  //impressão da etique jotuje
  zglobals.WQTDETQ = wqvol

  // Força Popular Site
  if (wnome.trim() == "") {
    wnome = x_mc_select_extension_fn("c", "DDOCTX", wzk, "trans").trim()
  }
  if (wienttra.trim() == "") {
    wienttra = x_mc_select_extension_fn("c", "DDOCTX", wzk, "FN_trans").trim()
  }



  if (wrow.cr.trim() == "VX") {
    wcf = ""
    wflagfrete = false
    wdf = "FORA"
    if (wrow.cit.substring(0, 1) == "5") {
      wdf = "DENTRO"
    }
    wsel = " select a.qqcoef1 "
    wsel += "   from bctxt0 a with (nolock) "
    wsel += "  where a.ictx  = 'BCTX*FRT*" + wbent.testado.toUpperCase().trim() + "*" + wdf + "' "
    wsel += "    and a.ivalk = 'VALOR*LIMITE*CIF' "
    wvalorlimitecif = getSQLNumber(wsel)

    if (wrow.mvalor < wvalorlimitecif && wccl == "CIF") {
      wcf = "CIF"
      wflagfrete = true
    }

    if (wrow.mvalor >= wvalorlimitecif && wccl.trim() == "FOB") {
      wcf = "FOB"
      wflagfrete = true
    }


    if (wflagfrete) {
      //Pede Confirmação
      wmsg1 = "Pedidos para " + wdf + " do estado o valor limite para pedidos " + wcf + " Ã© " + wvalorlimitecif
      wmsg2 = "Confirmar Operação?"
      cursor.commitWork()
      i = showError("MIN-EEEE01Q", [wmsg1, wmsg2])
      cursor.beginWork()
      if (i != 0) {
        throwError("Operação Cancelada")
      }
    }
  }
} //-- samuel

//NPP.001652 PARAMETRIZAÇÃO VENDA DE CELULAR F03 E F07
//NPP.001774 - CADASTRO DE REGRAS TRIBUTÁRIAS F59 
//verifica se tem iregra de filial para icms
wparfilial = ""
wparfilial = x_mc_regra_auto_fil_imp_fn(wrow, "", "", "", "", "")

//verifica se tem marcação icmsst							 
wvendaicmsst = 0
if (wparfilial != "") {
  wzk = formatNumber(wrow.zk, "N00000000000000")
  wvendaicmsst = x_mc_select_extension_fn("n", "ddoctx", wzk, "vendaicmsst")
}



//wsel  = "Select a.idol, a.ipsr, a.qpsr, a.mvalun, a.mvalim2, a.mvalor, a.qbfisc, a.pi, a.pi2, a.ndoc, a.ci, a.cci, a.iuorg, a.iuorg2, b.ipst,a.iixp, "
wsel = "SELECT a.idol, a.ipsr, a.qpsr, round(a.mvalun, 4) AS mvalun, a.mvalim2, a.mvalor, a.qbfisc, a.pi, a.pi2, a.ndoc, a.ci, a.cci, a.iuorg, \n"
wsel += "       a.iuorg2, b.ipst, a.iixp, a.zk, a.mvalim, a.cit, a.mvaldc, a.cfpsr2, b.cstat2, IIF(dbo.fn_is_photovoltaic_generator(b.ipsr) > 0, "
wsel += "                                                                                          REPLACE(a.ndoc, '.', ','), b.npsr) AS npsr, \n"
wsel += "       b.cur, b.cfpsr, b.cfpsr2 as wimpipi, a.irct1, a.cfpsr AS cfpsrl, a.cr,a.idoct,a.ctcf, (SELECT TOP 1 ea.ipsr2 "
wsel += "                                                                                         FROM bpsst0 ea "
wsel += "                                                                                        WHERE ea.iorg = 'TEC' "
wsel += "                                                                                          AND ea.ipsr = a.ipsr "
wsel += "                                                                                          AND ea.cpss IN('SI', 'EA') "
wsel += "                                                                                        ORDER BY ea.zk DESC) AS cbarras \n"
wsel += "  FROM ddolt0 a \n"
wsel += " INNER JOIN bpsrt0 b  "
wsel += "    ON a.iorg = b.iorg "
wsel += "   AND a.ipsr = b.ipsr "
wsel += " WHERE a.iorg  = '" + wrow.iorg.trim() + "' "
wsel += "   AND a.ientt = '" + wrow.ientt.trim() + "' "
wsel += "   AND a.ient  = '" + wrow.ient.trim() + "' "
wsel += "   AND a.idoct = '" + wrow.idoct.trim() + "' "
wsel += "   AND a.idoc  = '" + wrow.idoc.trim() + "' \n"

if ((wrow.ctcf.trim() == "5152C") || (wvendaicmsst > 0)) {
  wsel += "   and a.mvalor > 0.02"
} else { wsel += "   and a.qpsr    > 0 " }

if (wuser == "alopes") {
  wsel += "   and a.ndoc  <> 'DESPACESS' "
}

//Verifica se gera DANFE
wcsel = " select count(ivalk) as cont from bctxt0"
wcsel += " where ictx = 'FILIAIS*SRV*DANFE'"
wcsel += " and   ivalk = '" + wrow.iuorg.trim() + "'"
wsrv = getSQLNumber(wcsel)

if (wsrv < 1) {
  wsel += "   and b.ipst    <> 'SRV' "
}

wsel += "   and a.iorg    = b.iorg "
wsel += "   and a.ipsr    = b.ipsr "

if ((wrow.ctcf.trim() == "5152C") || wvendaicmsst > 0) {
  wsel += " order by a.idol, a.ipsr, a.qpsr, a.iixp \n"
} else {
  wsel += " order by a.idol, a.iixp  " //b.cfpsr, a.mvalor DESC "
}
println("DDOL >>>>> " + wsel); flush()
vddol = getRows("DDOL", wsel)

wvbcst = 0.00; wpICMSST = 0.00; wvICMSST = 0.00;
wnumlinha = 1;

foreach wddol(vddol.elements()) {
  //202607 - NPP.002862 - REGRAS DE IMPOSTOS PARA VENDAS PARA SUFRAMA - NOTA FISCAL
  wvaldescicmssuframa = 0
  if (wmsufra > 0 && wisencaosuframa.isentoicms.trim() == "SIM") {
    wvaldescicmssuframa = round(x_mc_select_extension_fn("n", "ddoltx", formatNumber(wddol.zk, "N00000000000000"), "SUFISENTOICMS"), 2)
  }


  //Compra Direta e Indireta Segunda parte
  wvendaIntImp = 0
  worigemimp = ""

  wvendaicmsdest = 0
  wvendalinhast = 0

  //Desconto ICMS Desonerado.
  wvaldescicmsdesone = 0

  if (wrow.idoct2.trim() == "NPV") {
    wsel = " select top 1 a.zk "
    wsel += "\n  from ddolt0 a with(nolock) "
    wsel += "\n   inner join ddoct0 b with(nolock) "
    wsel += "\n   on b.iorg = a.iorg "
    wsel += "\n   and b.idoct = 'NPV' "
    wsel += "\n   and b.idoct2 = '" + wrow.idoct2.trim() + "' "
    wsel += "\n   and b.idoc2 = '" + wrow.idoc2.trim() + "' "
    wsel += "\n where a.iorg = '" + wrow.iorg.trim() + "' "
    wsel += "\n and a.idoct = b.idoct "
    wsel += "\n and a.idoc = b.idoc "
    wsel += "\n and a.ipsr = '" + wddol.ipsr.trim() + "' "
    wsel += "\n and a.idol = '" + wddol.idol.trim() + "' "
    println(wsel); flush()
    wzkddol = getSQLValue(wsel).trim()

    if (wzkddol != "") {
      wvaldescicmsdesone = x_mc_select_extension_fn("n", "ddoltx", wzkddol, "wvaldescicmsdesone")
    }
  }

  //NPP.001652 PARAMETRIZAÇÃO VENDA DE CELULAR F03 E F07
  //NPP.001774 - CADASTRO DE REGRAS TRIBUTÁRIAS F59 
  wzklinha = formatNumber(wddol.zk, "N00000000000000")
  if (wparfilial != "") {
    //regra automatismo
    wvendaicmsdest = x_mc_select_extension_fn("n", "ddoltx", wzklinha, "vendaicmsdest")
    println("1 wvendaicmsdest " + wvendaicmsdest); flush();
  }
  if (wvendaicmsst > 0) {
