          wlinha += "<vICMS>" + formatNumber(wddol.mvalim + wtotfreteicms, "N0.00") + "</vICMS>"

          wvBCUFDest = formatNumber(((wddol.qpsr * wddol.mvalun) * wddol.qbfisc) + wtotfrete, "N0.00")
          wpICMSUFDest = formatNumber(17, "N0.00")

          wvbc = (wddol.qpsr * wddol.mvalun * wddol.qbfisc)

        }

      }
      wlinha += "</ICMS00>"
      wtoticms += round(wddol.mvalim, 2)
      wtotvbc += wvbc

