function DOUBLE(value) {
  if (value instanceof String){
    Double::valueOf(value)
  } else {
    value.doubleValue()
  }
}
function INT(value) {
  if (value instanceof Character){
    Types::charToInt(value)
  } else if (value instanceof String){
    Integer::parseInt(value)
  } else {
    value.intValue()
  }
}
function max(val1, val2) {
