        };
        wlinha += "<pICMSST>" + formatNumber(wpICMSST, "N0.00") + "</pICMSST>"
        wlinha += "<vICMSST>" + formatNumber(wvICMSST, "N0.00") + "</vICMSST>"
        wlinha += wtagICMSDeson
        wlinha += "</ICMS10>"

        wvBCUFDest = formatNumber((wddol.mvalor - wddol.mvalim2), "N0.00")
        wpICMSUFDest = formatNumber(wddol.pi, "N0.00")
        if (wuser == "scavalca") { showMessage("13 " + wpICMSUFDest) }

        //wvbc = (wddol.mvalor*wddol.qbfisc) 
        wvbc = wddol.mvalor - wddol.mvalim2

        // Totais        
        wtoticms += round(wddol.mvalim, 2)
        wtotvbc += wvbc
        if (wuser == "alopes") { showMessage("09 wtotvbc " + wtotvbc) }
        wvbcst2 += wvbcst
        wvst += wvICMSST
        println("Totais   BASE ICMS   ST 3 >>>>>>" + wvbcst2); flush();
        if (inList(wrow.cit.trim(), ["6411"])) {

          wmvalort = formatNumber(wddol.mvalor + wvICMSST, "N0.00")

          wsel = " update ddolt0 set mvalor =  " + wmvalort + ", vvalor =  " + wmvalort + ",  yvalor =  " + wmvalort + ", "
          wsel += "                   ci = '' , pi = 0.00, mvalim =  0.00, vvalim =  0.00,  yvalim =  0.00 "
          wsel += " where iorg    = '" + wrow.iorg.trim() + "' "
          wsel += "   and idoct   = '" + wrow.idoct.trim() + "' "
          wsel += "   and idoc    = '" + wrow.idoc.trim() + "' "
          wsel += "   and ientt   = '" + wrow.ientt.trim() + "' "
          wsel += "   and ient    = '" + wrow.ient.trim() + "' "
          x = executeSQL(wsel)

        }

      } else if (wddol.cfpsr.trim() == "020" && wbent2.testado.toUpperCase() == "CE") {
        wlinha += "<ICMS60>"
        if (inList(wrow.iuorg.trim(), ["F03", "F38"]) && (inList(wddol.iuorg2.trim(), ["I03", "I38"]))) {
