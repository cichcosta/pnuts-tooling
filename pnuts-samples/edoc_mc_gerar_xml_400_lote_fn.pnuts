  wqvol = 1.00
  wsel2 = "SELECT d2.zk FROM ddoct0 d INNER JOIN ddoct0 d2 ON d.idoct2 = d2.idoct and d.idoc2 = d2.idoc and d.zk=" + wrow.zk
  wzk = getSQLNumber(wsel2)

  if (wzk < 1) {
    wsel = " SELECT d2.zk  "
    wsel += " FROM ddoct0 d  "
    wsel += " INNER JOIN ddoct0 d2 "
    wsel += " on  d2.idoct = 'NPV' "
    wsel += " and d2.idoct2 = d.idoct2 "
    wsel += " and d2.idoc2  = d.idoc2  "
    wsel += " where d.zk=" + wrow.zk
    println(wsel); flush()
    wzk = getSQLNumber(wsel)
  }

  wqvol = x_mc_select_extension_fn("n", "DDOCTX", wzk, "wqvol")

  if (wqvol <= 1) {
    wsel = "SELECT b.mvalor "
    wsel += "  FROM ddoct0 a "
    wsel += "         JOIN ddoet0 b "
    wsel += "           ON a.idoct = b.idoct "
    wsel += "          AND a.idoc  = b.idoc "
    wsel += " WHERE b.cdoe  = 'EM'"
    wsel += " AND a.idoct = '" + wrow.idoct2.trim() + "' "
    wsel += " AND a.idoc  = '" + wrow.idoc2.trim() + "' "
    wsel += " ORDER BY b.zhst DESC "
    x = getRows("DDOC", wsel)
    if (x.size() > 0) {
      wqvol = x.elementAt(0).mvalor
    }
  }

  wdfform.wqvol = wqvol
  wdfform.wespecie = "VOL"
  wdfform.wpesol = 0.00
  wdfform.wpesob = 0.00
  wdfform.ientt = "FN"

  wient = ""
  wccl = ""

  if (wrow.idoct2.trim() == "NPV") {

    wsel = " Select a.* "
    wsel += "  From ddoct0 a with(nolock) "
    wsel += " Where a.iorg   = '" + wrow.iorg.trim() + "' "
    wsel += "   and a.idoct  = '" + wrow.idoct2.trim() + "' "
    wsel += "   and a.idoc   = '" + wrow.idoc2.trim() + "' "
    println(wsel); flush()
    wnpv = getRow("DDOC", wsel)

    if (wnpv.wdcode == 100) {
      wsel = "Select a.* "
      wsel += "  From ddoct0 a with(nolock) "
      wsel += " Where a.iorg   = '" + wrow.iorg.trim() + "' "
      wsel += "   and a.idoct2 = '" + wrow.idoct2.trim() + "' "
      wsel += "   and a.idoc2  = '" + wrow.idoc2.trim() + "' "
      wsel += "   and a.idoct  = 'NPV' "
      wsel += "   and a.iuorg  = '" + wrow.iuorg.trim() + "' "
      println(wsel); flush()
      wnpv = getRow("DDOC", wsel)
    }

    if (wnpv.wdcode != 100) {

      wsel = " select d.zchar "
      wsel += " from ddoctx d WITH ( NOLOCK ) "
      wsel += " where d.zkent = " + wnpv.zk
      wsel += " AND d.zcomp = 'FN_trans' "
      println(wsel); flush()
      wient = getSQLValue(wsel).trim()

      if (wient == "") {

        wsel = " SELECT  a.ttext10 "
        wsel += " FROM    sinct0 a WITH ( NOLOCK ) "
        wsel += "         INNER JOIN ddoct0 b WITH ( NOLOCK ) ON a.iorg = b.iorg "
        wsel += "                                                AND a.ttext1 = b.idoct "
        wsel += "                                                AND a.ttext2 = b.idoc "
        wsel += "                                                AND a.c2 = '*' "
        wsel += " WHERE   b.zk = " + wnpv.zk + " "
        wsel += " and a.tipo = 'COTF' "
        println(wsel); flush()
        wient = getSQLValue(wsel).trim()

        if (wient == "") {
          wsel = " select b.ient "
          wsel += " from bentt0 b with(nolock) "
          wsel += "   inner join ddozt0 d with(nolock) "
          wsel += "   on d.zk = " + wnpv.zk + " "
          wsel += "   inner join bfrtt0 c with(nolock) "
          wsel += "   on c.zk = d.zkaux "
          wsel += "   where  b.ientt = 'FN' "
          wsel += "    and   b.ient  = c.ient "
          println(wsel); flush()
          wient = getSQLValue(wsel).trim()
        }
      }

      wsel = " SELECT  count(*) "
      wsel += " FROM    sinct0 a WITH ( NOLOCK ) "
      wsel += "         INNER JOIN ddoct0 b WITH ( NOLOCK ) ON a.iorg = b.iorg "
      wsel += "                                                AND a.ttext1 = b.idoct "
      wsel += "                                                AND a.ttext2 = b.idoc "
      wsel += "                                                AND a.c2 = '*' "
      wsel += " WHERE   b.zk = " + wnpv.zk + " "
      wsel += " and a.tipo = 'COTF' "
      println(wsel); flush()
      wfrt = getSQLNumber(wsel)

      //Tipo de Frete
      if (wfrt != 0 || wnpv.ctcf.trim() == "VX-WEB") {
        wccl = "CIF"
      } else if (wfrt == 0 || inList(wnpv.iixp2.trim(), ["01", "05"])) {
        wccl = "FOB"
      }
    }
  }

  wnent = ""

  if (wient != "") {
    wnent = getSQLValue("select nent from bentt0 with(nolock) where ientt = 'FN' and ient = '" + wient + "' ")
  }

  wdfform.ient = wient
  wdfform.nent = wnent
  wdfform.wplaca = ""
  wdfform.wuf = ""
  wdfform.wccl = wrow.ccl.trim()
  wdfform.wdinr = ""
  wdfform.wdidt = ""
  wdfform.wdilocal = ""
  wdfform.wdidtdes = ""
  wdfform.wdiexport = ""

  wsel = " SELECT  sum(b.qpeso * a.qpsr) qpeso "
  wsel += " FROM   ddolt0 a "
  wsel += "        INNER JOIN bpsrt0 b ON  a.iorg = b.iorg AND a.ipsr = b.ipsr AND a.ipsrlp = b.ipsrlp "
  wsel += " Where a.iorg    = '" + wrow.iorg.trim() + "' "
  wsel += "   and a.idoct   = '" + wrow.idoct.trim() + "' "
  wsel += "   and a.idoc    = '" + wrow.idoc.trim() + "' "
  wsel += "   and a.ientt   = '" + wrow.ientt.trim() + "' "
  wsel += "   and a.ient    = '" + wrow.ient.trim() + "' "
  wqpeso = getSQLNumber(wsel)

  wdfform.wpesol = wqpeso
  wdfform.wpesob = wqpeso

  expandForm(wdfform, false)

  println(wrow.iuorg + " --- " + wrow.idoct2); flush()

  if ((!inList(wrow.iuorg.trim(), ["F03", "F07", "F00"]) && wrow.idoct2.trim() != "NTS")) {
    cursor.commitWork()
    wdfform.showForm()
    cursor.beginWork()
    if (wdfform.getLastCmd().equals("CLOSEWINDOW")) { throwError("Operação Cancelada.") }
  }

  wqvol = wdfform.wqvol
  wespecie = wdfform.wespecie.trim()
  wpesol = wdfform.wpesol
  wpesob = wdfform.wpesob
  wnome = wdfform.nent.trim()
  wientttra = wdfform.ientt.trim()
  wienttra = wdfform.ient.trim()
  wplaca = wdfform.wplaca.trim()
  wuf = wdfform.wuf.trim()
  wccl = wdfform.wccl.trim()
  wdinr = wdfform.wdinr.trim()
  wdidt = wdfform.wdidt.trim()
  wdilocal = wdfform.wdilocal.trim()
  wdidtdes = wdfform.wdidtdes.trim()
  wdiexport = wdfform.wdiexport.trim()


  if (wrow.cr.trim() == "VX") {
    wcf = ""
    wflagfrete = false
    wdf = "FORA"
    if (wrow.cit.substring(0, 1) == "5") {
      wdf = "DENTRO"
    }

    wsel = " select a.qqcoef1 "
    wsel += "   from bctxt0 a with (nolock) "
    wsel += "  where a.ictx  = 'BCTX*FRT*" + wbent.testado.toUpperCase().trim() + "*" + wdf + "' "
    wsel += "    and a.ivalk = 'VALOR*LIMITE*CIF' "
    wvalorlimitecif = getSQLNumber(wsel)

    if (wrow.mvalor < wvalorlimitecif && wccl == "CIF") {
      wcf = "CIF"
      wflagfrete = true
    }

    if (wrow.mvalor >= wvalorlimitecif && wccl.trim() == "FOB") {
      wcf = "FOB"
      wflagfrete = true
    }

    if (wflagfrete) {
      //Pede Confirmação
      wmsg1 = "Pedidos para " + wdf + " do estado o valor limite para pedidos " + wcf + " é " + wvalorlimitecif
      wmsg2 = "Confirmar operação?"
      cursor.commitWork()
      i = showError("MIN-EEEE01Q", [wmsg1, wmsg2])
      cursor.beginWork()
      if (i != 0) {
        throwError("Operação Cancelada")
      }
    }
  }
}

//NPP.001652 PARAMETRIZAÇÃO VENDA DE CELULAR F03 E F07
