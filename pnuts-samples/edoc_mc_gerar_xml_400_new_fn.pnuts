          wvbcst = (wddol.mvalor - wddol.mvalim2) * 1.30
          wpICMSST = 30
          wvICMSST = wddolst
        }

        wlinha += "<modBC>3</modBC>"
        wlinha += "<vBC>" + formatNumber((wddol.mvalor - wddol.mvalim2), "N0.00") /*formatNumber((wddol.mvalor*wddol.qbfisc)+ wtotfrete,"N0.00")*/ + "</vBC>"
        wlinha += "<pICMS>" + formatNumber(wddol.pi, "N0.00") + "</pICMS>"
        wlinha += "<vICMS>" + formatNumber(wddol.mvalim + wtotfreteicms, "N0.00") + "</vICMS>"
        wlinha += "<modBCST>" + "4" + "</modBCST>"
        wlinha += "<vBCST>" + formatNumber(wvbcst, "N0.00") + "</vBCST>"
        wlinha += "<pICMSST>" + formatNumber(wpICMSST, "N0.00") + "</pICMSST>"
        wlinha += "<vICMSST>" + formatNumber(wvICMSST, "N0.00") + "</vICMSST>"

        wvBCUFDest = formatNumber((wddol.mvalor - wddol.mvalim2), "N0.00")
        wpICMSUFDest = formatNumber(wddol.pi, "N0.00")
