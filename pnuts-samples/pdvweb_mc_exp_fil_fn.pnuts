// Monta Lista Filiais
// pdvweb_mc_exp_fil_fn()

import("java.util.*")
import("java.util.HashMap")

lista = Vector()

// Carrega Empregados
wsel = " SELECT b.*, ngeos = (SELECT top 1 ngeos FROM bgeot0 with(nolock) WHERE igeob = b.testado AND ngeo = b.tmunicip AND igeoc = 'M') "
wsel += "   FROM bentt0 b with(nolock) "
wsel += "  WHERE b.ientt = '*' "
wsel += "    AND b.ient = 'TEC' "
wsel += "    AND b.iuorgt = 'UO' "
wsel += "    AND EXISTS(SELECT a.ivalk FROM bctxt0 a with (NOLOCK) WHERE a.ictx = 'WEBCHK*FILIAL' AND a.ivalk = b.iuorg AND a.cst = 'E0') "
wsel += "    AND b.cst = 'E0'  "
println(">>>>>>> VBENT: " + wsel); flush()
vbent = getRows("BENT", wsel)

foreach wbent(vbent.elements()) {

  map = HashMap()
  map.put("cc_fil", wbent.iuorg.trim())
  map.put("nm_fil", wbent.nent.trim())

  // Para atender o novo CNPJ Alfanumerico, trocamos a regex antiga "[^0-9]" pela nova "[^A-Z0-9]".
  map.put("cc_ins_fed", wbent.tidfisc.replaceAll("[^A-Z0-9]", ""))
  map.put("cc_reg_tri", "NORMAL")
  map.put("st_fil", wbent.cst.trim())
  map.put("tx_end_log", wbent.tmorad.trim())
  map.put("tx_end_num", wbent.tmail.trim())
  map.put("tx_end_cmp", wbent.tcend.trim())
  map.put("tx_end_bai", wbent.tlocal.trim())
  map.put("cc_end_cpt", wbent.icpt.replaceAll("[^0-9]", ""))
  map.put("cc_end_est", wbent.testado.trim())
  map.put("cc_end_mun_cod", wbent.ngeos.trim())
  map.put("tx_end_mun_nom", wbent.tmunicip.trim())
  map.put("cn_end_pai_cod", "1058")
  map.put("tx_end_pai_nom", "BRASIL")
  map.put("tx_end_tel", "")
  map.put("cc_ins_est", wbent.tidfisc2.replaceAll("[^0-9]", ""))
  map.put("cc_ins_mun", "")
  map.put("cc_cna_fis", "")

  lista.add(map)
}

return lista.toArray()


// EOF
