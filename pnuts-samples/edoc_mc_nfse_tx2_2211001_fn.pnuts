// wtipo indica se estamos trabalhando com edoc ou componente.
// se for edoc, então retornamos o tx2
if (wtipo == "edoc") {
  return wbody.toString()
} else {
  //Grava arquivo txt 
  wpath = System:: getProperty("user.dir") + "\\NFSe\\" + wrow.iuorg.trim() + "\\Tx2\\"
  wfilenameObj = wpath + int(wrow.idoc.substring(4)) + ".tx2"
  wfileObj = MFile(wfilenameObj)
  wfileObj.setBytes(wbody.toString().getBytes())
  wfileObj.saveFile(wfilenameObj)
}

