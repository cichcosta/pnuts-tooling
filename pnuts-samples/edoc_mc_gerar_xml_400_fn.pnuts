            wlinha += "<vBCST>" + formatNumber(wvbcicmsst, "N0.00") + "</vBCST>"
            if (wvbcicmsst > 0) {
              x_mc_update_extension_fn("n", "DDOLTX", wddol.zk, "hvbcst", wvbcicmsst);
            };
            wlinha += "<pICMSST>" + formatNumber((wmva * 100), "N0.00") + "</pICMSST>"
            wlinha += "<vICMSST>" + formatNumber(wvICMSST, "N0.00") + "</vICMSST>"

            wvBCUFDest = formatNumber(wvbc, "N0.00")
            wpICMSUFDest = formatNumber(wddol.pi, "N0.00")

            // Totais           
            wvbcst2 += wvbcicmsst
            wvst += wvICMSST

          }

        } else if (wcstprod == "90" && inList(wddol.cit.trim(), ["5403", "5405", "1202"]) && wbent2.testado.trim().toUpperCase() == "CE") {
          //CONTEMPLAR O DESTAQUE DO ICMS DE PRODUTOS DE INFORMÁTICA PARA CRÉDITO DO ADQUIRENTE - 2023-12-01 - LEMOS/MATEUS

          wlinha += "<modBC>3</modBC>"
          wlinha += "<vBC>" + formatNumber(wbc + wtotfrete, "N0.00") + "</vBC>"

          wlinha += "<pICMS>" + formatNumber(wddol.pi, "N0.00") + "</pICMS>"
          wlinha += "<vICMS>" + formatNumber(wddol.mvalim + wtotfreteicms, "N0.00") + "</vICMS>"

          wvBCUFDest = formatNumber(wbc + wtotfrete, "N0.00")
          wpICMSUFDest = formatNumber(wddol.pi, "N0.00")

        }

        //NPP.002005 - INCLUSÃO DE TAG NO XML DA NF-e E NCF-e
        //wbeneficio = getTparms("BCTX*CBNEF", "CBNEF*" + wuf_uo.trim() + "*" + wiuorg.trim() + "*" + wcuf.trim() + "*" + wcfpsrp.trim())
        wicmsdeson = 0
        if (wflagbeneficio) {
          wsel = " select qqcoef1 from bctxt0"
          wsel += " where ictx = 'BCTX*AUDI*UF'"
          wsel += " and   ivalk = '" + wuf_uo.trim() + "'"
          //wsel += " and '" + wrow.ddoces.trim() + "' between dini and dfim"
          wdifalUf = getSQLNumber(wsel)
          wimpb = (wddol.mvalor * (wdifalUf / 100))
          wicmsdeson = (wimpb - wddol.mvalim)
          wlinha += "<vICMSDeson>" + formatNumber(wicmsdeson, "N0.00") + "</vICMSDeson>"
          wlinha += "<motDesICMS>9</motDesICMS>"
        }

        wlinha += wtagICMSDeson
        wlinha += "</ICMS" + wcstprod.trim().substring(0, 1) + "0>"

        //202607 - NPP.002862 - REGRAS DE IMPOSTOS PARA VENDAS PARA SUFRAMA - NOTA FISCAL
        println("2 SUFRAMA >>>>>>>>>>>. wisencaosuframa.isentoicms: " + wisencaosuframa.isentoicms); flush()
        println("2 SUFRAMA >>>>>>>>>>>. wcstprod: " + wcstprod); flush()
        if (wmsufra > 0 && wisencaosuframa.isentoicms.trim() == "SIM" && inList(wcstprod.trim(), ["40"])) {

          //wlinha += "<motDesICMS>9</motDesICMS>"
        }

        //Totais impostos 
        //NPP.002005 - INCLUSÃO DE TAG NO XML DA NF-e E NCF-e
        wtoticmsdeson += wicmsdeson

        //Calculo imposto FECOP Piauí
        if (wFlagFecop) {
          pIcms = wddol.pi - 1
          vIcms = bIcms * (pIcms / 100)
          // ATENDIMENTO 402617 - GEOVANI VITORIANO - AJUSTE VALOR ICMS
          vIcms = formatNumber(vIcms, "N0.00");
          vIcms = toNumber(vIcms)
          // -----------------------------------------------------------
          wtoticms += round(vIcms, 2)
          wtotvbc += round(wbc + wtotfrete, 2)
        } else {
          wtoticms += round(wddol.mvalim, 2)
          wtotvbc += wbc
        }

      } else if ((wddol.cfpsr.trim() == "000") || (wflagicms && wddol.cfpsr.trim() != "010") && !inList(wrow.cit.trim(), ["6411"])) {
        wlinha += "<ICMS00>"
        if (wuser == "alopes") { showMessage("ICMS00 >>>> 3") }
        wlinha += "<orig>" + worigem + "</orig>"

        if (wtagICMSDeson.trim() != "") {
          wlinha += "<CST>40</CST>"
        } else {
          wlinha += "<CST>00</CST>"
        }
        wlinha += "<modBC>3</modBC>"
        if (wfinNFe == "2") {

          wlinha += "<vBC>" + formatNumber(round((wddol.mvalor * wddol.qbfisc), 2) + wtotfrete, "N0.00") + "</vBC>"
          wlinha += "<pICMS>" + formatNumber(wddol.pi, "N0.00") + "</pICMS>"
          wlinha += "<vICMS>" + formatNumber(wddol.mvalim + wtotfreteicms, "N0.00") + "</vICMS>"
          wvBCUFDest = formatNumber(round((wddol.mvalor * wddol.qbfisc), 2) + wtotfrete, "N0.00")
          wpICMSUFDest = formatNumber(wddol.pi, "N0.00")
          if (wuser == "scavalca") { showMessage("07 " + wpICMSUFDest) }
          wvbc = round((wddol.mvalor * wddol.qbfisc), 2)

        } else {

          if (wddol.cci == "NDB") {
            wlinha += "<vBC>" + formatNumber((wddol.mvalor * wddol.qbfisc) + wtotfrete, "N0.00") + "</vBC>"
            wlinha += "<pICMS>" + formatNumber(wddol.pi, "N0.00") + "</pICMS>"
            wlinha += "<vICMS>" + formatNumber(wddol.mvalim + wtotfreteicms, "N0.00") + "</vICMS>"

            wvBCUFDest = formatNumber((wddol.mvalor * wddol.qbfisc) + wtotfrete, "N0.00")
            wpICMSUFDest = formatNumber(wddol.pi, "N0.00")
            if (wuser == "scavalca") { showMessage("08 " + wpICMSUFDest) }

            wvbc = round((wddol.mvalor * wddol.qbfisc), 2)

            wvicms = ((((wddol.qpsr * wddol.mvalun) + wddol.mvalim2) * wddol.qbfisc) + wtotfrete)
            wvicms = round(((wvicms * wddol.pi) / 100), 2)

          } else {
            wvicms = (((wddol.qpsr * wddol.mvalun) * wddol.qbfisc) + wtotfrete)
            println(">>>>>>>>>>>>>>>>> ICMS  : " + wvicms + "prod " + wddol.ipsr); flush();
            //wvicms = ((wvicms * wddol.pi)/100)
            wvicms = round(((wvicms * wddol.pi) / 100), 2)
            //wvicms = formatNumber(wvicms + wtotfreteicms,"N0.00")  
            println(">>>>>>>>>>>>>>>>> ICMS FORMAR  : " + wvicms); flush();

            if (wddol.pi > 0) {
              wlinha += "<vBC>" + formatNumber(round(((wddol.qpsr * wddol.mvalun) * wddol.qbfisc), 2) + wtotfrete, "N0.00") + "</vBC>"
              wvBCUFDest = formatNumber(round(((wddol.qpsr * wddol.mvalun) * wddol.qbfisc), 2) + wtotfrete, "N0.00")
            } else {
              wlinha += "<vBC>" + formatNumber(0, "N0.00") + "</vBC>"
              wvBCUFDest = formatNumber(0, "N0.00")
            }
            wlinha += "<pICMS>" + formatNumber(wddol.pi, "N0.00") + "</pICMS>"
            //wlinha += "<vICMS>" + formatNumber(wddol.mvalim + wtotfreteicms,"N0.00") + "</vICMS>"
            wlinha += "<vICMS>" + formatNumber(wvicms + wtotfreteicms, "N0.00") + "</vICMS>"
            wpICMSUFDest = formatNumber(wddol.pi, "N0.00")
            if (wuser == "scavalca") { showMessage("09 " + wpICMSUFDest) }

            if (wddol.pi > 0) {
              wvbc = round((wddol.qpsr * wddol.mvalun * wddol.qbfisc), 2)
            } else {
              wvbc = 0
            }

          }
        }
        wlinha += wtagICMSDeson
        wlinha += "</ICMS00>"
        //wtoticms   += round(wddol.mvalim ,2)
        wtoticms += round(wvicms, 2)
        wtotvbc += wvbc
        if (wuser == "alopes") { showMessage("07 wtotvbc " + wtotvbc) }

        //************************************************************************************************************************************************************
        // 2014-02-25 - OZANA SPINOSA - Tratamento para nnf MA com produtos 060 (17%) deverão entrar na regra icms00 e sair impressas o ICMS na nota (Validado com op Tom)
      } else if ((wddol.cfpsrl.trim() == "060") && inList(wrow.idoct.trim(), ["NNF"]) && inList(wrow.iuorg.trim(), ["F08", "F10", "F22"]) && inList(wrow.cit.trim(), ["5102", "6102"])) {

        wlinha += "<ICMS00>"
        if (wuser == "alopes") { showMessage("ICMS00 >>>> 2") }
