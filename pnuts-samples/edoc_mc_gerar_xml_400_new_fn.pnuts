//edoc_mc_gerar_xml_400_fn(wrow)
// 2016-02-15 - OZANA SPINOSA - Tratamento produtos i03 saindo f03 sair na origem da nota "1" (Tom - help 135512 )
// 2016-03-15 - OZANA SPINOSA - Tratamento produtos cfop 3101 de importação

import("java.io.*")
import("br.com.unigex.nfe.NFe")

// Work
wNFe = NFe()
cursor = MConnection:: getMCursor()
wuser = MLogin:: getUser().trim()
wnodo = MLogin:: getUserNodo().trim()
wdatetime = x_mc_br_get_date_server_fn()
wdate = wdatetime.substring(0, 10)
wtime = wdatetime.substring(11, 19)
wflagicms = false
wflagavaria = false
wticms = false
wflagimp = false
wlinha = ""
wcrt = "3"
wvbcst2 = 0.00
wvst = 0.00
wserie = "1"
wzk = formatNumber(wrow.zk, "N00000000000000")
wversao = "4.00"
wexterior = false
wsite = false
wTotvFCPUFDest = 0.00
wTotvICMSUFDest = 0.00
wTotvICMSUFRemet = 0.00
wctcf = wrow.ctcf
wIEST = ""
wtemICMSEfetivo = true

// Dados do ICMS destacado (interestadual)
wvICMSUFDest = 0.00
wvICMSUFRemet = 0.00

// temporario
zglobals.WESPELHO = ""

// REGION
// Objetivo: Obter o identificador de local de destino da operaÃ§Ã£o.
// Pega o primeiro digito para saber o destino da operaÃ§Ã£o
wcit = wrow.cit.trim().substring(0, 1)

// Identificador de local de destino da operaÃ§Ã£o
// 1=OperaÃ§Ã£o interna;
// 2=OperaÃ§Ã£o interestadual;
// 3=OperaÃ§Ã£o com exterior.
widDest = "1"

// Se wcit for 2 ou 6, Ã© porque nas linhas contem CFOP de operaÃ§Ã£o interestadual
if (inList(wcit, ["2", "6"])) {
  widDest = "2"
  // Se wcit for 3 ou 7, Ã© porque nas linhas contem CFOP de operaÃ§Ã£o com exterior
} else if (inList(wcit, ["3", "7"])) {
  wexterior = true
}
// ENDREGION

// Obtem os dados do emitente da nota
wbent = edoc_mc_get_bent_fn("*", wrow.iorg.trim(), wrow.iuorgt.trim(), wrow.iuorg.trim())


// Obtem os dados do municipio do emitente
wbgeo = edoc_mc_get_bgeo_fn(wbent)

// Dados do emitente da nota
// Para atender o novo CNPJ Alfanumerico, trocamos a regex antiga "[^0-9]" pela nova "[^A-Z0-9]".
wCNPJ_C02 = wbent.tidfisc.trim().replaceAll("[^A-Z0-9]", "")
wxNome_C03 = wbent.nnomel.trim().replaceAll("&", "E")
xFant_C04 = wbent.nent.trim().replaceAll("&", "E")
wxLgr_C06 = wbent.tmorad.trim()
wnro_C07 = wbent.tmail.trim()
wxCpl_C08 = ""
wxBairro_C09 = wbent.tlocal.trim()
wcMun_C10 = wbgeo.wcidade.trim()
wxMun_C11 = wbent.tmunicip.trim()
wUF_C12 = wbent.testado.trim()
wCEP_C13 = formatNumber(wbent.icpt.replaceAll("[^0-9]", ""), "N00000000")
wcPais_C14 = wbgeo.wpais.trim()
wxPais_C15 = wbent.tpais.trim()
wfone_C16 = ""
wIE_C17 = wbent.tidfisc2.trim().replaceAll("[^0-9]", "")

if (inList(wUF_C12, ["CE"])) {
  wtemICMSEfetivo = false
}

// REGION
// Armazena os dados do destinatario da nota na variavel wbent2
wbent2 = edoc_mc_get_destinatario_fn(wrow)

// Obtem os dados do municipio do destinatario
wbgeo2 = edoc_mc_get_bgeo_fn(wbent2)

// Indicador da IE do DestinatÃ¡rio
// 1=Contribuinte ICMS (informar a IE do destinatÃ¡rio);
// 2=Contribuinte isento de InscriÃ§Ã£o no cadastro de Contribuintes do ICMS;
// 9=NÃ£o Contribuinte, que pode ou nÃ£o possuir InscriÃ§Ã£o Estadual no Cadastro de Contribuintes do ICMS.
windIEDest_E16a = "1"

// Verifica se no cadastro do destinatario o campo de IE estÃ¡ preenchido
// como ISENTO, se estiver entÃ£o atribui 0
if (inList(wbent2.tidfisc2.trim().toUpperCase(), ["ISENTO", ""]))
  windIEDest_E16a = "9";


// Variaveis do destiantario da nota
// Para atender o novo CNPJ Alfanumerico, trocamos a regex antiga "[^0-9]" pela nova "[^A-Z0-9]".
wCNPJ_E02 = wbent2.tidfisc.replaceAll("[^A-Z0-9]", "")
wCPF_E03 = wbent2.tidfisc.replaceAll("[^A-Z0-9]", "")
widEstrangeiro_E03a = ""
wxNome_E40 = wbent2.nnomel.trim().replaceAll("&", "E")
wxLgr_E06 = wbent2.tmorad.trim()
wnro_E07 = wbent2.tmail.trim()
wxCpl_E08 = wbent2.tcend.trim()
wxBairro_E09 = wbent2.tlocal.trim()
wcMun_E10 = wbgeo2.wcidade.trim()
wxMun_E11 = wbent2.tmunicip.trim()
wUF_E12 = wbent2.testado.trim().toUpperCase()
wCEP_E13 = formatNumber(wbent2.icpt.replaceAll("[^0-9]", ""), "N00000000")
wcPais_E14 = wbgeo2.wpais.trim()
wxPais_E15 = wbent2.tpais.trim()
wfone_E16 = wbent2.ttel.replaceAll("[^0-9]", "")
wIE_E17 = wbent2.tidfisc2.replaceAll("[^0-9]", "")
wemail_E19 = wbent2.temail.trim()

//**********************************
//Inserir Inscrção Estadual de Substituto de acordo com o estado.
if (inList(wrow.cit.trim(), ["6102", "6108"]) && windIEDest_E16a == "9") {
  wsel = " select nctx "
  wsel += " from bctxt0 with(nolock) "
  wsel += " where ictx = 'IEST*UF' "
  wsel += " and  ivalk = '" + wrow.iuorg.trim() + "' "
  wsel += " and   xord = '" + wUF_E12 + "' "
  wsel += " and   cst  = 'E0' "
  println(wsel); flush()
  wIEST = getSQLValue(wsel).replaceAll("[^0-9]", "")
}
//**********************************

if (!wemail_E19.matches("^[_A-Za-z0-9-+]+(.[_A-Za-z0-9-]+)@[A-Za-z0-9-]+(.[A-Za-z0-9]+)(.[A-Za-z]{2,})$")) {
  wemail_E19 = ""
}

// TODO: resolver essa gabis
if (wIE_E17 == "" || wCNPJ_E02.length() < 14) {
  windIEDest_E16a = "9"
}

//Condição especial para clientes pessoa fisica com Inscrição Estadual - Produtor Rural
if (wbent2.cnatt.trim() == "PR") {
  windIEDest_E16a = "1"
}

// Verifica se o nÃºmero da residencia do destinatario esta preenchida,
// se nao estiver aborta a operaÃ§Ã£o e avisa ao usuario
if (wnro_E07 == "") {
  throwError("OperaÃ§Ã£o Cancelada. Cadastre o nÃºmero do logradouro do destinatÃ¡rio.")
}

// Se o destinatario da nota for do exterior, atribui a aplica algumas regras as variaveis do destinatario
if (wexterior) {

  // O valor do cep passa a ser vazio
  wCEP_E13 = ""

  // Limpa a variavel do CNPJ do destinatario
  wCNPJ_E02 = ""

  // Limpa a variavel do CPF do destinatario
  wCPF_E03 = ""

} else {

  // Veririca se o CEP do destinatario estÃ¡ vazio
  if (wCEP_E13 == "") {
    wmsg = "OperaÃ§Ã£o Cancelada. Terceiro " + wrow.ientt.trim() + " - " + wrow.ient.trim() + ", com CEP invÃ¡lido."
    throwError(wmsg)
  }

  // Se a InscriÃ§Ã£o Estadual estiver vazia e o CNPJ/CPF > 11, 
  // exige o preenchimento da InscriÃ§Ã£o Estadual do destinatario
  if (wIE_E17 == "" && wCNPJ_E02.length() > 11) {
    wmsg = "OperaÃ§Ã£o Cancelada. InscriÃ§Ã£o Estadual invÃ¡lida para terceiro: "
    wmsg += wrow.ientt.trim() + " - " + wrow.ient.trim() + "."
    //throwError(wmsg)
  }

}

// Atribui flag para destacar o ICMS
if ((wrow.cit.trim().substring(0, 1) == "6") && (wCNPJ_E02.length() == 14) && (wbent2.tidfisc2.trim() != "ISENTO")) {
  wflagicms = true
}

// REGION
// Objetivo: Obter o tipo de emissÃ£o da nota fiscal e validar se o tipo informado Ã© valido
// Tipo de EmissÃ£o da NF-e
// 1=Normal
// 6=ContingÃªncia SVC-AN (SEFAZ Virtual de ContingÃªncia do AN);
// 7=ContingÃªncia SVC-RS (SEFAZ Virtual de ContingÃªncia do RS);
wtpEmis = getTparms("BCTX*PARAM*NFE", "TPEMIS*" + wrow.iorg.trim() + "*" + wrow.iuorg.trim())
if (!inList(wtpEmis.trim(), ["1", "6", "7"])) {
  throwError("Tipo de EmissÃ£o invÃ¡lido. Tipo vÃ¡lidos: 1 (produÃ§Ã£o), 2 (HomologaÃ§Ã£o)")
}
// ENDREGION


// REGION
// Objetivo: Obter a identificaÃ§Ã£o do ambiente de emissao das notas fiscais
//           e validar se a identificaÃ§Ã£o informada Ã© valida
// IdentificaÃ§Ã£o do Ambiente
// 1=ProduÃ§Ã£o; 
// 2=HomologaÃ§Ã£o
wtpAmb = getTparms("BCTX*PARAM*NFE", "AMBIENTE*" + wrow.iorg.trim() + "*" + wrow.iuorg.trim())
if (!inList(wtpAmb, ["1", "2"])) {
  throwError("Tipo de EmissÃ£o invÃ¡lido. Tipo vÃ¡lidos: 1 (produÃ§Ã£o), 2 (HomologaÃ§Ã£o)")
}
// ENDREGION

// REGION
// Objetivo: Obter a forma de pagamento.

// Indicador da forma de pagamento
// 0=Pagamento Ã  vista
// 1=Pagamento a prazo
// 2=Outros
windPag = "0"
if (wrow.cdocp.trim() != "00") { windPag = "1" }
// ENDREGION

// REGION
// Objetivo: Obter o tipo Tipo de OperaÃ§Ã£o.
// 0=Entrada;
// 1=SaÃ­da
wtpNF = "1"

if (wrow.cit.substring(0, 1) == "1" || wrow.cit.substring(0, 1) == "2" || inList(wrow.cit.trim().substring(0, 1), ["3"])) {
  wtpNF = "0"
}
//ENDREGION

// Obter a descriÃ§Ã£o da Natureza da OperaÃ§Ã£o
wnatOp = edoc_mc_get_natop_fn(wrow)

// CÃ³digo da UF do emitente do Documento Fiscal
wcUF = wbgeo.westado.trim()

// CÃ³digo NumÃ©rico que compÃµe a Chave de Acesso
wcNF = formatNumber(INT(wrow.idoc.trim().substring(4, wrow.idoc.trim().length())), "N00000000")

// CÃ³digo do Modelo do Documento Fiscal
wmod = "55"

// NÃºmero do Documento Fiscal
wnNF = INT(wrow.idoc.trim().substring(4, wrow.idoc.trim().length())).toString()

// CÃ³digo do municÃ­pio de ocorrÃªncia do fato gerador do ISSQN
wcMunFG = wbgeo.wcidade.trim()

// Formato do DANFE
// 1=DANFE normal, Retrato;
wtpImp = "1"

// Processo de emissÃ£o da NF-e
// 0=EmissÃ£o de NF-e com aplicativo do contribuinte;
// 1=EmissÃ£o de NF-e avulsa pelo Fisco;
// 2=EmissÃ£o de NF-e avulsa, pelo contribuinte com seu certificado digital, atravÃ©s do site do Fisco;
// 3=EmissÃ£o NF-e pelo contribuinte com aplicativo fornecido pelo Fisco.
wprocEmi = "0"

// VersÃ£o do Processo de emissÃ£o da NF-e
wverProc = "4.00"

// Data e hora de emissÃ£o do Documento Fiscal
wdhEmi = wrow.ddoc.trim() + "T" + wtime + "-03:00"

// Data e hora de SaÃ­da ou da Entrada da Mercadoria/Produto
wdhSaiEnt = wrow.ddoces.trim() + "T" + wtime + "-03:00"

// Indica operaÃ§Ã£o com Consumidor final
// 0=Normal;
// 1=Consumidor final;
windFinal = "1"

// flag para determinar se destaca os dados do ICMS de operaÃ§Ã£o 
// interestadual para pessoa fisica
wInterNaoContribuinte = false;
if (windFinal == "1" && wbent.testado.trim() != wbent2.testado.trim() && !wexterior) {
  widDest = "2" // operaÃ§Ã£o interestadual   
  if (wCNPJ_E02.length() < 14) {
    wInterNaoContribuinte = true;
  }
}

// Se o destinatario for do exterior informa 9 no
// indicador do IE do destinatÃ¡rio
if (wexterior) {
  windIEDest_E16a = "9";
  widDest = "3"
}

// Indicador de presenÃ§a do comprador no estabelecimento comercial no momento da operaÃ§Ã£o
// 0=NÃ£o se aplica (por exemplo, Nota Fiscal complementar ou de ajuste);
// 1=OperaÃ§Ã£o presencial;
// 2=OperaÃ§Ã£o nÃ£o presencial, pela Internet;
// 3=OperaÃ§Ã£o nÃ£o presencial, Teleatendimento;
// 4=NFC-e em operaÃ§Ã£o com entrega a domicÃ­lio;
// 9=OperaÃ§Ã£o nÃ£o presencial, outros.
windPres = "1"

// REGION
// Objetivo: Obter a finalidade da NF-e.
// Finalidade de emissÃ£o da NF-e
// 1=NF-e normal;
// 2=NF-e complementar;
// 3=NF-e de ajuste;
// 4=DevoluÃ§Ã£o de mercadoria.
wfinNFe = edoc_mc_get_finnfe_fn(wrow)
println("0 wfinNFe>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>" + wfinNFe); flush();
// ENDREGION

// REGION
// Objetivo: Calcular a chave da NF-e, obter o digito verificador
//           e salvar a chave nas extensoes
wAnoMes = wrow.ddoc.trim().substring(2, 4) + wrow.ddoc.trim().substring(5, 7)

// Faz o calculo da chave de acesso da nota fiscal
wId = wNFe.calculaChaveNFe200(wcUF, wAnoMes, wCNPJ_C02, wmod, wserie, wnNF, wtpEmis, wnNF)

// obtem o digito verificador da chave de acesso da nota fiscal
wcDV = wId.substring(wId.length() - 1, wId.length())

//salva a chave da nota nas extensoes
x_mc_update_extension_fn("c", "DDOCTX", wzk, "widnfe", wId)
// ENDREGION

cursor.commitWork()
cursor.beginWork()

// Numero fiscal gerado pelo VB e gravado nas extensÃ£o da nota
wlinha += "formato=xml" + EOL
wlinha += "<infNFe Id=" + char(34) + "NFe" + wId + char(34) + " versao=" + char(34) + wversao + char(34) + ">"
wlinha += "<ide>"
wlinha += "<cUF>" + wcUF + "</cUF>"
wlinha += "<cNF>" + wcNF + "</cNF>"
wlinha += "<natOp>" + wnatOp + "</natOp>"
wlinha += "<mod>" + wmod + "</mod>"
wlinha += "<serie>" + wserie + "</serie>"
wlinha += "<nNF>" + wnNF + "</nNF>"
wlinha += "<dhEmi>" + wdhEmi + "</dhEmi>"
wlinha += "<dhSaiEnt>" + wdhSaiEnt + "</dhSaiEnt>"
wlinha += "<tpNF>" + wtpNF + "</tpNF>"
wlinha += "<idDest>" + widDest + "</idDest>"
wlinha += "<cMunFG>" + wcMunFG + "</cMunFG>"
wlinha += "<tpImp>" + wtpImp + "</tpImp>"
wlinha += "<tpEmis>" + wtpEmis + "</tpEmis>"
wlinha += "<cDV>" + wcDV + "</cDV>"
wlinha += "<tpAmb>" + wtpAmb + "</tpAmb>"
wlinha += "<finNFe>" + wfinNFe + "</finNFe>"
wlinha += "<indFinal>" + windFinal + "</indFinal>"
wlinha += "<indPres>" + windPres + "</indPres>"
wlinha += "<procEmi>" + wprocEmi + "</procEmi>"
wlinha += "<verProc>" + wverProc + "</verProc>"

// Se o tipo de emissÃ£o for diferente de 1 (Normal),
// entÃ£o informa os dados referente a contingencia
if (wtpEmis != "1") {
  wxjust = getTparms("BCTX*PARAM*NFE", "NFE*CONT*SCAN*JUST").trim()
  wdhCont = getTparms("BCTX*PARAM*NFE", "NFE*CONT*SCAN*DATA*HORA").trim()
  wlinha += "<dhCont>" + wdhCont + "</dhCont>"
  wlinha += "<xJust>" + wxjust + "</xJust>"
}

// Se a finalidade da nota for diferente de 1 (Normal)
// entao informa os dados de referencia que pode ser a chave
// de uma nota de devoluÃ§Ã£o ou dados de uma cupom fiscal.
if (wfinNFe != "1" || inList(wrow.cit.trim(), ["5929", "6929"])) {

  wrefNFe = x_mc_select_extension_fn("c", "DDOCTX", wzk, "wrefnfe").trim()
  wnECF = x_mc_select_extension_fn("c", "DDOCTX", wzk, "wnecf").trim()
  wnCOO = x_mc_select_extension_fn("c", "DDOCTX", wzk, "wncoo").trim()

  wlinha += "<NFref>"

  // Se existe chave de nota de referencia, entao informa a chave da nota,
  // senÃ£o, informa os dados do cupom fiscal
  if (wrefNFe != "") {
    wlinha += "<refNFe>" + wrefNFe + "</refNFe>"
  } else {
    if (wnECF == "" || wnCOO == "") {
      wmsg = "A finalidade do documento requer a chave da NF-e ou "
      wmsg += "dados de referÃªncia do cupom fiscal (NÃºmero do ECF e COO) "
      wmsg += "informados nas extensÃµes."
      throwError(wmsg)
    }
    wlinha += "<refECF>"
    wlinha += "<mod>2D</mod>"
    wlinha += "<nECF>" + wnECF + "</nECF>"
    wlinha += "<nCOO>" + wnCOO + "</nCOO>"
    wlinha += "</refECF>"
  }
  wlinha += "</NFref>"
}

wlinha += "</ide>"

// Monta os dados do emitente da nota fiscal
wlinha += "<emit>"
wlinha += "<CNPJ>" + wCNPJ_C02 + "</CNPJ>"
wlinha += "<xNome>" + wxNome_C03 + "</xNome>"
wlinha += "<xFant>" + xFant_C04 + "</xFant>"
wlinha += "<enderEmit>"
wlinha += "<xLgr>" + wxLgr_C06 + "</xLgr>"
wlinha += "<nro>" + wnro_C07 + "</nro>"
wlinha += "<xBairro>" + wxBairro_C09 + "</xBairro>"
wlinha += "<cMun>" + wcMun_C10 + "</cMun>"
wlinha += "<xMun>" + wxMun_C11 + "</xMun>"
wlinha += "<UF>" + wUF_C12 + "</UF>"
wlinha += "<CEP>" + wCEP_C13 + "</CEP>"
wlinha += "<cPais>" + wcPais_C14 + "</cPais>"
wlinha += "<xPais>" + wxPais_C15 + "</xPais>"
wlinha += "</enderEmit>"
wlinha += "<IE>" + wIE_C17 + "</IE>"

if (wIEST.trim() != "") {
  wlinha += "<IEST>" + wIEST + "</IEST>"
}

wlinha += "<CRT>" + wcrt + "</CRT>"
wlinha += "</emit>"

// Dados do destinatario da nota
wlinha += "<dest>"

wwcnpj = ""//"<CNPJ></CNPJ>"
wwcep = ""
wwcpl = ""
wwie = ""
wwemail = ""

// Se o cliente nÃ£o for do exterior, preenche os campos do CNPJ
// ou CPF com os dados do cliente
if (!wexterior) {
  wwcnpj = "<CNPJ>" + wCNPJ_E02 + "</CNPJ>"
  if (wCPF_E03.length() != 14) {
    wwcnpj = "<CPF>" + wCPF_E03 + "</CPF>"
  }
}

// Se o cliente nÃ£o for do exterior, informa o CEP
if (!wexterior) {
  wwcep = "<CEP>" + wCEP_E13 + "</CEP>"
}

// Se existir complemento do endereÃ§o do cliente,
// informa-o no xml
if (wxCpl_E08 != "") {
  wwcpl = "<xCpl>" + wxCpl_E08 + "</xCpl>"
}

// Se o Indicador da IE do DestinatÃ¡rio for 1, informa a IE do destinatario
if (windIEDest_E16a == "1")
  wwie = "<IE>" + wIE_E17 + "</IE>";


// Se o email do destinatario for informado, entao informa no XML
if (wemail_E19 != "")
  wwemail = "<email>" + wemail_E19 + "</email>"

wwidEstrangeiro = ""
if (wexterior)
  wwidEstrangeiro = "<idEstrangeiro>" + widEstrangeiro_E03a + "</idEstrangeiro>"

// Se o ambiente for 1 (ProduÃ§Ã£o), atribui aos campos os valores
// reais do destinatario da nota fiscal


if (wtpAmb == "1") {

  // Monta o XML com os dados do destinatario
  wlinha += wwcnpj
  wlinha += wwidEstrangeiro
  wlinha += "<xNome>" + wxNome_E40 + "</xNome>"
  wlinha += "<enderDest>"
  wlinha += "<xLgr>" + wxLgr_E06 + "</xLgr>"
  wlinha += "<nro>" + wnro_E07 + "</nro>"
  wlinha += wwcpl
  wlinha += "<xBairro>" + wxBairro_E09 + "</xBairro>"
  wlinha += "<cMun>" + wcMun_E10 + "</cMun>"
  wlinha += "<xMun>" + wxMun_E11 + "</xMun>"
  wlinha += "<UF>" + wUF_E12 + "</UF>"
  wlinha += wwcep
  wlinha += "<cPais>" + wcPais_E14 + "</cPais>"
  wlinha += "<xPais>" + wxPais_E15 + "</xPais>"
  if (wfone_E16 != "" && wfone_E16.length() >= 10) {
    wlinha += "<fone>" + wfone_E16 + "</fone>"
  }
  wlinha += "</enderDest>"
  wlinha += "<indIEDest>" + windIEDest_E16a + "</indIEDest>"
  wlinha += wwie
  wlinha += wwemail

} else {

  wlinha += wwcnpj
  wlinha += wwidEstrangeiro
  wlinha += "<xNome>NF-E EMITIDA EM AMBIENTE DE HOMOLOGACAO - SEM VALOR FISCAL</xNome>"
  wlinha += "<enderDest>"
  wlinha += "<xLgr>" + wxLgr_E06 + "</xLgr>"
  wlinha += "<nro>" + wnro_E07 + "</nro>"
  wlinha += wwcpl
  wlinha += "<xBairro>" + wxBairro_E09 + "</xBairro>"
  wlinha += "<cMun>" + wcMun_E10 + "</cMun>"
  wlinha += "<xMun>" + wxMun_E11 + "</xMun>"
  wlinha += "<UF>" + wUF_E12 + "</UF>"
  wlinha += wwcep
  wlinha += "<cPais>" + wcPais_E14 + "</cPais>"
  wlinha += "<xPais>" + wxPais_E15 + "</xPais>"
  wlinha += "</enderDest>"
  wlinha += "<indIEDest>" + windIEDest_E16a + "</indIEDest>"
  wlinha += wwie
  wlinha += wwemail

}

wlinha += "</dest>"

// Totalizadores das linhas
wcont = 1
wtotvbc = 0.00
wtoticms = 0.00
wtotprod = 0.00
wtotpis = 0.00
wtotcofins = 0.00
wtotipi = 0.00
wtotmvaldc = 0.00
wtotii = 0.00
wtotdespadu = 0.00
wtotfrete = 0.00
wtotfreteicms = 0.00

wsel = "Select isnull(sum(a.mvalor),0) as mvalor, isnull(sum(a.mvalim),0) as mvalim "
wsel += "  From ddolt0 a, bpsrt0 b  "
wsel += " Where a.iorg    = '" + wrow.iorg.trim() + "' "
wsel += "   and a.idoct   = '" + wrow.idoct.trim() + "' "
