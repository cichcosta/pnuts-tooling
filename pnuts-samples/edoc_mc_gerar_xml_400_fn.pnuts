      }
      //TRATATIVA DA TAG wpICMSInter Quando icms for 4
      //if (wcuf == "F" && wcr == "VX") {
      //    println("Imposto ICMS Inter > > " + wpICMSInter); flush()
      //    wpICMSInter = formatNumber(wddol.pi, "N0.00")
      //
      //}

      if (inList(wrow.cit.trim(), ["1202", "2202"])) {

        //Busca NVD da NNF
        wsel = "Select a.iorg,a.idoct2,a.idoc2 "
