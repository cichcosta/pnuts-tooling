      wsel += "     OR ivalk = '" + wncm.trim().substring(0, 5) + "' "
      wsel += "     OR ivalk = '" + wncm.trim().substring(0, 6) + "' "
      wsel += "     OR ivalk = '" + wncm.trim().substring(0, 7) + "' "
      wsel += "       ) ORDER BY ivalk desc "
      wcest = getSQLValue(wsel)
      println("CEST:>>>" + wsel); flush()
      wcest = wcest
    }
    println("CEST   :>>>" + wcest); flush()
  }

  wlinha += "<NCM>" + wddol.cstat2.trim() + "</NCM>"
  wlinha += "<CEST>" + wcest.trim() + "</CEST>"
