// Interface Aplicação
function getMRow(went) {
  MMData::getMRow(went)
}

function getMRow(row, wcsel) {
  wv = getMRows(row, wcsel, 1)
  if (wv != null && wv.size() > 0) {
    return wv.elementAt(0)
  } else {
    return null
  }
}

function getMRows(row, wcsel) {
  getMRows(row, wcsel, -1)
}

function getMRows(row, wcsel, n) {
  if (row instanceof String) {
      row = getMRow(row)
  }
  MUtil::getRows(row, wcsel, n)
}

function changeCurrency(wvrows, wcurrency) {
   foreach wrow (wvrows.elements()) {
      wrow.changeCurrency(wcurrency)
   }
}

function expandRow(wrow) {
   MUtil::expand(wrow);
}
function expandRow(wrow, wfield) {
   MUtil::expand(wrow, wfield);
}

function expandForm(wform) {
   MUtil::expandForm(wform, false);
}
function expandForm(wform, withErrors) {
   MUtil::expandForm(wform, withErrors);
}
function expandForm(wform, withErrors, wfields) {
   if (wfields instanceof String) {
      whash = Hashtable()
      whash.put(wfields, wfields)
   } else if (wfields.getClass().isArray()) {
      whash = Hashtable()
      foreach wfield (wfields) {
         whash.put(wfield, wfield)
      }
   } else if (wfields instanceof Vector) {
      whash = Hashtable()
      foreach wfield (wfields.elements()) {
         whash.put(wfield, wfield)
      }
   } else {
      whash = wfields
   }
   MUtil::expandForm(wform, withErrors, whash);
}


