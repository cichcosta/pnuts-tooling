      } else if (wddol.cfpsr.trim() == "010" || inList(wrow.cit.trim(), ["6202", "5411", "6411", "5949"])) {
        wpmvast = 0.00
        wpredbcts = 0.00
        wvbcst = 0.00
        wpICMSST = 0.00
        wvICMSST = 0.00

        if ((inList(wrow.cit.trim(), ["6202", "5411", "6411", "5949"]))) {
          wdfform = MForm:: getDialogForm(m, "DDOC0NNFDEV", "ME", "Devolução", 3)
          wdfform.setEnt(m.getEnt())
          wdfform.setRow(getMRow("DDOC"))
