      //wbody.append(wlinha)         
    } else {
      wlinha += "<xProd>" + padRight(x_mc_retira_acento_fn(wddol.npsr.trim()).trim(), 120).substring(0, 120).trim() + "</xProd>"
      //wbody.append(wlinha)
    }
  }

  if (wddol.cstat2.trim() == "") {
    throwError("OperaÃ§Ã£o Cancelada. Produto: " + wddol.ipsr.trim() + ", sem NCM cadastrado.")
  }

  wcest = "000000"
  wncm = wddol.cstat2
  wncm = wncm.replace(".", "")
  println("NCM :" + wncm + " PROD: " + wddol.ipsr); flush();
  if (!inList(wncm.trim(), ["", "0", null]) && (wncm.trim().length() >= 8)) {
    println("Produto>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>> :" + wddol.ipsr + "  NCM  " + wddol.cstat2); flush();
    wsel = " SELECT tparms FROM bctxt0 WHERE ictx = 'BCTX*CEST*NCM' "
    wsel += "   AND ivalk = '" + wncm.trim() + "' "
    wcest1 = getRow(wsel)
    println("CEST:>>>" + wsel); flush()
    if (wcest1.wdcode != 100) {
      println("CEST com 8 dig  :>>>" + wcest1.tparms); flush()
      wcest = wcest1.tparms
    } else {
