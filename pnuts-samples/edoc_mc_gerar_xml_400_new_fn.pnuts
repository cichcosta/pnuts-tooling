    wsel += " and   ivalk = '" + wbent2.testado.trim() + "'"
    wdifalUf = getSQLNumber(wsel)

    wvaldifaliq = wdifalUf - toNumber(wpICMSUFDest)

    if (wvaldifaliq < 0) wvaldifaliq = wvaldifaliq * -1

    if (wuser == "scavalca") { showMessage("Base " + wvBCUFDest + " * " + wvaldifaliq + "/100 " + "percentual partilha  " + wpICMSInterPart) }

    println(">>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>> - wvBCUFDest: " + wvBCUFDest + " wvaldifaliq: " + wvaldifaliq + " wpICMSInterPart: " + wpICMSInterPart + " wpICMSUFDest: " + wpICMSUFDest + " wpICMSInter: " + wpICMSInter); flush();
    wvICMSUFDest = (toNumber(wvBCUFDest) * ((wvaldifaliq) / 100)) * (wpICMSInterPart / 100)// Valor do ICMS Interestadual para a UF dedestino
    if (MLogin:: getUser() == "rdsilva") { showMessage("wvICMSUFDest   " + wvICMSUFDest) }
    wvICMSUFRemet = (toNumber(wvBCUFDest) * ((wvaldifaliq) / 100)) * ((100.00 - wpICMSInterPart) / 100) // Valor do ICMS Interestadual para aUF do remetente
    wvICMSUFDest = round(wvICMSUFDest, 2)
    println(">>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>> -  wvICMSUFDest: " + wvICMSUFDest); flush();
    println(">>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>22222222222222222222222222222222 -  wpICMSUFDest: " + wpICMSUFDest); flush();
    wvICMSUFRemet = round(wvICMSUFRemet, 2)


    wlinha += "<ICMSUFDest>"
    wlinha += "<vBCUFDest>" + formatNumber(wvBCUFDest, "N0.00") + "</vBCUFDest>"
    wlinha += "<pFCPUFDest>" + formatNumber(wpFCPUFDest, "N0.00") + "</pFCPUFDest>"
    wlinha += "<pICMSUFDest>" + formatNumber(wpICMSUFDest, "N0.00") + "</pICMSUFDest>"
    wlinha += "<pICMSInter>" + formatNumber(wpICMSInter, "N0.00") + "</pICMSInter>"
    wlinha += "<pICMSInterPart>" + formatNumber(wpICMSInterPart, "N0.00") + "</pICMSInterPart>"
    wlinha += "<vFCPUFDest>" + formatNumber(wvFCPUFDest, "N0.00") + "</vFCPUFDest>"
    wlinha += "<vICMSUFDest>" + formatNumber(wvICMSUFDest, "N0.00") + "</vICMSUFDest>"
    wlinha += "<vICMSUFRemet>" + formatNumber(wvICMSUFRemet, "N0.00") + "</vICMSUFRemet>"
    wlinha += "</ICMSUFDest>"

    wTotvFCPUFDest += round(wvFCPUFDest, 2)
    if (wuser == "scavalca") { showMessage("Valor " + wvICMSUFDest) }
    wTotvICMSUFDest += round(wvICMSUFDest, 2)
    wTotvICMSUFRemet += round(wvICMSUFRemet, 2)
  }

  wlinha += "</imposto>"

