          wdfform.wpredbcst = 0.00
          wdfform.wvbcst = 0.00
          wdfform.wpicmsst = 0.00
          wdfform.wvicmsst = 0.00
          expandForm(wdfform, false)
          cursor.commitWork()
          wdfform.showForm()
          cursor.beginWork()
          if (wdfform.getLastCmd().equals("CLOSEWINDOW")) { throwError("Operação Cancelada.") }
          wpMVAST = wdfform.wpmvast
          wpRedBCST = wdfform.wpredbcst
          wvbcst = wdfform.wvbcst
          wpICMSST = wdfform.wpicmsst
          wvICMSST = wdfform.wvicmsst
        }

        if (wuser == "alopes") { showMessage("<ICMS10> - 02") }
        wlinha += "<ICMS10>"
