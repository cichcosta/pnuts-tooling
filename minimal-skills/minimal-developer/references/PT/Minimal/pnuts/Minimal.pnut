function getMHashtable(wadd) {
   if (!(wadd instanceof Boolean)) {
      getMHashtable(wadd, true, false);
   } else {
      MHashtable(wadd, false)
   }
}
function getMHashtable(wadd, wexists) {
   MHashtable(wadd, wexists)
}
function getMHashtable(wobj, wadd, wexists) {
   hash = MHashtable(wobj)
   hash.setAllowChange(wadd)
   hash.setAllowExists(wexists)
   hash
}

