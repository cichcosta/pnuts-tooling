wfnfrtflag = false
worigemautomatismo = ""

wvBC_W19 = 0.00

//REFORMA TRIBUTARIA
wvBCIBSCBSt = 0.00; wvIBSt = 0.00;
wvtIBSUF = 0.00; wvtIBSMun = 0.00; wvtCBS = 0.00;


//FECOP PI
wvBCFCP = 0
wvFCP = 0
