          wlinha += "<pICMS>" + formatNumber(wddol.pi, "N0.00") + "</pICMS>"
          wlinha += "<vICMS>" + formatNumber(wddol.mvalim + wtotfreteicms, "N0.00") + "</vICMS>"
          wvbc = (wddol.mvalor * wddol.qbfisc)

          wvBCUFDest = formatNumber((wddol.mvalor * wddol.qbfisc) + wtotfrete, "N0.00")
