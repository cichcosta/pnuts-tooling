  wpIBSUF = 0.00; wvIBSUF = 0.00;
  wpIBSMun = 0.00; wvIBSMun = 0.00;
  wpCBS = 0.00; wvCBS = 0.00;
  wvIBS = 0.00;
  wzkddol = formatNumber(wddol.zk, "N00000000000000")

  //Carrega informacoes que serão impressas na nota fiscal
  wsel = "select a.* "
