//wsel += "	  and a.ttext2 = '"+wrow.ctcf.trim()+"' ";
wsel += "	  and a.cst = 'E0' ";
wufopint = getRow("BENT", wsel);
println("BCTX*UF*OPEINT*NC2:>>>" + wsel); flush();
if ((wufopint.wdcode != 100) && (windIEDest_E16a == "9")) {

  wsel = "SELECT a.tparms ";
  wsel += "FROM bctxt0 a with(nolock) ";
  wsel += "WHERE a.ictx = 'BCTX*UF*OPEINT*MSG' ";
  wsel += "  and a.ivalk = '" + wbent2.testado.trim() + "' ";
  wsel += "	 and a.cst = 'E0' ";
  wufopint = getRow("BENT", wsel);
  println("BCTX*UF*OPEINT*MSG:>>>" + wsel); flush();
  if (wufopint.wdcode != 100) {
    wobs += ". " + wufopint.tparms.trim();
  }

};
//E2

if (wobs.trim() != "") {
  wlinha += "<infAdic>"
  //wlinha += "<infAdFisco></infAdFisco>"
  wlinha += "<infCpl>" + wobs.trim() + "</infCpl>"
  wlinha += "</infAdic>"
}

if (wrow.cit.trim() == "7949") {

  wlinha += "<exporta>"
  wlinha += "<UFSaidaPais>" + wuf + "</UFSaidaPais>"
  wlinha += "<xLocExporta>" + wdilocal + "</xLocExporta>"
  wlinha += "</exporta>"
  //wbody.append(wlinha)

  if ((wuf.trim() == "") || (wdilocal.trim() == "")) { throwError("Favor informar a UF e Local de Embarque") }

}

// define o local de impressão
wlinha += "<Manager>"
wlinha += "<PrintManagerRemoto>" + edoc_mc_get_ip_fn() + ":8081</PrintManagerRemoto>"
wlinha += "<Impressora>" + edoc_mc_get_impressora_fn(wrow) + "</Impressora>"
if ((x_mc_get_access3_fn("DDOC0-0415", "")) && (wrow.idoct2.trim() == "NPV")) {
  wlinha += "<QTDCopias>2</QTDCopias>"
}
wlinha += "</Manager>"

wlinha += "</infNFe>"

cursor.commitWork()
cursor.beginWork()

println("XML >>>> " + wlinha); flush()

return wlinha.replaceAll("\\n", " ")
// EOF
