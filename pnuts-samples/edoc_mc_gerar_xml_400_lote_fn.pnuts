//if (wrow.ctcf.trim() != "5152C") { wsel += "   and a.qpsr    > 0 " }
if ((wrow.ctcf.trim() == "5152C") || (wvendaicmsst > 0)) {
  wsel += "   and a.mvalor > 0.02"
} else { wsel += "   and a.qpsr    > 0 " }

wsel += "   and b.ipst    <> 'SRV' "
wsel += "   and a.iorg    = b.iorg "
wsel += "   and a.ipsr    = b.ipsr "

//TICKET 13722 - CAMILA MOURA - 03/01/2019
if ((wrow.ctcf.trim() == "5152C") || wvendaicmsst > 0) {
  wsel += " order by a.idol, a.ipsr, a.qpsr, a.iixp "
} else {
