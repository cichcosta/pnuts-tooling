function getRow(wcsel) {
   getRow(null, wcsel)
}
function getRow(wname, wcsel) {
   getRow(wname, wcsel, null)
}
function getRow(wname, wcsel, mcurs) {
   if (wname == null) {
      wname = "ROW"
   }
   _rows = getRows(wname, wcsel, 1, mcurs);
   if (_rows.isEmpty()) {
      _row = MRecord(wname + " - NOT-FOUND")
      _row.put("wdcode", SQL_NOTFOUND)
   } else {
      _row = _rows.firstElement()
      _row.put("wdcode", SQL_OK)
   }
   _rows.close()
   return _row
}

function getRows(name, sql) {
   return MResultSet(name, sql)
}
function getRows(name, sql, countORmcurs) {
   if (countORmcurs instanceof MCursor) {
      return getRows(name, sql, -1, countORmcurs)
   } else {
      return MResultSet(name, sql, countORmcurs)
   }
}
function getRows(name, sql, count, mcurs) {
   if (mcurs == null) {
      return MResultSet(name, sql, count)
   } else {
      return MResultSet(mcurs, name, sql, count)
   }
}

function executeQuery(wcsel) {
   executeQuery(null, wcsel)
}

function executeQuery(wname, wcsel) {
   wmcurs = MConnection::getMCursor()
   wmcurs.execQuery(wname, wcsel)
   if (wmcurs.getWdcode() == SQL_OK) {
      wtbl = wmcurs.getRecord()
      wtbl.setAllowExists(false)
   } else {
      wtbl = getMHashtable()
      if (wname != null) wtbl.setName(wname + " - NOT-FOUND")
   }
   wmcurs.close()
   wtbl.put("wdcode", wmcurs.getWdcode());
   wtbl
}


function executeVectorQuery(wcsel) {
   executeVectorQuery(wcsel, -1)
}
function executeVectorQuery(wpar1, wpar2) {
   if (wpar2 instanceof Number) {
      return executeVectorQuery(null, wpar1, wpar2)
   } else {
      return executeVectorQuery(wpar1, wpar2, -1)
   }
}

function executeVectorQuery(wname, wcsel, wnum) {
   println("O método executeVectorQuery() está desactualizado. Utilizar o método getRows().");flush()
   mcurs = MConnection::getMCursor()
   mcurs.execQuery(wname, wcsel)
   if (mcurs.getWdcode() == SQL_OK) {
      wvec = mcurs.getXRecords(wnum)
      foreach wvecrow (wvec.elements()) wvecrow.setAllowExists(false)
   } else {
      wvec = Vector()
   }
   mcurs.close()
   wvec
}



function executeObjectQuery(wcsel) {
   executeObjectQuery(null, wcsel)
}
function executeObjectQuery(wname, wcsel) {
   println("O método executeObjectQuery() está desactualizado. Utilizar o método getRow().");flush()
   wmcurs = MConnection::getMCursor()
   wmcurs.execQuery(wname, wcsel)
   if (wmcurs.getWdcode() == SQL_OK) {
      wtbl = wmcurs.getObjectRecord()
      wtbl.setAllowExists(false)
   } else {
      wtbl = getMHashtable()
      if (wname != null) wtbl.setName(wname + " - NOT-FOUND")
   }
   wmcurs.close()
   wtbl.put("wdcode", wmcurs.getWdcode());
   wtbl
}


function executeObjectVectorQuery(wcsel) {
