wsel = "Select a.idol, a.ipsr, a.qpsr, a.mvalun, a.mvalim2, a.mvalor, a.qbfisc, a.pi, a.pi2, a.ndoc, a.ci, a.cci, a.iuorg, a.iuorg2, b.ipst,a.iixp,a.zk, "
wsel += "       a.mvalim, a.cit,  a.mvaldc, a.cfpsr2, b.cstat2, b.npsr, b.cur, b.cfpsr, b.cfpsr2 as wimpipi, a.irct1,a.cfpsr as cfpsrl, a.cr, a.ctcf,a.idoct, "
wsel += "	cbarras = (select top 1 ipsr2 from bpsst0 where iorg = 'TEC' and ipsr = a.ipsr and cpss in ('SI','EA') order by zk desc) "
wsel += "  From ddolt0 a, bpsrt0 b  "
wsel += " Where a.iorg    = '" + wrow.iorg.trim() + "' "
wsel += "   and a.idoct   = '" + wrow.idoct.trim() + "' "
wsel += "   and a.idoc    = '" + wrow.idoc.trim() + "' "
wsel += "   and a.ientt   = '" + wrow.ientt.trim() + "' "
wsel += "   and a.ient    = '" + wrow.ient.trim() + "' "
