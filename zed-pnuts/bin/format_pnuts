#!/usr/bin/env bash
# Pnuts Formatter Wrapper for Linux & macOS
DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
UNAME_S="$(uname -s)"
UNAME_M="$(uname -m)"

# 1. Prefer native standalone runner (fast, zero dependencies)
if [ "$UNAME_S" = "Linux" ] && [ -x "$DIR/pnuts-format" ]; then
    exec "$DIR/pnuts-format" "$@"
elif [ "$UNAME_S" = "Darwin" ]; then
    if [ "$UNAME_M" = "arm64" ] && [ -x "$DIR/pnuts-format-darwin-arm64" ]; then
        exec "$DIR/pnuts-format-darwin-arm64" "$@"
    elif [ -x "$DIR/pnuts-format-darwin-x64" ]; then
        exec "$DIR/pnuts-format-darwin-x64" "$@"
    fi
fi

# 2. Fallback to format_pnuts.py if python3 is available
if command -v python3 >/dev/null 2>&1; then
    if [ -f "$DIR/format_pnuts.py" ]; then
        exec python3 "$DIR/format_pnuts.py" "$@"
    elif [ -f "$DIR/../../scripts/format_pnuts.py" ]; then
        exec python3 "$DIR/../../scripts/format_pnuts.py" "$@"
    fi
fi

# 3. Fallback to pnuts-format if executable
if [ -x "$DIR/pnuts-format" ]; then
    exec "$DIR/pnuts-format" "$@"
fi

echo "Pnuts formatter: neither pnuts-format binary nor python3 was found in $DIR" >&2
exit 1
