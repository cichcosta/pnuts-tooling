          //************************************************************************************************************************************************************ 
          //FIM - TICKET 13722 - CAMILA MOURA - 02/10/2018
        } else if (inList(wddol.cit.trim(), ["5409", "5152"]) && wbent.testado.trim().toUpperCase() == "PE") {
