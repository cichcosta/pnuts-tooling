      wcfisc = wbpsr.cep1

      //Verifica se o NCM esta cadastrado na tabela do Cest
      wcadcest = getTparms("BCTX*CEST*NCM", wcstat2.trim())
      if (wcadcest == "") { throwError(" NCM nÃ£o encontrado na tabela Cest BCTX*CEST*NCM:  " + wddol.ipsr + " NCM: " + wcstat2.trim()) }

      //Carrega informaÃ§Ãµes que serÃ£o impressas na nota fiscal
      wsel = "select * "
      wsel += "  from btrit0 "
      wsel += " where itri     = '" + witri + "' "
      wsel += "   and cr       = '" + wcr + "' "
      wsel += "   and ctcf     = '" + wctcf + "' "
      wsel += "   and cuf      = '" + wcuf + "' "
      wsel += "   and ccontrib = '" + wcontrib + "' "
      wsel += "   and ccl      = '" + wwccl + "' "
      wsel += "   and cfpsrp   = '" + wcfpsrp + "' "
      wsel += "   and qbfiscp  =  " + wqbfiscp + " "
      if (inList(wrow.iuorg.trim(), ["F03"]) && wddol.iuorg2.trim() == "I03" && wddol.mvalim2 > 0.0000) {
        wsel += "   and iuorg2 =  'I03' "
      } else {
        wsel += "   and iuorg2 <> 'I03' "
      }
      wsel += "   and cstat2  in ('*','" + wcstat2 + "') "
      /*
     if(wcstat2.trim() != "*"){
     wsel += "   and cstat2  in ('" + wcstat2 + "') "
     }else{
     wsel += "   and cstat2  in ('*','" + wcstat2 + "') "
     }
      */
      wsel += " order by cstat2 DESC "
      println(wsel); flush()
      wbtri = getRow("BTRI", wsel)
      if (wbtri.wdcode == 100) {
        throwError("Código de Automatização Fiscal não Encontrado: " + witri + " " + wddol.cr + " " + wddol.ctcf + " " + wcuf + " " + wcontrib + " " + wwccl + " " + wcfpsrp + " " + wcstat2 + " " + wqbfiscp + "\nContactar setor de Contabilide.")
      }
      wci = wbtri.ci.trim()
      wciprint = wbtri.ciprint.trim()

      if (wciprint != "" && wciprint != wci) {
        wpi = getSQLNumber("select qqcoef1 from bctxt0 where ictx = 'BCTX*CI' and ivalk = '" + wciprint + "'")
        wddol.pi = wpi
        wddol.mvalim = round(((wddol.qpsr * wddol.mvalun) * (wpi / 100)), 2) //formatNumber(mvalun,"N#,##0.00",12)
      }

      //Parametros para montagem da TAG de ICMS   
      wcstprod = wbtri.cfpsr.trim().substring(1, 3)
      //if(MLogin::getUser() == "lcarneir"){showMessage("wcstprod "+wcstprod )}

      wfator = wbtri.qbfisc
      if (wddol.pi > 0) {
        wbc = round(((wddol.qpsr * wddol.mvalun)) * wfator, 2)
      } else {
        wbc = 0.00
      }

      //Montagem da TAG de ICMS
      wlinha += "<ICMS" + wcstprod.trim().substring(0, 1) + "0>"
      if (inList(wrow.iuorg.trim(), ["F03"]) && wddol.iuorg2.trim() == "I03") {
        wlinha += "<orig>1</orig>"
      } else {
        wlinha += "<orig>" + worigem + "</orig>"
      }
      wlinha += "<CST>" + wcstprod.trim() + "</CST>"

      if (wcstprod == "00") {
        //if(MLogin::getUser() == "santiago"){showMessage("if")}
        wlinha += "<modBC>3</modBC>"
        wlinha += "<vBC>" + formatNumber(wbc + wtotfrete, "N0.00") + "</vBC>"
        wlinha += "<pICMS>" + formatNumber(wddol.pi, "N0.00") + "</pICMS>"
        wlinha += "<vICMS>" + formatNumber(wddol.mvalim + wtotfreteicms, "N0.00") + "</vICMS>"
        wvBCUFDest = formatNumber(wbc + wtotfrete, "N0.00")
        wpICMSUFDest = formatNumber(wddol.pi, "N0.00")
        if (wuser == "scavalca") { showMessage("05  -> " + wpICMSUFDest) }
      } else if (wcstprod == "60") {
        //if(MLogin::getUser() == "santiago"){showMessage("else")}
        //wlinha += "<vBCSTRet>0</vBCSTRet>"
        //wlinha += "<vICMSSTRet>0</vICMSSTRet>"
        if (wtemICMSEfetivo) {
          wlinha += "<pRedBCEfet>0.00</pRedBCEfet>"
          wlinha += "<vBCEfet>0.00</vBCEfet>"
          wlinha += "<pICMSEfet>0.00</pICMSEfet>"
          wlinha += "<vICMSEfet>0.00</vICMSEfet>"
        }
      } else if (inList(wddol.cit.trim(), ["5409", "5152"]) && wrow.iuorg.trim() == "F07" && wbent2.testado.trim().toUpperCase() == "CE" && wddol.ipst.trim() == "CEL") {
        //************************************************************************************************************************************************************ 
        //INICIO - TICKET 13722 - CAMILA MOURA - 02/10/2018
        showMessage("entrou ICMS ST - CELULAR")

        wpmvast = 0.00
        wpredbcts = 0.00
        wvbcst = 0.00
        wpICMSST = 0.00
        wvICMSST = 0.00

        wsel = "Select sum(a.mvalor) "
