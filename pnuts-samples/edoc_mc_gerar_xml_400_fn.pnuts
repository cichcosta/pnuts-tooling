    wlinha += "<vIBSMun>" + formatNumber(wvIBSMun, "N0.00") + "</vIBSMun>"
    wlinha += "</gIBSMun>"
    wlinha += "<vIBS>" + formatNumber(wvIBS, "N0.00") + "</vIBS>"
    wlinha += "<gCBS>"
    wlinha += "<pCBS>" + formatNumber(wpCBS, "N0.00") + "</pCBS>"
    wlinha += "<vCBS>" + formatNumber(wvCBS, "N0.00") + "</vCBS>"
    wlinha += "</gCBS>"
    wlinha += "</gIBSCBS>"
    wlinha += "</IBSCBS>"
  }

  // >>>>>>>>>>>>>>>> REFORMA TRIBUTARIA - FIM >>>>>>>>>>>>>>>>>>>>>>>


  wlinha += "</imposto>"

  if (wvaldescicmsdesone > 0 || wFlagFecop || wvaldescicmssuframa > 0) {
    wlinha += "<infAdProd>"

    //202607 - NPP.002862 - REGRAS DE IMPOSTOS PARA VENDAS PARA SUFRAMA - NOTA FISCAL
    if (wvaldescicmssuframa > 0) {
      wlinha += "Valor de ICMS Abatido RS " + formatNumber(wvaldescicmssuframa, "N0.00") + "/ ";
    }

    if (wvaldescicmsdesone > 0) {
      wlinha += "Valor de ICMS Abatido RS " + formatNumber(wvaldescicmsdesone, "N0.00") + "/ ";
    }
    if (wFlagFecop) {
      wlinha += "FCP-ICMS: B. Calculo = " + formatNumber(bIcms, "N0.00") + "/ ";
      wlinha += "Aliquota = 1.00% / ";
      wlinha += "Valor = " + formatNumber((bIcms * 0.01), "N0.00") + "/ ";
    }
    wlinha += "</infAdProd>"
    wFlagFecop = false
  }

  if (wrow.idoct2.trim() == "NDC" && wvdespa > 0 && wrow.ctcf.trim() == "6202") {
    wlinha += "<impostoDevol>"

    println(">>>>>>>>>>>>>>>>> wvdespa: " + wvdespa); flush();
    println(">>>>>>>>>>>>>>>>> wddol.mvalor: " + wddol.mvalor); flush();

    wlinha += "	<pDevol>" + formatNumber((wvdespa / wddol.mvalor) * 100, "N0.00") + "</pDevol>"
    wlinha += "	<IPI>"
    wlinha += "		<vIPIDevol>" + formatNumber(wvdespa, "N0.00") + "</vIPIDevol>"
    wlinha += "	</IPI>"
    wlinha += "</impostoDevol>"
  }

  wlinha += "</det>"
  //wbody.append(wlinha)
  wtot = (wddol.mvalun * wddol.qpsr)
  if (wfinNFe == "2" && wddol.ctcf.trim() == "6949SIMB") {
    //wtotprod = 0.00
  } else {
    wtotprod += round(wtot, 2)
  }
  //showMessage(wtotprod.toString())
  if (wuser == "ospinosa") {
    println(">>>>>>>>>>>>>>>>> prod  : " + wddol.ipsr + " = " + wtot); flush();
    println(">>>>>>>>>>>>>>>>> prod  : " + wddol.ipsr + " = " + wtotprod); flush();

  }

  //wtotprod   += round((wddol.mvalun*wddol.qpsr), 2)
  wtotmvaldc += round(wddol.mvaldc, 2)
