          //} else if (inList(wddol.cit.trim(), ["5409", "5152"]) && wbent2.testado.trim().toUpperCase() == "CE" && wimprimest) {
          //NPP.001652 PARAMETRIZAÇÃO VENDA DE CELULAR F03 E F07
        } else if ((inList(wddol.cit.trim(), ["5409", "5152"]) && wbent2.testado.trim().toUpperCase() == "CE" && wimprimest) || (wvendaicmsdest > 0)) {
