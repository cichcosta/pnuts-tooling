      wsel = "Select a.iixp, a.mvalor "
      wsel += "  From ddolt0 a "
      wsel += " Where a.iorg  = '" + wrow.iorg.trim() + "' "
      wsel += "   and a.idoct = '" + wrow.idoct.trim() + "' "
      wsel += "   and a.idoc  = '" + wrow.idoc.trim() + "' "
      wsel += "   and a.ientt = '" + wrow.ientt.trim() + "' "
      wsel += "   and a.ient  = '" + wrow.ient.trim() + "' "
      wsel += "   and a.ipsr  = '" + wddol.ipsr.trim() + "' "
      wsel += "   and a.idol  = '" + wddol.idol.trim() + "' "
      wsel += "   and (a.irct1 = 'CF' or a.ndoc = 'COFINS') "
      wddol2 = getRow("DDOL", wsel)

      wlinha += "<COFINSAliq>"
      wlinha += "<CST>01</CST>"


      if (wddol2.iixp.trim() != "" && wddol2.iixp.trim() != null && wddol2.iixp.trim() != "0.000") {
        wlinha += "<vBC>" + formatNumber((wddol2.mvalor / (toNumber(wddol2.iixp.trim()) / 100)), "N0.00") + "</vBC>"
      } else {
        wlinha += "<vBC>" + formatNumber(0, "N0.00") + "</vBC>"
      }

      wlinha += "<pCOFINS>" + formatNumber(toNumber(wddol2.iixp.trim()), "N0.00") + "</pCOFINS>"
      wlinha += "<vCOFINS>" + formatNumber(wddol2.mvalor, "N0.00") + "</vCOFINS>"
      wlinha += "</COFINSAliq>"
      wtotcofins += wddol2.mvalor
    } else if ((wddol.cfpsr2.trim() != "I") && (wtclass != "")) {
      if (wUF_E12.trim() == "AM") {
        wvalcof = getSQLNumber("Select a.qqcoef2 from bctxt0 a where a.ictx = 'BCTX*NFE' and a.ivalk = 'COF'")
      } else {
        wvalcof = getSQLNumber("Select a.qqcoef1 from bctxt0 a where a.ictx = 'BCTX*NFE' and a.ivalk = 'COF'")
      }
      wlinha += "<COFINSAliq>"
      wlinha += "<CST>01</CST>"
      wlinha += "<vBC>" + formatNumber(wddol.mvalor, "N0.00") + "</vBC>"
      wlinha += "<pCOFINS>" + formatNumber(wvalcof, "N0.00") + "</pCOFINS>"
      //wlinha     += "<vCOFINS>"    + formatNumber(((wddol.mvalor*wvalcof)/100),"N0.00")                            + "</vCOFINS>"

      wlinha += "<vCOFINS>" + formatNumber(round(((wddol.mvalor * wvalcof) / 100), 2), "N0.00") + "</vCOFINS>"

      wlinha += "</COFINSAliq>"
      //wtotcofins += ((wddol.mvalor*wvalcof)/100)

      wtotcofins += round(((wddol.mvalor * wvalcof) / 100), 2)
    } else if (wddol.cfpsr2.trim() == "I") {
      wlinha += "<COFINSNT>"
      wlinha += "<CST>06</CST>"
      wlinha += "</COFINSNT>"
    } else {
      wlinha += "<COFINSNT>"
      wlinha += "<CST>08</CST>"
      wlinha += "</COFINSNT>"
    }
  } else {
    wlinha += "<COFINSNT>"
    wlinha += "<CST>08</CST>"
    wlinha += "</COFINSNT>"
  }
  wlinha += "</COFINS>"

