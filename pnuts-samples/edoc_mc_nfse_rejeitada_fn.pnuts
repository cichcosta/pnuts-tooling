//edoc_mc_nfse_rejeitada_fn(wiuorg)
//Canacelar notas rejeitadas
//Autor:  John Lucas
wdatetime = x_mc_br_get_date_server_fn()
wdate = wdatetime.substring(0, 10)

cursor = MConnection:: getMCursor();

function log(msg) {
  println(msg); flush()
}

wuser = MLogin:: getUser().trim()

// select que traz todas as uos ou pelo menos
// as que se deseja trabalhar (consultar no edoc)
wsel = "select * "
wsel += "  from bentt0 with(nolock) "
wsel += " where ientt = '*' "
wsel += "   and ient = 'TEC' "
wsel += "   and iuorgt = 'UO' "
wsel += "   and iuorg = '" + wiuorg.trim() + "'"
vuo = getRows("BENT", wsel)

if (vuo.size() > 0) {

    // percorremos todas as UOS
  foreach wuo(vuo.elements()){

    wsel = "select top 1 * "
    wsel += "  from ddoct0 with(nolock) "
    wsel += " where iorg   = 'TEC' "
    wsel += "   and idoct  = 'RPS' "
    wsel += "   and iuorgt = 'UO' "
    wsel += "   and iuorg  = '" + wuo.iuorg.trim() + "' "
    wddoc = getRow("DDOC", wsel)

    if (wddoc.wdcode != 100) {
      oManager = edoc_mc_get_http_service_fn(wddoc, "nfse")
    } else {
      continue
    }

    wAplicarRegraNumeracao = x_mc_aplica_regra_idoc_fn(wuo.testado.trim(), wuo.tmunicip.trim());

    wfaixaIni = 0

    //Pegar ultimo RPS gerado pendente de autorização
    wsel = " select top 1 idoc "
    wsel += " from ddoct0 with (nolock) "
    wsel += " where iorg = 'TEC' "
    wsel += " and iuorg = '" + wuo.iuorg + "' "
    wsel += " and idoct = 'RPS' "
    wsel += " and csto = 'CE' "
    wsel += " order by idoc desc"
    println(wsel); flush();

    widoc = getSQLValue(wsel)
    if (widoc != "") {
      wfaixaIni = INT(toNumber(widoc.replaceAll("[^0-9]", "")))
    }

    // obter a data do primeiro dia do mes corrente
    wdate = x_mc_br_get_date_server_fn()
    wdate = wdate.substring(0, 10)
    wdataIni = MDate(wdate).inicioMes().toString("dd/MM/yyyy")

    // monta a query string para a consulta

    // Para atender o novo CNPJ Alfanumerico, trocamos a regex antiga "[^0-9]" pela nova "[^A-Z0-9]".
    wQueryString = "consulta?encode=true&grupo=IBYTE&cnpj=" + wuo.tidfisc.replaceAll("[^A-Z0-9]", "") + "&Campos=nrps,cnpj,serie,situacao,tipo,cidade&Filtro=1=1"
    wQueryString += "+and+situacao=REJEITADA"
    wQueryString += "+AND+nrps+%3C%3D+" + wfaixaIni;
    wQueryString += "+AND+dtemissao+%3E%3D+" + wdataIni;

    // função para fazer a requisição
    function func_request(wQueryString, oManager) {
            catch (Exception, function(e) { return "exception: " + e.toString() })
      wresult = oManager.doRequestGet(wQueryString)
      return wresult
    }

    // solicita a listagem das notas no edoc
    wGet = func_request(wQueryString, oManager)

    if (wGet.toLowerCase().contains("exception")) {
      println("Erro ao consultar notas no edoc: " + wGet); flush();
      continue
    }

    if (wGet.toLowerCase().indexOf("nenhum registro encontrado") != -1) {
      println("Nenhuma nota encontrada no edoc"); flush();
      continue
    }

    // monta um array com o retorno da solicitação
    wgetArray = wGet.split("\r\n")

    if (wgetArray.length == 0) {
      println("Falha no array do GET"); flush();
      continue
    }

    for (i = 0; i < wgetArray.length; i++) {

      wlinha = wgetArray[i]

      // monta um array da linha separando os dados por virgula
      wlinhaArray = wlinha.split(",")

      // obtem os dados separadamente
      wnumRps = wlinhaArray[0]
      wcnpj = wlinhaArray[1]
      wserie = wlinhaArray[2]
      wsituacao = wlinhaArray[3]

      //seleciona o cnpj da UO para verificar se  o mesmo que vem do edoc
      wsel = "select top 1 tidfisc "
      wsel += "  from bentt0 with(nolock) "
      wsel += " where ientt = '*' "
      wsel += "   and ient = 'TEC' "
      wsel += "   and iuorgt = 'UO' "
      wsel += "   and iuorg = '" + wuo.iuorg + "' "
      log(">>edoc_mc_nfse_resolver_new_fn<<>>>>bent_cnpj_edoc<<<< " + wsel);

      // Para atender o novo CNPJ Alfanumerico, trocamos a regex antiga "[^0-9]" pela nova "[^A-Z0-9]".
      wcnpjUO = getSQLValue(wsel).replaceAll("[^A-Z0-9]", "")
      if (wcnpjUO != wcnpj) {
        log("CNPJ diferentes " + wcnpjUO + "/" + wcnpj)
        continue
      }

      wnumRPSFormatado = wuo.iuorg.trim() + "/" + formatNumber(wnumRps, "N0000000")

      //consulta o RPS na base do minimal
      wsel = "select * "
      wsel += "  from ddoct0 with(nolock) "
      wsel += " where iorg = 'TEC' "
      wsel += "   and iuorgt = 'UO' "
      wsel += "   and iuorg = '" + wuo.iuorg.trim() + "' "
      wsel += "   and ientt in ('FN','CL') "
      wsel += "   and idoct = 'RPS' "
      wsel += "   and iixp = '" + wnumRps + "' "
      log(wsel)
      wddocRPS = getMRow("DDOC", wsel)

      if (wddocRPS == null) {
        log("RPS não encontrado na base do minimal")
        continue
      }

      System:: out.printf("Documento: %s, Status: %s - %s, Situação: %s\n", [wddocRPS.idoc.trim(), wddocRPS.csto.trim(), wddocRPS.cstc.trim(), wsituacao.trim()])
      if (wddocRPS.csto.trim() == "XA" && wddocRPS.cstc.trim() == "XA") {
        log("RPS já cancelado")
        continue
      }

      wddocRPS.csto = "XA"
      wddocRPS.cstc = "XA"
      wddocRPS.updateRow(wddocRPS)
      wddocRPS.setZCommand("UPDATE_ROW", "AF", " ")

      ddoc0_pr_insert_ddoe_fn(wddocRPS, "CAN", "", "RPS Rejeitado", wddocRPS.mvalor)

      cursor.commitWork()
      cursor.beginWork()

    }
  }

}