            wsel += "   and a.idoct2 = '" + wrow.idoct2.trim() + "' "
            wsel += "   and a.idoc2  = '" + wrow.idoc2.trim() + "' "
            wsel += "   and a.iuorgt = '" + wrow.iuorgt.trim() + "' "
            wsel += "   and a.iuorg  = '" + wrow.iuorg.trim() + "' "
            wsel += "   and a.ipsr   = '" + wddol.ipsr.trim() + "' "
            wsel += "   and a.idol   = '" + wddol.idol.trim() + "' "
            println(wsel); flush()
            wntszk = getSQLValue(wsel)

            if (wntszk == "") {
              throwError("Linha da NTS não encontrado.")
            }

            wmva = x_mc_select_extension_fn("n", "ddoltx", wntszk, "wmva")
            wreducao = x_mc_select_extension_fn("n", "ddoltx", wntszk, "wreducao")

            wprodred = wddol.mvalor * wreducao

            wvbcicmsst = wprodred + (wprodred * wmva)

            wvbc = (wddol.mvalor - wddol.mvalim2) * wreducao

            wlinha += "<modBC>3</modBC>"
            wlinha += "<vBC>" + formatNumber(wvbc, "N0.00") + "</vBC>"
            wlinha += "<pICMS>" + formatNumber(wddol.pi, "N0.00") + "</pICMS>"
