    wufdestino = ["AM", "RR", "AP", "PA", "TO", "RO", "AC", "MA", "PI", "CE", "RN", "PE", "PB", "SE", "AL", "BA", "MT", "MS", "GO", "ES"]
    if (inList(wbent.testado.trim(), wuforigem) && inList(wbent2.testado.trim(), wufdestino)) {
      if (MLogin:: getUser() == "scavalca") { showMessage("Imposto 7") }
