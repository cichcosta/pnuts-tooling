  wsel += " Where a.iorg    = '" + wrow.iorg.trim() + "' "
  wsel += "   and a.idoct   = '" + wrow.idoct.trim() + "' "
  wsel += "   and a.idoc    = '" + wrow.idoc.trim() + "' "
  wsel += "   and a.ientt   = '" + wrow.ientt.trim() + "' "
  wsel += "   and a.ient    = '" + wrow.ient.trim() + "' "
  wsel += "   and a.ipsr    = '" + wddol.ipsr.trim() + "' "
  wsel += "   and a.zkddol  = '" + wzkddol + "' "
  vddor = getRows("DDOR", wsel)
  println("CONSULTA DDOR - RTC >>> " + wsel); flush()

    foreach wddor(vddor.elements()){
    wicst = wddor.icst.trim()
    wiclasstrib = wddor.iclasstrib.trim()
    wvBCIBSCBS = wddor.mvalor

    if (wddor.ci.trim() == "IBSUF") {
      wpIBSUF = wddor.pi_efe
      wvIBSUF = wddor.mvalim
      wvtIBSUF += wddor.mvalim
    }
    if (wddor.ci.trim() == "IBSMUN") {
      wpIBSMun = wddor.pi_efe
      wvIBSMun = wddor.mvalim
      wvtIBSMun += wddor.mvalim
    }
    if (wddor.ci.trim() == "CBS") {
      wpCBS = wddor.pi_efe
      wvCBS = wddor.mvalim
      wvtCBS += wddor.mvalim
    }
  }
  if (wvIBSUF > 0 || wvIBSMun > 0 || wvCBS > 0) {
    wvIBS = (wvIBSUF + wvIBSMun)
    wvIBSt += (wvIBSUF + wvIBSMun)
    wvBCIBSCBSt += wvBCIBSCBS

    wlinha += "<IBSCBS>"
    wlinha += "<CST>" + wicst + "</CST>"
    wlinha += "<cClassTrib>" + wiclasstrib + "</cClassTrib>"
    wlinha += "<gIBSCBS>"
    wlinha += "<vBC>" + formatNumber(wvBCIBSCBS, "N0.00") + "</vBC>"
    wlinha += "<gIBSUF>"
    wlinha += "<pIBSUF>" + formatNumber(wpIBSUF, "N0.00") + "</pIBSUF>"
    wlinha += "<vIBSUF>" + formatNumber(wvIBSUF, "N0.00") + "</vIBSUF>"
    wlinha += "</gIBSUF>"
