          wvbcicmsst = 0
          if (wuser == "alopes") { showMessage("<ICMS10> - 03") }

          wvbcicmsst = round((wddol.mvalor - wddol.mvalim2) * 1.30, 2)
          //NPP.001774 - CADASTRO DE REGRAS TRIBUTÁRIAS F59
          if (wvendaicmsdest > 0 && wbent.testado.trim().toUpperCase() == "PE") {
