{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Pnuts",
  "scopeName": "source.pnuts",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#types"
    },
    {
      "include": "#constants"
    },
    {
      "include": "#functions"
    },
    {
      "include": "#properties"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#operators"
    },
    {
      "include": "#classes"
    },
    {
      "include": "#identifiers"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.pnuts",
          "match": "//.*$"
        },
        {
          "name": "comment.block.pnuts",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.pnuts",
          "begin": "\\\"",
          "end": "\\\"",
          "patterns": [
            {
              "name": "constant.character.escape.pnuts",
              "match": "\\\\."
            }
          ]
        },
        {
          "name": "string.quoted.single.pnuts",
          "begin": "'",
          "end": "'",
          "patterns": [
            {
              "name": "constant.character.escape.pnuts",
              "match": "\\\\."
            }
          ]
        },
        {
          "name": "string.interpolated.pnuts",
          "begin": "`",
          "end": "`",
          "patterns": [
            {
              "name": "constant.character.escape.pnuts",
              "match": "\\\\."
            },
            {
              "name": "meta.embedded.line.pnuts",
              "begin": "\\$\\{",
              "end": "\\}",
              "patterns": [
                {
                  "include": "$self"
                }
              ]
            },
            {
              "name": "meta.embedded.line.pnuts",
              "begin": "\\\\\\(",
              "end": "\\)",
              "patterns": [
                {
                  "include": "$self"
                }
              ]
            }
          ]
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.pnuts",
          "match": "\\b(if|else|while|do|for|foreach|switch|case|default|return|yield|try|catch|finally|throw|break|continue)\\b"
        },
        {
          "name": "keyword.declaration.pnuts",
          "match": "\\b(function|class|extends|implements|package|import|static|new)\\b"
        },
        {
          "name": "keyword.operator.expression.pnuts",
          "match": "\\b(instanceof)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "storage.type.primitive.pnuts",
          "match": "\\b(boolean|byte|char|short|int|long|float|double|void)\\b"
        },
        {
          "name": "support.class.pnuts",
          "match": "\\b(String|Object|List|Map|Set|Integer|Long|Boolean|Double|Float|Byte|Short|Character|BigInteger|BigDecimal|Date|Exception|Throwable|Error|StringBuilder|StringBuffer|Thread|Class)\\b"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.boolean.pnuts",
          "match": "\\b(true|false)\\b"
        },
        {
          "name": "constant.language.null.pnuts",
          "match": "\\b(null)\\b"
        },
        {
          "name": "variable.language.pnuts",
          "match": "\\b(this|super)\\b"
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "match": "\\bfunction\\s+([a-zA-Z_$][a-zA-Z0-9_$]*)\\s*\\(",
          "captures": {
            "1": {
              "name": "entity.name.function.pnuts"
            }
          }
        },
        {
          "match": "(::)([a-zA-Z_$][a-zA-Z0-9_$]*)\\s*\\(",
          "captures": {
            "1": {
              "name": "keyword.operator.static.pnuts punctuation.accessor.pnuts"
            },
            "2": {
              "name": "entity.name.function.method.static.pnuts entity.name.function.method.pnuts"
            }
          }
        },
        {
          "match": "(\\?\\.|\\*\\.|\\.)([a-zA-Z_$][a-zA-Z0-9_$]*)\\s*\\(",
          "captures": {
            "1": {
              "name": "punctuation.accessor.pnuts"
            },
            "2": {
              "name": "entity.name.function.method.pnuts"
            }
          }
        },
        {
          "match": "\\b([a-zA-Z_$][a-zA-Z0-9_$]*)\\s*\\(",
          "captures": {
            "1": {
              "name": "entity.name.function.call.pnuts"
            }
          }
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.hex.pnuts",
          "match": "\\b0[xX][0-9a-fA-F]+\\b|#[0-9a-fA-F]+\\b"
        },
        {
          "name": "constant.numeric.decimal.pnuts",
          "match": "\\b\\d+(\\.\\d+)?([eE][+-]?\\d+)?([a-zA-Z]+)?\\b|\\.\\d+([eE][+-]?\\d+)?([a-zA-Z]+)?\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.safe-navigation.pnuts",
          "match": "\\?\\."
        },
        {
          "name": "keyword.operator.spread.pnuts",
          "match": "\\*\\."
        },
        {
          "name": "keyword.operator.static.pnuts",
          "match": "::"
        },
        {
          "name": "keyword.operator.arrow.pnuts",
          "match": "=>|->"
        },
        {
          "name": "keyword.operator.range.pnuts",
          "match": "\\.\\."
        },
        {
          "name": "keyword.operator.comparison.pnuts",
          "match": "===|!==|==|!=|<=|>=|<|>"
        },
        {
          "name": "keyword.operator.assignment.pnuts",
          "match": "\\+=|-=|\\*=|/=|%=|&=|\\|=|\\^=|<<=|>>=|>>>=|="
        },
        {
          "name": "keyword.operator.logical.pnuts",
          "match": "&&|\\|\\||!"
        },
        {
          "name": "keyword.operator.bitwise.pnuts",
          "match": "&|\\||\\^|~|<<|>>>|>>"
        },
        {
          "name": "keyword.operator.arithmetic.pnuts",
          "match": "\\+\\+|--|\\+|-|\\*|/|%"
        },
        {
          "name": "keyword.operator.ternary.pnuts",
          "match": "\\?|:"
        }
      ]
    },
    "properties": {
      "patterns": [
        {
          "match": "(::)([a-zA-Z_$][a-zA-Z0-9_$]*)",
          "captures": {
            "1": {
              "name": "keyword.operator.static.pnuts punctuation.accessor.pnuts"
            },
            "2": {
              "name": "support.type.property-name.pnuts"
            }
          }
        },
        {
          "match": "(\\?\\.|\\*\\.|\\.)([a-zA-Z_$][a-zA-Z0-9_$]*)",
          "captures": {
            "1": {
              "name": "punctuation.accessor.pnuts"
            },
            "2": {
              "name": "support.type.property-name.pnuts"
            }
          }
        }
      ]
    },
    "classes": {
      "patterns": [
        {
          "name": "entity.name.type.class.pnuts",
          "match": "\\b[A-Z][a-zA-Z0-9_$]*\\b"
        }
      ]
    },
    "identifiers": {
      "patterns": [
        {
          "match": "(::)([a-zA-Z_$][a-zA-Z0-9_$]*)",
          "captures": {
            "1": {
              "name": "keyword.operator.static.pnuts punctuation.accessor.pnuts"
            },
            "2": {
              "name": "support.type.property-name.pnuts"
            }
          }
        },
        {
          "match": "(\\?\\.|\\*\\.|\\.)([a-zA-Z_$][a-zA-Z0-9_$]*)",
          "captures": {
            "1": {
              "name": "punctuation.accessor.pnuts"
            },
            "2": {
              "name": "support.type.property-name.pnuts"
            }
          }
        },
        {
          "name": "variable.other.pnuts",
          "match": "\\b[a-zA-Z_$][a-zA-Z0-9_$]*\\b"
        }
      ]
    }
  }
}