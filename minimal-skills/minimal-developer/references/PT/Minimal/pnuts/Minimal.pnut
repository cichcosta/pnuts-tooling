//


// Interface erros da aplicação

function showMessage(werr) {
   return showMessage(werr, null)
}

function showMessage(wmsg, wparms) {
   println("showMessage: " + wmsg + " - " + wparms);flush()
   if (wmsg.startsWith("MIN-")) {
      return showError(wmsg, wparms)
   }
   err = MError("MIN-000001M", wparms)
   err.setMessage(wmsg)
   return err.show()
}

function showError(werr) {
   return MError(werr).show()
}

function showError(werr, wparms) {
  merr = MError(werr, wparms)
  merr.setFromPnut(true)
  return merr.show()
}

function throwError(werr) {
   err = MError(werr)
   err.setFromPnut(true)
   throw(err)
}
function throwError(werr, wparms) {
   err = MError(werr, wparms)
   err.setFromPnut(true)
   throw(err)
}

function throwError(werr, wform, watrib) {
   err = MError(werr)
   err.setFromPnut(true)
   err.setAtrib(watrib)
   err.setForm(wform)
   err.setWmcode(-1)
   throw(err)
}

function throwError(werr, wform, watrib, wmsg) {
   err = MError(werr, wmsg)
   err.setFromPnut(true)
   err.setAtrib(watrib)
   err.setForm(wform)
   err.setWmcode(-1)
   throw(err)
}

