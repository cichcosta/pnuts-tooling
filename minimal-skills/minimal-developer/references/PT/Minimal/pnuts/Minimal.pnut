function sendEmail(mailhost, subject, contents, from, to){
   sendEmail(mailhost, subject, contents, from, to, "", "", "")
}

function sendEmail(mailhost, subject, contents, from, to, cc, bcc, replyTo){
   sendEmail(mailhost, 25, subject, contents, from, to, cc, bcc, replyTo)
}

function sendEmail(mailhost, mailport, subject, contents, from, to, cc, bcc, replyTo)
{
  props = Properties()
  props.put("mail.smtp.host", mailhost)
  props.put("mail.smtp.port", mailport)

  session = Session::getInstance(props, null)
  msg = MimeMessage(session)
  msg.setFrom(senderAddress(from))
  msg.setRecipients(Message$RecipientType::TO, receiverAddress(to))

  if (cc.trim() != "") msg.setRecipients(Message$RecipientType::CC, receiverAddress(cc))
  if (bcc.trim() != "") msg.setRecipients(Message$RecipientType::BCC, receiverAddress(bcc))
  if (replyTo.trim() != "") msg.setReplyTo(receiverAddress(replyTo))

  msg.setSubject(subject)
  msg.setHeader("Minimal", "pnuts")
  msg.setSentDate(Date())

  if (contents instanceof MimeMultipart){
    msg.setContent(contents)
  } else if (contents instanceof String){
    msg.setText(contents)
  } else {
    throw("contents must be a String or a MimeMultipart")
  }

  Transport::send(msg)
}

function sendEmailAuth(user,pass,mailhost, mailport, subject, contents, from, to, cc, bcc, replyTo)
{
  props = Properties()
  props.put("mail.smtp.host", mailhost)
  props.put("mail.smtp.port", mailport)

  props.put("mail.smtp.starttls.enable", "true");
  props.put("mail.smtp.user", user);
  props.put("mail.smtp.password", pass);
  props.put("mail.smtp.auth", "true");


  session = Session::getDefaultInstance(props, null)
  msg = MimeMessage(session)
  msg.setFrom(senderAddress(from))
  msg.setRecipients(Message$RecipientType::TO, receiverAddress(to))


  if (cc.trim() != "") msg.setRecipients(Message$RecipientType::CC, receiverAddress(cc))
  if (bcc.trim() != "") msg.setRecipients(Message$RecipientType::BCC, receiverAddress(bcc))
  if (replyTo.trim() != "") msg.setReplyTo(receiverAddress(replyTo))

  msg.setSubject(subject)
  msg.setHeader("Minimal", "pnuts")
  msg.setSentDate(Date())

  if (contents instanceof MimeMultipart){
    msg.setContent(contents)
  } else if (contents instanceof String){
    msg.setText(contents)
  } else {
    throw("contents must be a String or a MimeMultipart")
  }

 transport = session.getTransport("smtp")
 transport.connect(mailhost,user, pass)
 //transport.connect(mailhost, mailport,user, pass)
 // Transport::send(msg )
 transport.sendMessage(msg,msg.getAllRecipients())
 transport.close()




}


function senderAddress(addr){
  if (addr instanceof InternetAddress){
    addr
  } else if (addr instanceof String){
    InternetAddress(addr)
  } else {
    throw("illegal arguments")
  }
}

function receiverAddress(addr){
  if (addr instanceof InternetAddress){
    addr
  } else if (addr instanceof InternetAddress[]){
    [addr]
  } else if (addr instanceof String){
    InternetAddress::parse(addr, false)
  } else if (isArray(addr)){
    map(addr, function (x) InternetAddress(x))
  } else {
    throw("illegal arguments")
  }
}

function attachText(text) attachText(null, text)
function attachFile(filename) attachFile(null, filename)
function attachURL(url) attachURL(null, url)

function attachText(multipart, text){
  if (multipart == null) multipart = MimeMultipart()
  part1 = MimeBodyPart()
  part1.setText(text)
  multipart.addBodyPart(part1)
  multipart
}

function attachFile(multipart, filename){
  if (multipart == null) multipart = MimeMultipart()
  part1 = MimeBodyPart()
  fds = FileDataSource(filename)
  part1.setDataHandler(DataHandler(fds))
  part1.setFileName(fds.getName())
  multipart.addBodyPart(part1)
  multipart
}

function attachURL(multipart, url){
  if (multipart == null) multipart = MimeMultipart()
  part1 = MimeBodyPart()
  ds = URLDataSource(url)
  part1.setDataHandler(DataHandler(ds))
  part1.setFileName(ds.getName())
  multipart.addBodyPart(part1)
  multipart
}

