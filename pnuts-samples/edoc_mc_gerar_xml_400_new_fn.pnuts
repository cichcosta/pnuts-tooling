  wvTroco = 0.00
  if (wtotalEmDuplicatas > 0) {

    wlinha += "<detPag>"
    wlinha += "<tPag>14</tPag>"
    wlinha += "<vPag>" + formatNumber(wtotalEmDuplicatas, "N0.00") + "</vPag>"
    wlinha += "</detPag>"

    // faz o calculo para saber se o valor da 
    // nota é itual ao total do somatorio das duplicatas
    wdiferencaDup = wvNF - wtotalEmDuplicatas
    if (wdiferencaDup != 0) {
      if (wdiferencaDup > 0) {
        wlinha += "<detPag>"
        wlinha += "<tPag>99</tPag>"
        wlinha += "<vPag>" + formatNumber(wdiferencaDup, "N0.00") + "</vPag>"
        wlinha += "</detPag>"
      } else {
        wvTroco = wdiferencaDup * -1
      }
    }

  } else {

    wlinha += "<detPag>"
    wlinha += "<tPag>01</tPag>"
    wlinha += "<vPag>" + formatNumber(wvNF, "N0.00") + "</vPag>"
    wlinha += "</detPag>"

  }

  if (wvTroco > 0) {
    wlinha += "<vTroco>" + formatNumber(wvTroco, "N0.00") + "</vTroco>"
  }

} else {

  wlinha += "<detPag>"
  wlinha += "<tPag>90</tPag>"
  wlinha += "<vPag>0.00</vPag>"
  wlinha += "</detPag>"

}

wlinha += "</pag>"

// Verifica se existe alguma observaÃ§Ã£o
wobs = ddoc0_mc_nfe_observacoes_fn(wrow)

if (wTotvICMSUFDest > 0) {
  //wobs += "Total ICMS interestadual para UF do destinatário : " + wTotvICMSUFDest + ""
  //wobs += "Total ICMS interestadual para UF do remetente    : " + wTotvICMSUFRemet + ""
}

wzk = formatNumber(wrow.zk, "N00000000000000")
wobsf = x_mc_select_extension_fn("c", "ddoctx", wzk, "Obs_int")

if (!inList(wobsf.trim(), ["?", ""])) {
  wobs += "\n"
  wobs += "\n"
  wobs += "----------- " + wobsf.toUpperCase().trim() + " -------------"
}



if (wobs.trim() != "") {
  wlinha += "<infAdic>"
  //wlinha += "<infAdFisco></infAdFisco>"
  wlinha += "<infCpl>" + wobs.trim() + "</infCpl>"
  wlinha += "</infAdic>"
}

if (wrow.cit.trim() == "7949") {

  wlinha += "<exporta>"
  wlinha += "<UFSaidaPais>" + wuf + "</UFSaidaPais>"
  wlinha += "<xLocExporta>" + wdilocal + "</xLocExporta>"
  wlinha += "</exporta>"
  //wbody.append(wlinha)

  if ((wuf.trim() == "") || (wdilocal.trim() == "")) { throwError("Favor informar a UF e Local de Embarque") }

}

// define o local de impressÃ£o
wlinha += "<Manager>"
wlinha += "<PrintManagerRemoto>" + edoc_mc_get_ip_fn() + ":8081</PrintManagerRemoto>"
wlinha += "<Impressora>" + edoc_mc_get_impressora_fn(wrow) + "</Impressora>"
if ((x_mc_get_access3_fn("DDOC0-0415", "")) && (wrow.idoct2.trim() == "NPV")) {
  wlinha += "<QTDCopias>2</QTDCopias>"
}
wlinha += "</Manager>"

wlinha += "</infNFe>"

cursor.commitWork()
cursor.beginWork()

println(wlinha)
flush()

return wlinha

// EOF	
