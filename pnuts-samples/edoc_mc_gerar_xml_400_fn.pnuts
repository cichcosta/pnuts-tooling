}

wlinha += "<total>"
wlinha += "<ICMSTot>"

if (wuser == "alopes" && wfrtndc && wrow.idoct2.trim() == "NDC" && inList(wrow.ctcf.trim(), ["6102", "6202", "6556"])) {
