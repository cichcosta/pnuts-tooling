append("ValorINSS=" + formatNumber(wValorInss, "N0.00"))
append("ValorIR=" + formatNumber(wValorIr, "N0.00"))
append("ValorCSLL=" + formatNumber(wValorCsll, "N0.00"))
append("AliquotaPIS=" + formatNumber(wAliquotaPIS, "N0.0000"))
append("AliquotaCOFINS=" + formatNumber(wAliquotaCofins, "N0.0000"))
append("AliquotaINSS=" + formatNumber(wAliquotaINSS, "N0.0000"))
append("AliquotaIR=" + formatNumber(wAliquotaIR, "N0.0000"))
append("AliquotaCSLL=" +  + formatNumber(wAliquotaCSLL, "N0.0000"))
append("ValorIss=0") //append("ValorIss=" + formatNumber(wValorIss, "N0.00"))
append("DescricaoRPS=" + wDiscriminacao)
append("DDDPrestador=86")
append("TelefonePrestador=")
append("DDDTomador=")
append("TelefoneTomador=")
append("SALVARRPS")


// wtipo indica se estamos trabalhando com edoc ou componente.
// se for edoc, então retornamos o tx2
if(wtipo == "edoc"){

   return wbody.toString()
   println(""+wbody); flush();

}else{

   //Grava arquivo txt 
   wpath        = System::getProperty("user.dir") + "\\NFSe\\" + wrow.iuorg.trim() + "\\Tx2\\"
   wfilenameObj = wpath + int(wrow.idoc.substring(4)) + ".tx2"
   wfileObj     = MFile(wfilenameObj)
   wfileObj.setBytes(wbody.toString().getBytes())
   wfileObj.saveFile(wfilenameObj)
   
}

cursor.commitWork()
cursor.beginWork()

