}
//wsel += " order by a.idol, a.iixp" //b.cfpsr, a.mvalor DESC "
vddol = getRows("DDOL", wsel)

wvbcst = 0.00; wpICMSST = 0.00; wvICMSST = 0.00;
wnumlinha = 1;

foreach wddol(vddol.elements()) {

  wvendaicmsdest = 0
  wvendalinhast = 0
