    }
    wzknpv = getSQLNumber(wsel)

    wsel = "SELECT zkaux FROM ddozt0 where nobj = 'bfrtt0' AND zk = " + wzknpv + "  "
    zkaux = getSQLValue(wsel)

    if (zkaux.trim() != "") {

      wsel = "SELECT ttext2 FROM ddozt0 where nobj = 'bfrtt0' AND zk = " + wzknpv + " and ttext = 'C'  "
      wdesctra = getSQLValue(wsel)

      if (wdesctra != "") {
        wdfform.wnome = wdesctra
      } else {
        wsel = "SELECT ientt, ient FROM bfrtt0 WHERE zk = " + zkaux
        wfrete = getMRow("BFRT", wsel)

        if (wfrete != null) {
          wsel = " SELECT ientt,ient,nent,tidfisc,tidfisc2,tmorad,tmail,testado,tmunicip "
          wsel += "   FROM bentt0 "
          wsel += "  WHERE ientt  = '" + wfrete.ientt.trim() + "' "
          wsel += "    AND ient   = '" + wfrete.ient.trim() + "' "
          wtra = getMRow("BENT", wsel)

          wdfform.wnome = wtra.nent.trim()
          wdfform.wend = wtra.tmorad.trim() + " " + wtra.tmail.trim()
          wdfform.wuftransp = wtra.testado.trim()

          // Para atender o novo CNPJ Alfanumerico, trocamos a regex antiga "[^0-9]" pela nova "[^A-Z0-9]".
          wdfform.wcnpj = wtra.tidfisc.trim().replaceAll("[^A-Z0-9]", "")
          wdfform.wie = wtra.tidfisc2.trim().replaceAll("[^0-9]", "")
          wdfform.wmun = wtra.tmunicip.trim()
        }
      }
    }
