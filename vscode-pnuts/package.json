{
  "name": "vscode-pnuts",
  "displayName": "Pnuts Language Support",
  "description": "Syntax highlighting and zero-dependency standalone Topiary-based code formatting for the Pnuts language",
  "version": "0.3.17",
  "publisher": "pnuts-tooling",
  "repository": {
    "type": "git",
    "url": "https://github.com/pnuts-tooling/pnuts-tooling"
  },
  "icon": "icons/pnuts.png",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Programming Languages",
    "Formatters"
  ],
  "extensionKind": [
    "workspace",
    "ui"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "onLanguage:pnuts",
    "onLanguage:groovy"
  ],
  "contributes": {
    "iconThemes": [
      {
        "id": "pnuts-icons",
        "label": "Pnuts File Icons",
        "path": "./icons/icon-theme.json"
      }
    ],
    "languages": [
      {
        "id": "pnuts",
        "aliases": [
          "Pnuts",
          "pnuts"
        ],
        "extensions": [
          ".pnuts",
          ".pnut"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./icons/pnuts.svg",
          "dark": "./icons/pnuts.svg"
        }
      },
      {
        "id": "groovy",
        "aliases": [
          "Groovy",
          "groovy"
        ],
        "extensions": [
          ".groovy"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "pnuts",
        "scopeName": "source.pnuts",
        "path": "./syntaxes/pnuts.tmLanguage.json"
      },
      {
        "language": "groovy",
        "scopeName": "source.groovy",
        "path": "./syntaxes/groovy.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "pnuts",
        "path": "./snippets/pnuts.json"
      },
      {
        "language": "groovy",
        "path": "./snippets/pnuts.json"
      }
    ],
    "configuration": {
      "title": "Pnuts",
      "properties": {
        "pnuts.lsp.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable Pnuts Language Server (LSP) for completions, diagnostics, and formatting"
        },
        "pnuts.lsp.path": {
          "type": "string",
          "default": "",
          "description": "Optional custom path to pnuts-lsp binary executable"
        },
        "pnuts.topiary.path": {
          "type": "string",
          "default": "topiary",
          "description": "Path to topiary executable binary"
        },
        "pnuts.topiary.configPath": {
          "type": "string",
          "default": "",
          "description": "Optional path to topiary languages.ncl configuration file"
        },
        "pnuts.topiary.queryPath": {
          "type": "string",
          "default": "",
          "description": "Optional path to directory containing pnuts.scm topiary formatting query"
        }
      }
    }
  },
  "dependencies": {
    "vscode-languageclient": "^10.1.1"
  }
}
