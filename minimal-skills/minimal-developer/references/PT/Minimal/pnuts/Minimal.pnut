}
function getValorMoeda2(wvalor, wmcm, wqcamb, wcmc, wdata, wccm) {
   return getValorMoedaReferencia("y", wvalor, wmcm, wqcamb, wcmc, wdata, wccm)
}

function getValorIvaMoeda1(wvalor, wmcm, wqcamb, wcmc) {
   return getValorIvaMoeda1(wvalor, wmcm, wqcamb, wcmc, today())
}
function getValorIvaMoeda1(wvalor, wmcm, wqcamb, wcmc, wdata) {
   return getValorIvaMoeda1(wvalor, wmcm, wqcamb, wcmc, wdata, "*")
}
function getValorIvaMoeda1(wvalor, wmcm, wqcamb, wcmc, wdata, wccm) {
   return getValorMoedaReferencia("vi", wvalor, wmcm, wqcamb, wcmc, wdata, wccm)
}

function getValorIvaMoeda2(wvalor, wmcm, wqcamb, wcmc) {
   return getValorIvaMoeda2(wvalor, wmcm, wqcamb, wcmc, today())
}
function getValorIvaMoeda2(wvalor, wmcm, wqcamb, wcmc, wdata) {
   return getValorIvaMoeda2(wvalor, wmcm, wqcamb, wcmc, wdata, "*")
}
function getValorIvaMoeda2(wvalor, wmcm, wqcamb, wcmc, wdata, wccm) {
   return getValorMoedaReferencia("yi", wvalor, wmcm, wqcamb, wcmc, wdata, wccm)
}

function getValorMoedaReferencia(wtipo, wvalor, wmcm, wqcamb, wcmc, wdata) {
   return getValorMoedaReferencia(wtipo, wvalor, wmcm, wqcamb, wcmc, wdata, "*")
}
function getValorMoedaReferencia(wtipo, wvalor, wmcm, wqcamb, wcmc, wdata, wccm) {
   wvcm = getMoeda1()
   wycm = getMoeda2()

   if (wmcm == null || wmcm.trim() == "") wmcm = getMoeda1()
   if (wcmc == null || wcmc.trim() == "") wcmc = getMoeda1()
   if (wccm == null || wccm.trim() == "") wccm = "*"
   if (wdata == null || wdata.trim() == "") wdata = today()
   if (wqcamb == 0) wqcamb = getCambio(wmcm, wcmc, wdata, wccm)

   wcsel  = " select mincvm('" + wtipo + "', " + wvalor + ", '" + wmcm + "', " + wqcamb + ", '" + wcmc + "', '" + wccm + "', '" + wdata + "', '" + wvcm + "', '" + wycm + "') "
   wcsel += " from dual "
   return getSQLNumber(wcsel)
}

// NFA 2003-02-07

function getPassword(wform, wtitle, wlabel) {

   wpane = JOptionPane()
   wdefaults = MTextField()
   woptions = ["     OK     ","Cancelar"]
   wfield = JPasswordField()
   wfield.setEchoChar('*')
   wfield.setFont(wdefaults.DEFAULTFONT)
   wfield.setBackground(wdefaults.DEFAULTCOLOR)
   wfield.setForeground(wdefaults.DEFFONTCOLOR)


   wcampos = [wlabel,wfield]

   wanswer = wpane.showOptionDialog(wform.getMFrame(), wcampos, wtitle, wpane.DEFAULT_OPTION, wpane.QUESTION_MESSAGE , null, woptions, woptions[0]);
   if (wanswer == 1) {
      return null
   }
   return wfield.getText()
}

