      //} else if ((wddol.cfpsr2.trim() == "I") && (!inList(wrow.cit.trim(),["5929","6929"]))) {

    } else if ((wutomatismo) && (!inList(wrow.cit.trim(), ["3101", "3102", "5411", "6411"]))) { //wddol.iuorg.trim() == "F09" ) {//AUTOMATISMO FISCAL || MLogin::getUser() == "santiago"

