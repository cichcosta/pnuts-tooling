        x_mc_update_extension_fn("n", "ddoltx", formatNumber(wddol.zk, "N00000000000000"), "wvicmsufdest", formatNumber(wvICMSUFDest, "N0.00"))

        wTotvICMSUFDest += round(wvICMSUFDest, 2)
        wTotvICMSUFRemet += round(wvICMSUFRemet, 2)

      }            //E1 
    }
  }


  // >>>>>>>>>>>>>>>> REFORMA TRIBUTARIA - INICIO >>>>>>>>>>>>>>>>>>>>>>>
  //REFORMA TRIBUTARIA
  wicst = ""
  wiclasstrib = ""
