wtoticmsdeson = 0
wicmsdeson = 0

wsel = "Select sum(a.mvalor) as mvalor, sum(a.mvalim) as mvalim "
wsel += "  From ddolt0 a, bpsrt0 b  "
wsel += " Where a.iorg    = '" + wrow.iorg.trim() + "' "
wsel += "   and a.idoct   = '" + wrow.idoct.trim() + "' "
wsel += "   and a.idoc    = '" + wrow.idoc.trim() + "' "
wsel += "   and a.ientt   = '" + wrow.ientt.trim() + "' "
wsel += "   and a.ient    = '" + wrow.ient.trim() + "' "
wsel += "   and b.ipst    = 'SRV' "
wsel += "   and a.iorg    = b.iorg "
wsel += "   and a.ipsr    = b.ipsr "
