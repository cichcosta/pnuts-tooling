append("AliquotaServico=0") //append("AliquotaServico=" + formatNumber(wAliquota * 100, "N0.00"))
append("AliquotaISS=0")     //append("AliquotaISS=" + formatNumber(wAliquota * 100, "N0.00"))
append("DiscriminacaoServico=" + wDiscriminacao)
