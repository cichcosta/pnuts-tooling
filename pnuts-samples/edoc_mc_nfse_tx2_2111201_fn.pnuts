// função que monta o conteudo do arquivo tx2
function append(str) {
  wbody.append(str + "\r\n")
}

// faz uma consulta na ddol e retorna o vetor
function getServicos(iorg, ientt, ient, idoct, idoc) {
  wsel = "select  * "
  wsel += "  from ddolt0 "
  wsel += " where iorg = '" + iorg + "' "
  wsel += "   and ientt = '" + ientt + "' "
  wsel += "   and ient = '" + ient + "' "
  wsel += "   and idoct = '" + idoct + "' "
  wsel += "   and idoc = '" + idoc + "' "
  return getRows("DDOL", wsel)
}

// percorre as linhas dos documento acumulado o total do servico 
// na variavel wtotal, retornando a mesma
function getTotalServicos(iorg, ientt, ient, idoct, idoc) {
  wtotal = 0.00
  vddol = getServicos(iorg, ientt, ient, idoct, idoc)
  foreach wddol(vddol.elements()){
    wtotal += wddol.mvalor
  }
  return wtotal
}

