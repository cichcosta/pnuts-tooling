  wlinha += "<COFINS>"

  if (wrow.cit.trim() != "3949") {
    if (inList(wrow.cit.trim(), ["3101", "3102"])) {

      wsel = "Select a.iixp, a.mvalor "
      wsel += "  From ddolt0 a "
      wsel += " Where a.iorg  = '" + wrow.iorg.trim() + "' "
      wsel += "   and a.idoct = '" + wrow.idoct.trim() + "' "
      wsel += "   and a.idoc  = '" + wrow.idoc.trim() + "' "
      wsel += "   and a.ientt = '" + wrow.ientt.trim() + "' "
      wsel += "   and a.ient  = '" + wrow.ient.trim() + "' "
      wsel += "   and a.ipsr  = '" + wddol.ipsr.trim() + "' "
      wsel += "   and a.idol  = '" + wddol.idol.trim() + "' "
      wsel += "   and (a.irct1 = 'CF' or a.ndoc = 'COFINS') "
      wddol2 = getRow("DDOL", wsel)

      wlinha += "<COFINSAliq>"
      wlinha += "<CST>01</CST>"


      if (wddol2.iixp.trim() != "" && wddol2.iixp.trim() != null && wddol2.iixp.trim() != "0.000") {
        wlinha += "<vBC>" + formatNumber((wddol2.mvalor / (toNumber(wddol2.iixp.trim()) / 100)), "N0.00") + "</vBC>"
      } else {
        wlinha += "<vBC>" + formatNumber(0, "N0.00") + "</vBC>"
      }

      wlinha += "<pCOFINS>" + formatNumber(toNumber(wddol2.iixp.trim()), "N0.00") + "</pCOFINS>"
      wlinha += "<vCOFINS>" + formatNumber(wddol2.mvalor, "N0.00") + "</vCOFINS>"
      wlinha += "</COFINSAliq>"
      wtotcofins += wddol2.mvalor
    } else if ((wddol.cfpsr2.trim() != "I") && (wtclass != "")) {
      if (wUF_E12.trim() == "AM") {
        wvalcof = getSQLNumber("Select a.qqcoef2 from bctxt0 a with(nolock) where a.ictx = 'BCTX*NFE' and a.ivalk = 'COF'")
      } else {
        wvalcof = getSQLNumber("Select a.qqcoef1 from bctxt0 a with(nolock) where a.ictx = 'BCTX*NFE' and a.ivalk = 'COF'")
      }
      /**
      * NPP 00.1701
      * Cálculo da base de cálculo do cofins
      */
      //NPP.000012 - RETIRADA DO ICMS DA BASE DO PIS E COFINS - SAÍDAS
      if (inList(wrow.cit.trim(), ["6202", "5202", "6201", "5201"])) {
        wbccofins = ((wddol.mvalor - wddol.mvalim) - wddol.mvalim2) + wlfretendc
        wvcofins = round(((((wddol.mvalor - wddol.mvalim) - wddol.mvalim2) * wvalcof) / 100), 2)
      } else {
        wbccofins = (wddol.mvalor - wddol.mvalim - wddol.mvalim2) + wlfretendc //Incluido o IPI para reduzir na base de calculo - Anderson Lopes e Bruna - 13/02/2025 - GLPI 552166
        wvcofins = round((((wddol.mvalor - wddol.mvalim - wddol.mvalim2) * wvalcof) / 100), 2) //Incluido o IPI para reduzir na base de calculo - Anderson Lopes e Bruna - 13/02/2025 - GLPI 552166
      }

      wlinha += "<COFINSAliq>"
      wlinha += "<CST>01</CST>"






      wlinha += "<vBC>" + formatNumber(wbccofins, "N0.00") + "</vBC>"
      wlinha += "<pCOFINS>" + formatNumber(wvalcof, "N0.00") + "</pCOFINS>"


      wlinha += "<vCOFINS>" + formatNumber(wvcofins, "N0.00") + "</vCOFINS>"

      wlinha += "</COFINSAliq>"

      wtotcofins += wvcofins


    } else if (wddol.cfpsr2.trim() == "I") {
      wlinha += "<COFINSNT>"
      wlinha += "<CST>06</CST>"
      wlinha += "</COFINSNT>"

      //202607 - NPP.002862 - REGRAS DE IMPOSTOS PARA VENDAS PARA SUFRAMA - NOTA FISCAL
    } else if (wmsufra > 0 && wisencaosuframa.isentopiscf.trim() == "SIM") {
      wlinha += "<COFINSNT>"
      wlinha += "<CST>07</CST>"
      wlinha += "</COFINSNT>"
    } else {
      wlinha += "<COFINSNT>"
      wlinha += "<CST>08</CST>"
      wlinha += "</COFINSNT>"
    }
  } else {
    wlinha += "<COFINSNT>"
    wlinha += "<CST>08</CST>"
    wlinha += "</COFINSNT>"
  }
  wlinha += "</COFINS>"

  //Verifica se documento existe na tabela dlpc
  wsel = " SELECT COUNT(zk)"
  wsel += "   FROM dlpct0 with (nolock)"
  wsel += "  WHERE zkddoc = " + wrow.zk
  wcountzk = getSQLNumber(wsel)

  if (wcountzk == 0) {
    //Gravação online do pis cofins notas de saida
    if (wuser != "scavalca") {
      bi_mc_pis_cof_nnf_sai_on_fn(wrow)
    }
  }

  //Guarda ano atual
  wdataref = wdate.substring(0, 4)

  // aqui tem que verificar se o cliente Ã© consumidor final e se ele Ã© de outro estado

  if (!inList(wrow.cit.trim(), ["5933", "6933"])) {

    if (wInterNaoContribuinte || (windFinal == "1" && widDest == "2" && windIEDest_E16a == "9")) {

      wpICMSInter = 12.00
      wuforigem = ["SP", "RJ", "MG", "PR", "RS", "SC"]
      wufdestino = ["AM", "RR", "AP", "PA", "TO", "RO", "AC", "MA", "PI", "CE", "RN", "PE", "PB", "SE", "AL", "BA", "MT", "MS", "GO", "ES"]

      println("Imposto ICMS Inter > > " + wpICMSInter); flush()

      if (inList(wbent.testado.trim(), wuforigem) && inList(wbent2.testado.trim(), wufdestino)) {
        println("Imposto ICMS Inter > > " + wpICMSInter); flush()
        wpICMSInter = 7.00
      }

      if (wddol.cfpsr.trim().substring(0, 1) == "2") {
        println("Imposto ICMS Inter > > " + wpICMSInter); flush()
