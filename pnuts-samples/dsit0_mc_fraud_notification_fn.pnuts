// recupera pedidos para envio das notificações
wqry.append(WN + " SELECT ");
wqry.append(WN + "     fila.notification_queue_id, ");
wqry.append(WN + "     fila.endpoint, ");
wqry.append(WN + "     mdi.salesPlatformCode, ");
wqry.append(WN + "     mdi.orderCode, ");
wqry.append(WN + "     mdi.orderCodePrincipal, ");
wqry.append(WN + "     mdi.totalValue, ");
wqry.append(WN + "     fila.created_at ");
wqry.append(WN + " FROM vw_notification_queue_pending AS fila ");
wqry.append(WN + " INNER JOIN tb_order AS mdi WITH (NOLOCK) ");
wqry.append(WN + "     ON fila.source_entity_id = mdi.orderCodePrincipal ");
wqry.append(WN + " WHERE ");
wqry.append(WN + "     fila.channel_name = 'FRAUD_ANALYSIS' ");
wqry.append(WN + "     AND fila.channel_type = 'TEAMS' ");
wqry.append(WN + " UNION ALL ");
wqry.append(WN + " SELECT ");
wqry.append(WN + "     fila.notification_queue_id, ");
wqry.append(WN + "     fila.endpoint, ");
wqry.append(WN + "     'B2C' AS salesPlatformCode, ");
wqry.append(WN + "     mweb.idoc AS orderCode, ");
wqry.append(WN + "     mweb.idoc AS orderCodePrincipal, ");
wqry.append(WN + "     mweb.mvalor AS totalValue, ");
wqry.append(WN + "     fila.created_at ");
wqry.append(WN + " FROM vw_notification_queue_pending AS fila ");
wqry.append(WN + " INNER JOIN dsitt0 AS mweb WITH (NOLOCK) ");
wqry.append(WN + "     ON fila.source_entity_id = mweb.idoc ");
wqry.append(WN + " WHERE ");
wqry.append(WN + "     fila.channel_name = 'FRAUD_ANALYSIS' ");
wqry.append(WN + "     AND fila.channel_type = 'TEAMS' ");
wqry.append(WN + "     AND NOT EXISTS ( ");
wqry.append(WN + "         SELECT 1 ");
wqry.append(WN + "         FROM tb_order AS mdi ");
wqry.append(WN + "         WHERE fila.source_entity_id = mdi.orderCodePrincipal ");
wqry.append(WN + "     ) ");
wqry.append(WN + " ORDER BY fila.notification_queue_id; ");
println("ORDERS: " + wqry.toString());
vorders = getRows("DDOC", wqry.toString());

wqry.delete(0, wqry.length());

foreach worder(vorders.elements()) {

  // envia notificação via Microsoft teams
  wheader = HashMap();
  wheader.put("Content-Type", "application/json");

  wbody = get_body_json_card(worder.salesplatformcode, worder.ordercode, worder.ordercodeprincipal, worder.created_at);

  wurl = worder.endpoint;
  wtimeout = 3000;

  wresponse = x_mc_request_api_v2_fn("POST", wurl, wheader, wbody, "UTF-8", wtimeout);
  println("RES: " + wresponse); flush();

  // Marcar notificação como processada.
  wnotification_queue_id = worder.notification_queue_id;
  wstatus = "Sent";
  werror_message = "";
  wshould_retry = 0;

  executeProcedure("pr_update_notification_status", [wnotification_queue_id, wstatus, werror_message, wshould_retry]);
}

println(">>>>>>>>>> FUNÇÃO: DSIT0_MC_FRAUD_NOTIFICATION_FN - FINAL"); flush();
