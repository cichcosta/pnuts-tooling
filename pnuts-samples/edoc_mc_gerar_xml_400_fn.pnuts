        wsel += " Where a.iorg    = '" + wrow.iorg.trim() + "' "
        wsel += "   and a.idoct   = '" + wrow.idoct.trim() + "' "
        wsel += "   and a.idoc    = '" + wrow.idoc.trim() + "' "
        wsel += "   and a.ientt   = '" + wrow.ientt.trim() + "' "
        wsel += "   and a.ient    = '" + wrow.ient.trim() + "' "
        wdocnvd = getRow("DDOC", wsel)

        if (wdocnvd.wdcode != 100) {

          //Busca NNF da venda original        
          wsel = "Select a.iorg, a.idoct2,a.idoc2 "
          wsel += "  From ddoct0 a "
          wsel += " Where a.iorg    = '" + wdocnvd.iorg.trim() + "' "
          wsel += "   and a.idoct   = '" + wdocnvd.idoct2.trim() + "' "
          wsel += "   and a.idoc    = '" + wdocnvd.idoc2.trim() + "' "
          wnnfnvd = getRow("DDOC", wsel)

          if (wnnfnvd.wdcode != 100) {

            //Pega data da nota de venda           
            wsel = "Select a.ddoces "
            wsel += "  From ddoct0 a "
            wsel += " Where a.iorg    = '" + wnnfnvd.iorg.trim() + "' "
            wsel += "   and a.idoct   = '" + wnnfnvd.idoct2.trim() + "' "
            wsel += "   and a.idoc    = '" + wnnfnvd.idoc2.trim() + "' "
            wnnfven = getRow("DDOC", wsel)

            wdataref = wnnfven.ddoces.substring(0, 4)
          }
        }
      }


      // define o percentual provisÃ³rio de partilhado ICMS Interestadual
      wpICMSInterPart = 100.00

      switch (wdataref) {
        case "2017": wpICMSInterPart = 60.00; break;
        case "2018": wpICMSInterPart = 80.00; break;
        case "2019": wpICMSInterPart = 100.00; break;
      }


      //wvBCUFDest = 0.00 // <---------------------- valor da base de calculo ICMS (vBC) do item
      wpFCPUFDest = 0.00
      //wpICMSUFDest = 0.00 // <----------------------- aliquota icms (pICMS) do item
      wvFCPUFDest = 0.00

      //wvaldifaliq = toNumber(wpICMSUFDest) - wpICMSInter

      // Consulta ICMS UF Destino
      // Valor destido
      wsel = " select qqcoef1 from bctxt0"
      wsel += " where ictx = 'BCTX*AUDI*UF'"
      wsel += " and '" + wrow.ddoces.trim() + "' between dini and dfim"
      wsel += " and   ivalk = '" + wbent2.testado.trim() + "'"
      wdifalUf = getSQLNumber(wsel)

      wvaldifaliq = wdifalUf - toNumber(wpICMSUFDest)

      if (wvaldifaliq < 0) wvaldifaliq = wvaldifaliq * -1

      if (wuser == "scavalca") { showMessage("Base " + wvBCUFDest + " * " + wvaldifaliq + "/100 " + "percentual partilha  " + wpICMSInterPart) }

      println(">>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>> - wvBCUFDest: " + wvBCUFDest + " wvaldifaliq: " + wvaldifaliq + " wpICMSInterPart: " + wpICMSInterPart + " wpICMSUFDest: " + wpICMSUFDest + " wpICMSInter: " + wpICMSInter); flush();
      wvICMSUFDest = (toNumber(wvBCUFDest) * ((wvaldifaliq) / 100)) * (wpICMSInterPart / 100)// Valor do ICMS Interestadual para a UF dedestino

      wvICMSUFRemet = (toNumber(wvBCUFDest) * ((wvaldifaliq) / 100)) * ((100.00 - wpICMSInterPart) / 100) // Valor do ICMS Interestadual para aUF do remetente
      wvICMSUFDest = round(wvICMSUFDest, 2)

      println(">>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>> -  wvICMSUFDest: " + wvICMSUFDest); flush();

      wvICMSUFRemet = round(wvICMSUFRemet, 2)

      //Zerar DIFAL para o estados do MA e PI - Chamado 2999215
      if (inList(wrow.cit, ["6102", "6108"]) && inList(wbent2.testado.trim(), ["MA", "PI"])) {

        // Para atender o novo CNPJ Alfanumerico, trocamos a regex antiga "[^0-9]" pela nova "[^A-Z0-9]".
        wtidfiscbt2 = wbent2.tidfisc.replaceAll("[^A-Z0-9]", "").trim()
        wtidfisc2bt2 = wbent2.tidfisc2.trim().toUpperCase()

        if (wtidfiscbt2.length() == 11 || (wtidfiscbt2.length() == 14 && wtidfisc2bt2 == "ISENTO")) {

          if (wddol.cfpsr == "020") {

            //wvICMSUFDest = 0.00

          }
        }
      }


