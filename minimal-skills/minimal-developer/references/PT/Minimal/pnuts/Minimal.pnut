//



function getMoeda1() {
   wmoeda = MLogin::getDBProperty("MINMOEDA1")
   if (wmoeda == null) return "PTE"
   return wmoeda
}
function getMoeda2() {
   wmoeda = MLogin::getDBProperty("MINMOEDA2")
   if (wmoeda == null) return "EUR"
   return wmoeda
}


function getCambio(wmcm) {
   return getCambio(wmcm, getMoeda1())
}
function getCambio(wmcm, wcmc) {
   return getCambio(wmcm, wcmc, today())
}
function getCambio(wmcm, wcmc, wdata) {
   return getCambio(wmcm, wcmc, wdata, "*")
}
function getCambio(wmcm, wcmc, wdata, wccm) {
   wdcam = getCambioRecord(wmcm, wcmc, wdata, wccm)
   return wdcam.qcamb
}
function getCambioRecord(wmcm) {
   return getCambioRecord(wmcm, getMoeda1())
}
function getCambioRecord(wmcm, wvcm) {
   return getCambioRecord(wmcm, wvcm, today())
}
function getCambioRecord(wmcm, wvcm, wdata) {
   return getCambioRecord(wmcm, wvcm, wdata, "*")
}
function getCambioRecord(wmcm, wcmc, wdata, wccm) {
   wcsel  = "select * from dcamt0"
   wcsel += " where mcm = '" + wmcm + "' and cmc = '" + wcmc + "' and ccm = '" + wccm + "'"
   wcsel +=   " and dini <= '" + wdata + "' and dfim >= '" + wdata + "'"
   wdcam = getRow("DCAM", wcsel)
   if (wdcam.wdcode != SQL_OK) {
      throwError("MIN-DCAM01E", [wmcm, wcmc, wccm, wdata])
   }
   return wdcam
}

function converterMoeda(wvalor) {
   return converterMoeda(wvalor, getMoeda1())
}
function converterMoeda(wvalor, wmcm) {
   return converterMoeda(wvalor, wmcm, 0, getMoeda1())
}
function converterMoeda(wvalor, wmcm, wqcamb, wcmc) {
   return converterMoeda(wvalor, wmcm, wqcamb, wcmc, today())
}
function converterMoeda(wvalor, wmcm, wqcamb, wcmc, wdata) {
   return converterMoeda(wvalor, wmcm, wqcamb, wcmc, wdata, "*")
}
function converterMoeda(wvalor, wmcm, wqcamb, wcmc, wdata, wccm) {
   vcm = getMoeda1()
   ycm = getMoeda2()
   if (wmcm == null || wmcm.trim() == "") wmcm = getMoeda1()
   if (wcmc == null || wcmc.trim() == "") wcmc = getMoeda1()
   if (wccm == null || wccm.trim() == "") wccm = "*"
   if (wdata == null || wdata.trim() == "") wdata = today()
   if (wqcamb == 0) wqcamb = getCambio(wmcm, wcmc, wdata, wccm)

   if (wvalor == 0) {
      return [0, vcm, 0, ycm, wqcamb, wcmc]
   }
   vvalor = getValorMoeda1(wvalor, wmcm, wqcamb, wcmc, wdata, wccm)
   yvalor = getValorMoeda2(wvalor, wmcm, wqcamb, wcmc, wdata, wccm)
   return [vvalor, vcm, yvalor, ycm, wqcamb, wcmc]
}

function getValorMoeda1(wvalor, wmcm, wqcamb, wcmc) {
   return getValorMoeda1(wvalor, wmcm, wqcamb, wcmc, today())
}
function getValorMoeda1(wvalor, wmcm, wqcamb, wcmc, wdata) {
   return getValorMoeda1(wvalor, wmcm, wqcamb, wcmc, wdata, "*")
}
function getValorMoeda1(wvalor, wmcm, wqcamb, wcmc, wdata, wccm) {
   return getValorMoedaReferencia("v", wvalor, wmcm, wqcamb, wcmc, wdata, wccm)
}

function getValorMoeda2(wvalor, wmcm, wqcamb, wcmc) {
   return getValorMoeda2(wvalor, wmcm, wqcamb, wcmc, today())
}
function getValorMoeda2(wvalor, wmcm, wqcamb, wcmc, wdata) {
