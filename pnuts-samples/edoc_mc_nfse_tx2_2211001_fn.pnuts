  wsel += " from bctxt0 with(nolock) "
  wsel += " where ictx = 'TABELA*SIAFI' "
  wsel += " and xord = '" + wbentt.testado.trim() + "' "
  wsel += " and nctx = '" + wbentt.tmunicip.trim() + "' "
