      //Documento: NNF; wrow.idoct.trim().
      //UFs Destinos: RN ou PA; wbent2.testado.trim().
      //CFOP: 6107/6108 ou 6117; wrow.cit.trim().
      //Transação: 6102 ou 6117; wrow.ctcf.trim().
      //windIEDest_E16a == "9"; Isento IE.
      wsel = " SELECT a.ivalk ";
      wsel += " FROM bctxt0 a ";
      wsel += " WHERE a.ictx = 'BCTX*UF*OPEINT*MSG' ";
      wsel += "	  and a.xord = '" + wrow.idoct.trim() + "' ";
      wsel += "	  and a.ivalk = '" + wbent2.testado.trim() + "' ";
      //wsel += "	  and a.ttext like %'"+wrow.cit.trim()+"'% ";
      wsel += "   and ';' + a.ttext + ';' Like '%;" + wrow.cit.trim() + ";%' "
      //wsel += "	  and a.ttext2 = '"+wrow.ctcf.trim()+"' ";
      wsel += "	  and a.cst = 'E0' ";
      wufopint = getRow("BENT", wsel);
      println("BCTX*UF*OPEINT*NC:>" + wsel); flush();
      if ((wufopint.wdcode != 100) && (windIEDest_E16a == "9") || wbent2.cnatt.trim() == "PR") {
        /*
            wlinha += "<ICMSUFDest>"
            wlinha += "<vBCUFDest>" + formatNumber(0, "N0.00") + "</vBCUFDest>"
            wlinha += "<pFCPUFDest>" + formatNumber(0, "N0.00") + "</pFCPUFDest>"
            //wlinha += "<pICMSUFDest>" + formatNumber(wpICMSUFDest, "N0.00") + "</pICMSUFDest>"
            wlinha += "<pICMSUFDest>" + formatNumber(0, "N0.00") + "</pICMSUFDest>"
            wlinha += "<pICMSInter>" + formatNumber(0, "N0.00") + "</pICMSInter>"
            wlinha += "<pICMSInterPart>" + formatNumber(0, "N0.00") + "</pICMSInterPart>"
            wlinha += "<vFCPUFDest>" + formatNumber(0, "N0.00") + "</vFCPUFDest>"
            wlinha += "<vICMSUFDest>" + formatNumber(0, "N0.00") + "</vICMSUFDest>"
            wlinha += "<vICMSUFRemet>" + formatNumber(0, "N0.00") + "</vICMSUFRemet>"
            wlinha += "</ICMSUFDest>"
            
            wTotvFCPUFDest += 0;
            
            wTotvICMSUFDest += 0;
            wTotvICMSUFRemet += 0;
        */
      } else {

        wlinha += "<ICMSUFDest>"
        wlinha += "<vBCUFDest>" + formatNumber(wvBCUFDest, "N0.00") + "</vBCUFDest>"
        wlinha += "<pFCPUFDest>" + formatNumber(wpFCPUFDest, "N0.00") + "</pFCPUFDest>"
        //wlinha += "<pICMSUFDest>" + formatNumber(wpICMSUFDest, "N0.00") + "</pICMSUFDest>"
        wlinha += "<pICMSUFDest>" + formatNumber(wdifalUf, "N0.00") + "</pICMSUFDest>"
        wlinha += "<pICMSInter>" + formatNumber(wpICMSInter, "N0.00") + "</pICMSInter>"
        wlinha += "<pICMSInterPart>" + formatNumber(wpICMSInterPart, "N0.00") + "</pICMSInterPart>"
        wlinha += "<vFCPUFDest>" + formatNumber(wvFCPUFDest, "N0.00") + "</vFCPUFDest>"
        wlinha += "<vICMSUFDest>" + formatNumber(wvICMSUFDest, "N0.00") + "</vICMSUFDest>"
        wlinha += "<vICMSUFRemet>" + formatNumber(wvICMSUFRemet, "N0.00") + "</vICMSUFRemet>"
        wlinha += "</ICMSUFDest>"

        wTotvFCPUFDest += round(wvFCPUFDest, 2)

        //NPP.002582 - DIFAL NO SPED E VISUALIZAÇÃO DO VALOR
