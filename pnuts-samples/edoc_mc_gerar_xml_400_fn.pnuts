        wtotpis += round(((round(wddol.mvalor - wddol.mvalim - wddol.mvalim2, 2) * wvalpis) / 100), 2) //Incluido o IPI para reduzir na base de calculo - Anderson Lopes e Bruna - 13/02/2025 - GLPI 552166

