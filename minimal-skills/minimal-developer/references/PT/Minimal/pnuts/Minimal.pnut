function getNctx(wictx, wivalk) {
   if (wivalk.trim() == "") {return ""}
   wcsel = "select nvl(max(nctx),'?') as nctx from bctxt0 where ictx = '" + wictx + "' and ivalk = '" + wivalk + "'"
   getSQLValue(wcsel)
}

function getNctx(wictx, wivalk, wdata) {
   if (wivalk.trim() == "") {return ""}
   wcsel = "select nvl(max(nctx),'?') as nctx from bctxt0 where ictx = '" + wictx + "' and ivalk = '" + wivalk + "' and '" + wdata + "-01' between dini and dfim "
   getSQLValue(wcsel)
}

function getTparms(wictx, wivalk) {
   if (wivalk.trim() == "") {return ""}
   wcsel = "select nvl(max(tparms),'?') as tparms from bctxt0 where ictx = '" + wictx + "' and ivalk = '" + wivalk + "'"
   getSQLValue(wcsel)
}
function getBctx(wictx, wivalk) {
   wcsel = "select * from bctxt0 where ictx = '" + wictx + "' and ivalk = '" + wivalk + "'"
   wrow = getRow("BCTX", wcsel)
   if (wrow.wdcode != SQL_OK) {
      wrow = getMRow("BCTX")
      wrow.getRecord().put("wdcode", Integer(SQL_NOTFOUND).toString())
      wrow.getMTable().setType("wdcode", MRow::NUMTYPE)
   }
   return wrow
}




//


// Funções várias

// Validação de mandatórios [um e só um preenchido]
function validateOne(wform, warray) {
   wfound = null
   foreach f (warray) {
      wempty = false
      val = wform.get(f)
      if (val instanceof Number) {
         if (val == 0) wempty = true
      } else {
         if (val.trim() == "") wempty = true
      }
      if (!wempty) {
         if (wfound != null) throwError("MIN-001011E", wform, f, [wfound])
         wfound = f
      }
   }
   if (wfound == null) {
      throwError("MIN-001010E", wform, warray[0])
   }
}

// Validação de mandatórios [pelo menos 1 preenchido]
function validateAny(wform, warray) {
   foreach f (warray) {
      val = wform.get(f)
      if (val instanceof Number) {
         if (val != 0) return
      } else {
         if (val.trim() != "") return
      }
   }
   throwError("MIN-001010E", wform, warray[0])
}

// Validação de mandatórios [ou nenhum ou todos]
function validate(wform, warray) {
   validateAll(wform, warray)
}

function validateAll(wform, warray) {
   wfound = false
   wfirst_field = true
   foreach f (warray) {
      wempty = false
      val = wform.get(f)
      if (val instanceof Number) {
         if (val == 0) wempty = true
      } else {
         if (val.trim() == "") wempty = true
      }
      if (wfound) {
         if (wempty) {
            throwError("MIN-001010E", wform, f)
         }
      } else if (!wempty) {
         if (! wfirst_field) {
            throwError("MIN-001010E", wform, warray[0])
         }
         wfound = true
      }
      wfirst_field = false
   }
}

// Validação que estão todos vazios
function validateEmpty(wform, warray) {
   wempty = true
   foreach f (warray) {
      val = wform.get(f)
      if (val instanceof Number) {
         if (val != 0) wempty = false
      } else {
         if (val.trim() != "") wempty = false
      }
      if (!wempty) throwError("MIN-001012E", wform, f)
   }
}

// Testa se um valor existe num array ou vector
function inArray(wvalue, warray)
{
   if (warray instanceof java.util.Vector) {
      foreach v (warray.elements()) if (wvalue.equals(v)) return true
   } else if (warray) {
      foreach v (warray) if (wvalue.equals(v)) return true
   }
   false
}

// devolve true se um elemento está num array
function inList(wstr, wlist)
{
   //if (wlist instanceof java.util.Vector || wlist instanceof java.util.Hashtable) {
   if (wlist instanceof Vector || wlist instanceof Hashtable) {
      wlist = wlist.elements()
   }
   foreach wval (wlist) {
      if (wstr.equals(wval)) {
         return true;
      }
   }
   return false;
}

