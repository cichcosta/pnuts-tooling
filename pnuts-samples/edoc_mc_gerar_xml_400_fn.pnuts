        if (wtagICMSDeson.trim() != "") {
          wlinha += "<CST>40</CST>"
        } else {
          wlinha += "<CST>10</CST>"
        }
        wlinha += "<modBC>3</modBC>"
        wlinha += "<vBC>" + formatNumber((wddol.mvalor - wddol.mvalim2), "N0.00") /*formatNumber((wddol.mvalor*wddol.qbfisc)+ wtotfrete,"N0.00")*/ + "</vBC>"
        wlinha += "<pICMS>" + formatNumber(wddol.pi, "N0.00") + "</pICMS>"
