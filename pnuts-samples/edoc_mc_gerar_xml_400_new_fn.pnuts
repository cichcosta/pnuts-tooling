    } else if ((wddol.cfpsrl.trim() == "060") && inList(wrow.idoct.trim(), ["NNF"]) && inList(wrow.iuorg.trim(), ["F08", "F10", "F22"]) && inList(wrow.cit.trim(), ["5102", "6102"])) {

