append("CpfCnpjPrestador=" + wCnpj)
append("InscricaoMunicipalPrestador=" + wInscricaoMunicipalPrestador)
append("OptanteSimplesNacional=2")
append("IncentivoFiscal=2")
append("RazaoSocialPrestador=TECNO INDUSTRIA E COMERCIO DE COMPUTADORES LTDA")
append("TipoRPS=1")
append("SerieRPS=3")
append("NumeroRPS=" + wnum)
append("DataEmissao=" + wdate + "T" + wtime)
append("SituacaoNota=1")
