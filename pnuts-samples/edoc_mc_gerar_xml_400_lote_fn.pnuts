//if ((inList(wrow.cit.trim().substring(0, 1), ["3", "7"])) || (wrow.iuorg.trim() == "F03") || (wrow.iuorg.trim() == "F07") || (wrow.iuorg.trim() == "F00") || (wrow.iuorg.trim() == "F09") || ((wrow.iuorg.trim() == "F08") || (wrow.iuorg.trim() == "F13") && wnodo != "610")) {

//if ((inList(wrow.cit.trim().substring(0,1),["3","7"])) inList(wrow.iuorg.trim() == "F03") || (wrow.iuorg.trim() == "F07")|| (wrow.iuorg.trim() == "F00") || (wrow.iuorg.trim() == "F09") || ((wrow.iuorg.trim() == "F08")|| (wrow.iuorg.trim() == "F13") && wnodo != "610"))

if ((inList(wrow.cit.trim().substring(0, 1), ["3", "7"])) || (!x_mc_get_access3_fn("DDOC0-0373", ""))) {

